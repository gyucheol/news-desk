+_ICON_CACHE = {}
+
+
+def _ifont(size, weight="ExtraBold"):
+    key = ("font", size, weight)
+    if key not in _ICON_CACHE:
+        _ICON_CACHE[key] = ImageFont.truetype(f"{ROOT}/fonts/Pretendard-{weight}.otf", size)
+    return _ICON_CACHE[key]
+
+
+def _outline(key, size, draw_fn, k):
+    """Cached outline mask (width k) of a filled shape drawn by draw_fn: shape minus its erosion."""
+    if key not in _ICON_CACHE:
+        m = Image.new("L", size, 0)
+        draw_fn(ImageDraw.Draw(m))
+        inner = m
+        for _ in range(k):
+            inner = inner.filter(ImageFilter.MinFilter(3))
+        _ICON_CACHE[key] = ImageChops.subtract(m, inner)
+    return _ICON_CACHE[key]
+
