[
 {
  "id": "L001",
  "text": "금요일 저녁 일곱 시 퇴근길에"
 },
 {
  "id": "L002",
  "text": "당신은 애인에게 카톡을 보냅니다."
 },
 {
  "id": "L003",
  "text": "오늘 퇴근하고 뭐할꺼야?"
 },
 {
  "id": "L004",
  "text": "이 메시지를 보낸 뒤"
 },
 {
  "id": "L005",
  "text": "돌아올 세 가지 반응을"
 },
 {
  "id": "L006",
  "text": "상상해 봅시다."
 },
 {
  "id": "L007",
  "text": "먼저 첫 번째"
 },
 {
  "id": "L008",
  "text": "당신이 카톡을 보낸 지"
 },
 {
  "id": "L009",
  "text": "오 분 만에"
 },
 {
  "id": "L010",
  "text": "상대방의 답장이 옵니다."
 },
 {
  "id": "L011",
  "text": "뭐 할껀 없어, 같이 저녁 먹을까?"
 },
 {
  "id": "L012",
  "text": "두 번째"
 },
 {
  "id": "L013",
  "text": "세 시간이 훌쩍 지나서야"
 },
 {
  "id": "L014",
  "text": "뒤늦게 답장이 도착합니다."
 },
 {
  "id": "L015",
  "text": "헉 미안해 회식 와서 연락을 이제 받네"
 },
 {
  "id": "L016",
  "text": "그리고 마지막 세 번째"
 },
 {
  "id": "L017",
  "text": "세 시간이 훌쩍 지났는데도"
 },
 {
  "id": "L018",
  "text": "메시지 옆의 노란 숫자 '일'이"
 },
 {
  "id": "L019",
  "text": "그대로 있습니다."
 },
 {
  "id": "L020",
  "text": "자 여러분은 어떤 상황에 가장 마음이 쓰이셨나요?"
 },
 {
  "id": "L021",
  "text": "아마 대부분"
 },
 {
  "id": "L022",
  "text": "세 번째였을 겁니다."
 },
 {
  "id": "L023",
  "text": "두 번째는"
 },
 {
  "id": "L024",
  "text": "늦게나마 답장을 받았지만"
 },
 {
  "id": "L025",
  "text": "세 번째는"
 },
 {
  "id": "L026",
  "text": "지금 이 순간에도"
 },
 {
  "id": "L027",
  "text": "기약 없이 연락을 기다리고 있으니까요."
 },
 {
  "id": "L028",
  "text": "문제는"
 },
 {
  "id": "L029",
  "text": "이 침묵이 길어질 때입니다."
 },
 {
  "id": "L030",
  "text": "처음 한두 시간은"
 },
 {
  "id": "L031",
  "text": "야근이 길어지나?"
 },
 {
  "id": "L032",
  "text": "배터리가 없나?"
 },
 {
  "id": "L033",
  "text": "하며 대수롭지 않게 넘깁니다."
 },
 {
  "id": "L034",
  "text": "하지만 세 시간 네 시간이 넘어가면"
 },
 {
  "id": "L035",
  "text": "슬슬 애가 타기 시작하죠."
 },
 {
  "id": "L036",
  "text": "오 분마다 습관처럼"
 },
 {
  "id": "L037",
  "text": "휴대폰 화면을 켜보며"
 },
 {
  "id": "L038",
  "text": "이제 퇴근해서 집 갔을 텐데"
 },
 {
  "id": "L039",
  "text": "뭐 하고 있지?"
 },
 {
  "id": "L040",
  "text": "요즘 나한테 마음이 식었나?"
 },
 {
  "id": "L041",
  "text": "하고 온갖 부정적인 상상을 펼칩니다."
 },
 {
  "id": "L042",
  "text": "그러다 문득"
 },
 {
  "id": "L043",
  "text": "카톡창만 붙잡고 있는 스스로가"
 },
 {
  "id": "L044",
  "text": "한심해져서"
 },
 {
  "id": "L045",
  "text": "고작 연락 몇 시간 안 된다고"
 },
 {
  "id": "L046",
  "text": "내가 너무 예민한가?"
 },
 {
  "id": "L047",
  "text": "내가 지금 집착하는 건가?"
 },
 {
  "id": "L048",
  "text": "하며 자신을 탓합니다."
 },
 {
  "id": "L049",
  "text": "하지만 이게 정말"
 },
 {
  "id": "L050",
  "text": "내 성격이 유독 예민하고 못나서일까요?"
 },
 {
  "id": "L051",
  "text": "심리학은 아니라고 대답합니다."
 },
 {
  "id": "L052",
  "text": "원래 인간의 뇌는"
 },
 {
  "id": "L053",
  "text": "'알 수 없는 상태'를"
 },
 {
  "id": "L054",
  "text": "우리가 생각하는 것보다"
 },
 {
  "id": "L055",
  "text": "훨씬 더 무겁고"
 },
 {
  "id": "L056",
  "text": "위협적으로 받아들이도록"
 },
 {
  "id": "L057",
  "text": "설계되어 있거든요."
 },
 {
  "id": "L058",
  "text": "오늘은 답장이 늦어질 때"
 },
 {
  "id": "L059",
  "text": "우리 마음이 왜 이토록 요동치는지"
 },
 {
  "id": "L060",
  "text": "과학적인 실험들을 통해 알아보고"
 },
 {
  "id": "L061",
  "text": "답장을 기다리는 시간을"
 },
 {
  "id": "L062",
  "text": "한결 가볍게 보낼 수 있는"
 },
 {
  "id": "L063",
  "text": "세 가지 현실적인 방법을"
 },
 {
  "id": "L064",
  "text": "알려드리겠습니다."
 },
 {
  "id": "L065",
  "text": "지우는 이 주째"
 },
 {
  "id": "L066",
  "text": "설레는 썸을 타고 있습니다."
 },
 {
  "id": "L067",
  "text": "오후 여섯 시 삼십 분"
 },
 {
  "id": "L068",
  "text": "퇴근길 지하철 안에서"
 },
 {
  "id": "L069",
  "text": "휴대폰을 꺼내"
 },
 {
  "id": "L070",
  "text": "상대방에게 카톡을 보냅니다."
 },
 {
  "id": "L071",
  "text": "오늘 하루 어땠어요?"
 },
 {
  "id": "L072",
  "text": "집에 도착해 저녁을 먹고"
 },
 {
  "id": "L073",
  "text": "일곱 시가 훌쩍 넘었는데도"
 },
 {
  "id": "L074",
  "text": "메시지 옆 숫자 일은 그대로입니다."
 },
 {
  "id": "L075",
  "text": "여덟 시가 되자"
 },
 {
  "id": "L076",
  "text": "지우는 괜히 카톡창을 열어"
 },
 {
  "id": "L077",
  "text": "이미 수십 번은 본"
 },
 {
  "id": "L078",
  "text": "상대방의 프로필 사진을"
 },
 {
  "id": "L079",
  "text": "다시 눌러 확대해 봅니다."
 },
 {
  "id": "L080",
  "text": "그렇게 아홉 시가 되고"
 },
 {
  "id": "L081",
  "text": "결국 참지 못한 채"
 },
 {
  "id": "L082",
  "text": "메시지 하나를 더 보냅니다."
 },
 {
  "id": "L083",
  "text": "바쁘세요??"
 },
 {
  "id": "L084",
  "text": "전송 버튼을 누르자마자"
 },
 {
  "id": "L085",
  "text": "후회가 밀려옵니다."
 },
 {
  "id": "L086",
  "text": "내가 연락을 너무 재촉하는 것처럼"
 },
 {
  "id": "L087",
  "text": "보이면 어떡하지..."
 },
 {
  "id": "L088",
  "text": "아홉 시 반이 되자"
 },
 {
  "id": "L089",
  "text": "침대에 누워"
 },
 {
  "id": "L090",
  "text": "지난 이 주 동안 나눈 대화를"
 },
 {
  "id": "L091",
  "text": "맨 위부터 다시 내려 읽습니다."
 },
 {
  "id": "L092",
  "text": "어제 내가 한 그 농담이"
 },
 {
  "id": "L093",
  "text": "좀 별로였나?"
 },
 {
  "id": "L094",
  "text": "아마 많은 분들이"
 },
 {
  "id": "L095",
  "text": "지우와 비슷한 밤을"
 },
 {
  "id": "L096",
  "text": "보내본 적 있으실 겁니다."
 },
 {
  "id": "L097",
  "text": "도대체 왜"
 },
 {
  "id": "L098",
  "text": "작은 숫자 일 하나에"
 },
 {
  "id": "L099",
  "text": "우리의 평온했던 일상이"
 },
 {
  "id": "L100",
  "text": "이토록 쉽게 무너져 내리는 걸까요?"
 },
 {
  "id": "L101",
  "text": "그 이유를 찾기 위해"
 },
 {
  "id": "L102",
  "text": "영국 유니버시티 칼리지 런던의"
 },
 {
  "id": "L103",
  "text": "한 실험실로 가 보겠습니다."
 },
 {
  "id": "L104",
  "text": "지금 여러분은"
 },
 {
  "id": "L105",
  "text": "실험실 의자에 앉아 있습니다."
 },
 {
  "id": "L106",
  "text": "여러분의 왼쪽 손등에는"
 },
 {
  "id": "L107",
  "text": "차가운 전극이 붙어 있고"
 },
 {
  "id": "L108",
  "text": "이건 실험 전에"
 },
 {
  "id": "L109",
  "text": "미리 작동 테스트를 끝낸"
 },
 {
  "id": "L110",
  "text": "꽤나 따끔한 전기가 흐르는 장치죠."
 },
 {
  "id": "L111",
  "text": "눈앞의 큰 화면에"
 },
 {
  "id": "L112",
  "text": "바위 두 개가 나타나면"
 },
 {
  "id": "L113",
  "text": "여러분은 그중"
 },
 {
  "id": "L114",
  "text": "밑에 뱀이 없는 바위를 골라야 합니다."
 },
 {
  "id": "L115",
  "text": "만약 바위 밑에서 뱀이 나오면"
 },
 {
  "id": "L116",
  "text": "손등에 따끔한 전기가 흐릅니다."
 },
 {
  "id": "L117",
  "text": "이 과정을 무려"
 },
 {
  "id": "L118",
  "text": "삼백이십 번이나 반복하는 동안"
 },
 {
  "id": "L119",
  "text": "연구진은"
 },
 {
  "id": "L120",
  "text": "참가자들의 몸에서 일어나는"
 },
 {
  "id": "L121",
  "text": "미세한 변화를"
 },
 {
  "id": "L122",
  "text": "빠짐없이 기록했습니다."
 },
 {
  "id": "L123",
  "text": "긴장할 때 저절로 커지는"
 },
 {
  "id": "L124",
  "text": "동공의 크기"
 },
 {
  "id": "L125",
  "text": "손끝에 맺히는"
 },
 {
  "id": "L126",
  "text": "미세한 땀 반응"
 },
 {
  "id": "L127",
  "text": "그리고 참가자들이 스스로 매긴"
 },
 {
  "id": "L128",
  "text": "스트레스 점수를"
 },
 {
  "id": "L129",
  "text": "계속해서 측정한 거죠."
 },
 {
  "id": "L130",
  "text": "과연 참가자들은"
 },
 {
  "id": "L131",
  "text": "언제 가장 심하게 긴장했을까요?"
 },
 {
  "id": "L132",
  "text": "뱀이 나와서"
 },
 {
  "id": "L133",
  "text": "전기 충격을 받을 게"
 },
 {
  "id": "L134",
  "text": "백 퍼센트 확실할 때였을까요"
 },
 {
  "id": "L135",
  "text": "아니면 나올지 안 나올지"
 },
 {
  "id": "L136",
  "text": "반반이라고 느낄 때였을까요?"
 },
 {
  "id": "L137",
  "text": "놀랍게도 정답은"
 },
 {
  "id": "L138",
  "text": "반반이라고 느낄 때였습니다."
 },
 {
  "id": "L139",
  "text": "우리 몸의 긴장도는"
 },
 {
  "id": "L140",
  "text": "확률이 정확히 반반일 때"
 },
 {
  "id": "L141",
  "text": "가장 높게 치솟았고"
 },
 {
  "id": "L142",
  "text": "반대로 뱀이 나오는 게"
 },
 {
  "id": "L143",
  "text": "백 퍼센트 확실할 때는"
 },
 {
  "id": "L144",
  "text": "오히려 낮아졌습니다."
 },
 {
  "id": "L145",
  "text": "한마디로 우리의 뇌는"
 },
 {
  "id": "L146",
  "text": "확실한 고통보다"
 },
 {
  "id": "L147",
  "text": "아플지 안 아플지 모르는 상태를"
 },
 {
  "id": "L148",
  "text": "훨씬 더 끔찍한 공포로"
 },
 {
  "id": "L149",
  "text": "받아들인다는 뜻입니다."
 },
 {
  "id": "L150",
  "text": "심리학에서는 이처럼"
 },
 {
  "id": "L151",
  "text": "결과를 알 수 없어"
 },
 {
  "id": "L152",
  "text": "애가 타는 상태를"
 },
 {
  "id": "L153",
  "text": "'불확실성'이라고 부릅니다."
 },
 {
  "id": "L154",
  "text": "비록 카톡을 주고받는 실험은 아니었지만"
 },
 {
  "id": "L155",
  "text": "지우가 숫자 '일'만 바라보며"
 },
 {
  "id": "L156",
  "text": "흘려보낸 시간은"
 },
 {
  "id": "L157",
  "text": "이 실험 속 바위와"
 },
 {
  "id": "L158",
  "text": "놀랍도록 닮아 있습니다."
 },
 {
  "id": "L159",
  "text": "상대가 그저"
 },
 {
  "id": "L160",
  "text": "바빠서 못 보는 걸 수도 있고"
 },
 {
  "id": "L161",
  "text": "나에 대한 마음이"
 },
 {
  "id": "L162",
  "text": "식어버린 걸 수도 있는"
 },
 {
  "id": "L163",
  "text": "반반의 상태."
 },
 {
  "id": "L164",
  "text": "답장을 기다리는 우리는"
 },
 {
  "id": "L165",
  "text": "밑에 뱀이 있을지 없을지 모르는 바위를"
 },
 {
  "id": "L166",
  "text": "몇 시간 내내"
 },
 {
  "id": "L167",
  "text": "홀로 들여다보고 있는 셈입니다."
 },
 {
  "id": "L168",
  "text": "게다가 이렇게"
 },
 {
  "id": "L169",
  "text": "알 수 없는 침묵이 길어지면"
 },
 {
  "id": "L170",
  "text": "우리의 뇌는"
 },
 {
  "id": "L171",
  "text": "아주 고약한 방식으로"
 },
 {
  "id": "L172",
  "text": "그 빈칸을 채우기 시작합니다."
 },
 {
  "id": "L173",
  "text": "이천사 년"
 },
 {
  "id": "L174",
  "text": "호주 매쿼리 대학교에서 진행한"
 },
 {
  "id": "L175",
  "text": "흥미로운 실험이 하나 있습니다."
 },
 {
  "id": "L176",
  "text": "실험에 참가한 학생은"
 },
 {
  "id": "L177",
  "text": "처음 보는 두 사람과"
 },
 {
  "id": "L178",
  "text": "당시 유행하던 '노키아 삼삼일공' 휴대폰으로"
 },
 {
  "id": "L179",
  "text": "문자 대화를 나눕니다."
 },
 {
  "id": "L180",
  "text": "처음에는"
 },
 {
  "id": "L181",
  "text": "운동은 얼마나 자주 해요?"
 },
 {
  "id": "L182",
  "text": "같은 가벼운 질문이 몇 번 오가더니"
 },
 {
  "id": "L183",
  "text": "곧 편하게 이야기를 나누는"
 },
 {
  "id": "L184",
  "text": "자유 대화가 시작됩니다."
 },
 {
  "id": "L185",
  "text": "그런데 어떤 학생들에게는"
 },
 {
  "id": "L186",
  "text": "바로 그 순간부터"
 },
 {
  "id": "L187",
  "text": "기묘한 침묵이 찾아옵니다."
 },
 {
  "id": "L188",
  "text": "장장 팔 분 동안"
 },
 {
  "id": "L189",
  "text": "두 사람 중 누구에게서도"
 },
 {
  "id": "L190",
  "text": "연락이 오지 않은 건데요."
 },
 {
  "id": "L191",
  "text": "사실 대화 상대였던 두 사람은"
 },
 {
  "id": "L192",
  "text": "연구진과 미리 입을 맞춰 둔"
 },
 {
  "id": "L193",
  "text": "실험 도우미들이었습니다."
 },
 {
  "id": "L194",
  "text": "그 정적 같은 팔 분이 흐른 뒤"
 },
 {
  "id": "L195",
  "text": "답장을 받지 못한 학생들의 마음은"
 },
 {
  "id": "L196",
  "text": "어떻게 변했을까요?"
 },
 {
  "id": "L197",
  "text": "계속 대화를 이어 간 학생들에 비해"
 },
 {
  "id": "L198",
  "text": "무리에 받아들여졌다는"
 },
 {
  "id": "L199",
  "text": "'소속감' 점수가"
 },
 {
  "id": "L200",
  "text": "절반 이하로 뚝 떨어진 건 물론이고"
 },
 {
  "id": "L201",
  "text": "상황을 내 뜻대로 이끌 수 있다는"
 },
 {
  "id": "L202",
  "text": "'통제감'"
 },
 {
  "id": "L203",
  "text": "스스로를 가치 있게 여기는"
 },
 {
  "id": "L204",
  "text": "'자존감'까지"
 },
 {
  "id": "L205",
  "text": "모두 큰 폭으로 무너져 내렸습니다."
 },
 {
  "id": "L206",
  "text": "더 눈여겨볼 점은 그다음입니다."
 },
 {
  "id": "L207",
  "text": "실험이 끝난 뒤"
 },
 {
  "id": "L208",
  "text": "왜 답장이 안 왔을지"
 },
 {
  "id": "L209",
  "text": "이유를 적어 보라고 했더니"
 },
 {
  "id": "L210",
  "text": "'휴대폰 고장' 같은"
 },
 {
  "id": "L211",
  "text": "바깥의 문제를 의심하기보다"
 },
 {
  "id": "L212",
  "text": "내가 말을 재미없게 했나?"
 },
 {
  "id": "L213",
  "text": "하며 자기 자신을 탓한 학생이"
 },
 {
  "id": "L214",
  "text": "가장 많았습니다."
 },
 {
  "id": "L215",
  "text": "생판 처음 본 사람에게"
 },
 {
  "id": "L216",
  "text": "고작 팔 분 동안"
 },
 {
  "id": "L217",
  "text": "답장을 못 받았을 뿐인데도"
 },
 {
  "id": "L218",
  "text": "사람의 마음은"
 },
 {
  "id": "L219",
  "text": "이렇게나 쉽게 흔들리고"
 },
 {
  "id": "L220",
  "text": "작아졌습니다."
 },
 {
  "id": "L221",
  "text": "지우가 지난 대화창을"
 },
 {
  "id": "L222",
  "text": "다시 올려 보며"
 },
 {
  "id": "L223",
  "text": "'어제 내 농담이 별로였나?'"
 },
 {
  "id": "L224",
  "text": "하고 자책했던 것과"
 },
 {
  "id": "L225",
  "text": "똑같은 모습이죠."
 },
 {
  "id": "L226",
  "text": "도대체 왜 우리의 뇌는"
 },
 {
  "id": "L227",
  "text": "단순히 연락이 끊긴 상태를"
 },
 {
  "id": "L228",
  "text": "이토록 커다란 위협으로 받아들이는 걸까요?"
 },
 {
  "id": "L229",
  "text": "그 깊은 뿌리를 따라가 보면"
 },
 {
  "id": "L230",
  "text": "천구백오십이 년 영국에서 공개된"
 },
 {
  "id": "L231",
  "text": "한 흑백 기록 영화와"
 },
 {
  "id": "L232",
  "text": "만나게 됩니다."
 },
 {
  "id": "L233",
  "text": "영화의 주인공은"
 },
 {
  "id": "L234",
  "text": "태어난 지 이 년 오 개월 된 여자아이"
 },
 {
  "id": "L235",
  "text": "로라입니다."
 },
 {
  "id": "L236",
  "text": "로라는 작은 수술을 받기 위해"
 },
 {
  "id": "L237",
  "text": "팔 일 동안 병원에 입원하게 되는데요."
 },
 {
  "id": "L238",
  "text": "당시 병원들은"
 },
 {
  "id": "L239",
  "text": "감염을 막는다는 이유로"
 },
 {
  "id": "L240",
  "text": "부모의 면회를 엄격하게 금지했습니다."
 },
 {
  "id": "L241",
  "text": "심리학자 존 볼비 연구팀은"
 },
 {
  "id": "L242",
  "text": "매일 병실을 찾아가"
 },
 {
  "id": "L243",
  "text": "엄마와 연락이 완전히 끊긴 채"
 },
 {
  "id": "L244",
  "text": "홀로 남겨진 로라의 모습을"
 },
 {
  "id": "L245",
  "text": "카메라에 담았습니다."
 },
 {
  "id": "L246",
  "text": "입원 첫날"
 },
 {
  "id": "L247",
  "text": "로라는 침대 난간을 붙잡고"
 },
 {
  "id": "L248",
  "text": "엄마를 부르며"
 },
 {
  "id": "L249",
  "text": "목이 터져라 울었습니다."
 },
 {
  "id": "L250",
  "text": "그런데 사흘째가 되자"
 },
 {
  "id": "L251",
  "text": "로라는 더 이상 울지도 않고"
 },
 {
  "id": "L252",
  "text": "멍하니 앉아 있습니다."
 },
 {
  "id": "L253",
  "text": "간호사들 눈에는"
 },
 {
  "id": "L254",
  "text": "병원 생활에 잘 적응한 아이처럼"
 },
 {
  "id": "L255",
  "text": "보일 정도였죠."
 },
 {
  "id": "L256",
  "text": "하지만 그건 적응한 게 아니라"
 },
 {
  "id": "L257",
  "text": "아무리 불러도 엄마가 오지 않자"
 },
 {
  "id": "L258",
  "text": "깊은 절망에 빠져"
 },
 {
  "id": "L259",
  "text": "마음을 닫아버린 상태였습니다."
 },
 {
  "id": "L260",
  "text": "실제로 간호사가 다정하게 다가와 말을 걸자"
 },
 {
  "id": "L261",
  "text": "억눌러 왔던 설움이 터져 나오듯"
 },
 {
  "id": "L262",
  "text": "다시 엄마를 찾으며"
 },
 {
  "id": "L263",
  "text": "서럽게 울음을 터뜨렸거든요."
 },
 {
  "id": "L264",
  "text": "존 볼비는"
 },
 {
  "id": "L265",
  "text": "로라가 보여 준 이 애타는 반응을"
 },
 {
  "id": "L266",
  "text": "'애착'이라는 개념으로 설명했습니다."
 },
 {
  "id": "L267",
  "text": "인간의 마음속에는"
 },
 {
  "id": "L268",
  "text": "생존을 위한 일종의"
 },
 {
  "id": "L269",
  "text": "'안전 경보 장치'가 심어져 있습니다."
 },
 {
  "id": "L270",
  "text": "내가 의지하는 사람이"
 },
 {
  "id": "L271",
  "text": "시야에서 사라지거나"
 },
 {
  "id": "L272",
  "text": "연결이 끊어지면"
 },
 {
  "id": "L273",
  "text": "뇌는 즉시 비상벨을 울립니다."
 },
 {
  "id": "L274",
  "text": "처음에는 로라가 울부짖었듯"
 },
 {
  "id": "L275",
  "text": "상대를 찾으며"
 },
 {
  "id": "L276",
  "text": "초조하게 안절부절못하다가"
 },
 {
  "id": "L277",
  "text": "침묵이 길어지면"
 },
 {
  "id": "L278",
  "text": "결국 깊은 무기력과 우울함에"
 },
 {
  "id": "L279",
  "text": "빠지게 되는 거죠."
 },
 {
  "id": "L280",
  "text": "문제는"
 },
 {
  "id": "L281",
  "text": "우리가 몸도 마음도"
 },
 {
  "id": "L282",
  "text": "다 자란 어른이 되어서도"
 },
 {
  "id": "L283",
  "text": "이 마음속 경보 장치가"
 },
 {
  "id": "L284",
  "text": "사라지지 않는다는 데 있습니다."
 },
 {
  "id": "L285",
  "text": "성인이 된 후에는"
 },
 {
  "id": "L286",
  "text": "어린 시절 부모님을 향했던"
 },
 {
  "id": "L287",
  "text": "그 경보 장치가"
 },
 {
  "id": "L288",
  "text": "고스란히 '연인'이나"
 },
 {
  "id": "L289",
  "text": "'마음이 가는 상대'에게로 옮겨가거든요."
 },
 {
  "id": "L290",
  "text": "지우가 줄어들지 않는 숫자 '일'을 보며"
 },
 {
  "id": "L291",
  "text": "밤새 카톡창을 들락날락하고"
 },
 {
  "id": "L292",
  "text": "결국 불 꺼진 방에서"
 },
 {
  "id": "L293",
  "text": "우울함에 잠겼던 건"
 },
 {
  "id": "L294",
  "text": "어릴 적 로라의 마음속에서"
 },
 {
  "id": "L295",
  "text": "울렸던 것과"
 },
 {
  "id": "L296",
  "text": "똑같은 비상벨이 울렸기 때문입니다."
 },
 {
  "id": "L297",
  "text": "그런데 참 신기하죠"
 },
 {
  "id": "L298",
  "text": "모든 사람에게"
 },
 {
  "id": "L299",
  "text": "이 경보 장치가 있다면"
 },
 {
  "id": "L300",
  "text": "왜 똑같이 답장을 못 받았을 때"
 },
 {
  "id": "L301",
  "text": "누군가는 편하게 쉬며 일상을 보내고"
 },
 {
  "id": "L302",
  "text": "누군가는 지우처럼 피 말리는 밤을"
 },
 {
  "id": "L303",
  "text": "보내는 걸까요?"
 },
 {
  "id": "L304",
  "text": "그 이유는"
 },
 {
  "id": "L305",
  "text": "사람마다 이 경보 장치의"
 },
 {
  "id": "L306",
  "text": "예민함이 다르기 때문입니다."
 },
 {
  "id": "L307",
  "text": "심리학 연구들을 살펴보면"
 },
 {
  "id": "L308",
  "text": "성인 다섯 명 중 한 명꼴로는"
 },
 {
  "id": "L309",
  "text": "남들보다 이 경보 장치가 유독 예민한"
 },
 {
  "id": "L310",
  "text": "'불안형 애착' 성향을 가지고 있습니다."
 },
 {
  "id": "L311",
  "text": "이런 분들은"
 },
 {
  "id": "L312",
  "text": "연인과 연락이 원활하지 않을 때"
 },
 {
  "id": "L313",
  "text": "단순히 기분만 우울해지는 게 아니라"
 },
 {
  "id": "L314",
  "text": "실제로 몸속 스트레스 호르몬 수치가"
 },
 {
  "id": "L315",
  "text": "급격히 치솟고"
 },
 {
  "id": "L316",
  "text": "밤잠까지 설치는"
 },
 {
  "id": "L317",
  "text": "생리적인 고통을 겪습니다."
 },
 {
  "id": "L318",
  "text": "상대의 의도를 알 수 없는"
 },
 {
  "id": "L319",
  "text": "침묵이나 공백이 생기면"
 },
 {
  "id": "L320",
  "text": "예민한 경보 장치가"
 },
 {
  "id": "L321",
  "text": "즉각 비상벨을 울리며"
 },
 {
  "id": "L322",
  "text": "왜 연락이 없지?"
 },
 {
  "id": "L323",
  "text": "나한테 마음이 식었나?"
 },
 {
  "id": "L324",
  "text": "하는 최악의 시나리오를"
 },
 {
  "id": "L325",
  "text": "써 내려가기 때문이죠."
 },
 {
  "id": "L326",
  "text": "하지만"
 },
 {
  "id": "L327",
  "text": "괜찮습니다."
 },
 {
  "id": "L328",
  "text": "수십 년간"
 },
 {
  "id": "L329",
  "text": "사람들의 애착 변화를 추적한"
 },
 {
  "id": "L330",
  "text": "심리학 연구들에 따르면"
 },
 {
  "id": "L331",
  "text": "이 예민한 경보 장치는"
 },
 {
  "id": "L332",
  "text": "나이가 들고 경험이 쌓일수록"
 },
 {
  "id": "L333",
  "text": "또 나와 잘 맞는"
 },
 {
  "id": "L334",
  "text": "안정적인 관계를 경험할수록"
 },
 {
  "id": "L335",
  "text": "서서히 잦아든다고 합니다."
 },
 {
  "id": "L336",
  "text": "타고난 마음의 경보 장치가"
 },
 {
  "id": "L337",
  "text": "하루아침에 바뀌지는 않지만"
 },
 {
  "id": "L338",
  "text": "우리가 어떻게 다루느냐에 따라"
 },
 {
  "id": "L339",
  "text": "얼마든지 다독여 나갈 수 있다는 뜻입니다."
 },
 {
  "id": "L340",
  "text": "그렇다면"
 },
 {
  "id": "L341",
  "text": "당장 오늘 밤"
 },
 {
  "id": "L342",
  "text": "줄어들지 않는 숫자 일 앞에서"
 },
 {
  "id": "L343",
  "text": "요동치는 우리 마음을"
 },
 {
  "id": "L344",
  "text": "어떻게 다독여야 할까요?"
 },
 {
  "id": "L345",
  "text": "과학적으로 검증된"
 },
 {
  "id": "L346",
  "text": "세 가지 현실적인 방법을"
 },
 {
  "id": "L347",
  "text": "알려드리겠습니다."
 },
 {
  "id": "L348",
  "text": "첫째,"
 },
 {
  "id": "L349",
  "text": "애써 괜찮아라고 본인을 다독이는 대신"
 },
 {
  "id": "L350",
  "text": "차라리 나 지금 불안해라고"
 },
 {
  "id": "L351",
  "text": "솔직하게 인정해 보세요."
 },
 {
  "id": "L352",
  "text": "이천십이 년 키르칸스키 연구팀은"
 },
 {
  "id": "L353",
  "text": "거미를 끔찍이 무서워하는 참가자"
 },
 {
  "id": "L354",
  "text": "여든여덟 명을 모았습니다."
 },
 {
  "id": "L355",
  "text": "그리고는 살아 움직이는 거대한 독거미"
 },
 {
  "id": "L356",
  "text": "타란툴라에서"
 },
 {
  "id": "L357",
  "text": "불과 육십 센티미터 떨어진 자리에 앉혔죠."
 },
 {
  "id": "L358",
  "text": "참가자들에게"
 },
 {
  "id": "L359",
  "text": "거미를 마주 보게 하면서"
 },
 {
  "id": "L360",
  "text": "그룹마다 각기 다른 말을"
 },
 {
  "id": "L361",
  "text": "소리 내어 읽게 했습니다."
 },
 {
  "id": "L362",
  "text": "첫 번째 그룹은"
 },
 {
  "id": "L363",
  "text": "자기 감정에 솔직하게 이름 붙이기."
 },
 {
  "id": "L364",
  "text": "저 징그러운 타란툴라가"
 },
 {
  "id": "L365",
  "text": "나한테 뛰어오를까 봐 불안해."
 },
 {
  "id": "L366",
  "text": "두 번째 그룹은"
 },
 {
  "id": "L367",
  "text": "스스로 달래기."
 },
 {
  "id": "L368",
  "text": "저 작은 거미는 날 해치지 않아"
 },
 {
  "id": "L369",
  "text": "위험하지 않아."
 },
 {
  "id": "L370",
  "text": "세 번째 그룹은"
 },
 {
  "id": "L371",
  "text": "아예 딴생각하기."
 },
 {
  "id": "L372",
  "text": "우리 집 거실 소파 앞에는"
 },
 {
  "id": "L373",
  "text": "텔레비전이 있어."
 },
 {
  "id": "L374",
  "text": "일주일 뒤"
 },
 {
  "id": "L375",
  "text": "참가자들이 다시 거미를 마주했을 때"
 },
 {
  "id": "L376",
  "text": "가장 놀라운 변화를 보인 쪽은"
 },
 {
  "id": "L377",
  "text": "어디였을까요?"
 },
 {
  "id": "L378",
  "text": "스스로를 달랜 그룹도"
 },
 {
  "id": "L379",
  "text": "딴생각을 한 그룹도 아닌"
 },
 {
  "id": "L380",
  "text": "\"불안해\"라고"
 },
 {
  "id": "L381",
  "text": "자신의 감정을 있는 그대로 말한"
 },
 {
  "id": "L382",
  "text": "그룹이었습니다."
 },
 {
  "id": "L383",
  "text": "내 감정에 정확한 이름을 붙이는 순간"
 },
 {
  "id": "L384",
  "text": "흥분해 있던 뇌의 경보 장치가"
 },
 {
  "id": "L385",
  "text": "비로소 이성적인 통제를"
 },
 {
  "id": "L386",
  "text": "되찾기 때문입니다."
 },
 {
  "id": "L387",
  "text": "답장이 없어 마음이 요동칠 땐"
 },
 {
  "id": "L388",
  "text": "애써 쿨한 척 넘기려 하지 말고"
 },
 {
  "id": "L389",
  "text": "휴대폰 메모장을 열어"
 },
 {
  "id": "L390",
  "text": "내 감정에 정확히 이름을 붙여"
 },
 {
  "id": "L391",
  "text": "적어 보세요."
 },
 {
  "id": "L392",
  "text": "여섯 시 삼십 분에 보낸 카톡이"
 },
 {
  "id": "L393",
  "text": "아직 안 읽혀서"
 },
 {
  "id": "L394",
  "text": "지금 내가 많이 불안하구나."
 },
 {
  "id": "L395",
  "text": "하고요."
 },
 {
  "id": "L396",
  "text": "둘째"
 },
 {
  "id": "L397",
  "text": "휴대폰을 언제 확인할지"
 },
 {
  "id": "L398",
  "text": "주도권을 내가 쥐세요."
 },
 {
  "id": "L399",
  "text": "행동경제학자"
 },
 {
  "id": "L400",
  "text": "댄 애리얼리는"
 },
 {
  "id": "L401",
  "text": "스마트폰 사용자를 대상으로"
 },
 {
  "id": "L402",
  "text": "알림 받는 방식을 바꾸는"
 },
 {
  "id": "L403",
  "text": "실험을 했습니다."
 },
 {
  "id": "L404",
  "text": "흔히 알림을 아예 꺼 두면"
 },
 {
  "id": "L405",
  "text": "마음이 편할 것 같지만"
 },
 {
  "id": "L406",
  "text": "결과는 정반대였습니다."
 },
 {
  "id": "L407",
  "text": "알림을 완전히 끈 사람들은"
 },
 {
  "id": "L408",
  "text": "중요한 연락을 놓칠까 봐"
 },
 {
  "id": "L409",
  "text": "오히려 더 불안해했거든요."
 },
 {
  "id": "L410",
  "text": "대신 오전 아홉 시"
 },
 {
  "id": "L411",
  "text": "오후 세 시"
 },
 {
  "id": "L412",
  "text": "밤 아홉 시."
 },
 {
  "id": "L413",
  "text": "이렇게 하루 딱 세 번만"
 },
 {
  "id": "L414",
  "text": "알림을 몰아서 받도록 한 사람들은"
 },
 {
  "id": "L415",
  "text": "휴대폰 화면을 열어 보는 횟수가"
 },
 {
  "id": "L416",
  "text": "눈에 띄게 줄었습니다."
 },
 {
  "id": "L417",
  "text": "일상에 더 깊이 집중할 수 있었고"
 },
 {
  "id": "L418",
  "text": "휴대폰에 이리저리"
 },
 {
  "id": "L419",
  "text": "끌려다닌다는 느낌도"
 },
 {
  "id": "L420",
  "text": "훨씬 덜 받았죠."
 },
 {
  "id": "L421",
  "text": "하지만 막상 시간을 정해 둬도"
 },
 {
  "id": "L422",
  "text": "그사이에 슬쩍"
 },
 {
  "id": "L423",
  "text": "휴대폰을 확인하고 싶은 유혹이"
 },
 {
  "id": "L424",
  "text": "불쑥불쑥 찾아오기 마련입니다."
 },
 {
  "id": "L425",
  "text": "이럴 땐"
 },
 {
  "id": "L426",
  "text": "만약-그러면 공식을 사용해 보세요."
 },
 {
  "id": "L427",
  "text": "막연하게 '참아야지' 다짐하는 것보다"
 },
 {
  "id": "L428",
  "text": "만약 어떤 상황이 오면"
 },
 {
  "id": "L429",
  "text": "그때는 이렇게 행동한다고"
 },
 {
  "id": "L430",
  "text": "구체적인 규칙을 미리 정해 두면"
 },
 {
  "id": "L431",
  "text": "성공 확률이 비약적으로 높아집니다."
 },
 {
  "id": "L432",
  "text": "예를 들어 이렇게 정해 두는 겁니다."
 },
 {
  "id": "L433",
  "text": "만약 삼십 분이 지나도"
 },
 {
  "id": "L434",
  "text": "카톡 숫자 일이 그대로면"
 },
 {
  "id": "L435",
  "text": "일단 휴대폰을 서랍에 넣고"
 },
 {
  "id": "L436",
  "text": "밤 아홉 시 정각에 다시 확인한다."
 },
 {
  "id": "L437",
  "text": "셋째"
 },
 {
  "id": "L438",
  "text": "이미 마음이 무겁게 가라앉았다면"
 },
 {
  "id": "L439",
  "text": "나를 무조건적으로 편안하게 해 주는"
 },
 {
  "id": "L440",
  "text": "존재의 사진을 보세요."
 },
 {
  "id": "L441",
  "text": "코넬 대학교에서"
 },
 {
  "id": "L442",
  "text": "대학생 백삼십팔 명을 대상으로"
 },
 {
  "id": "L443",
  "text": "과거에 속상했던 기억을"
 },
 {
  "id": "L444",
  "text": "떠올리게 한 뒤"
 },
 {
  "id": "L445",
  "text": "화면에 띄운 사진을"
 },
 {
  "id": "L446",
  "text": "구십 초 동안 바라보게 했습니다."
 },
 {
  "id": "L447",
  "text": "그 결과"
 },
 {
  "id": "L448",
  "text": "다른 사람의 사진을 본 학생들보다"
 },
 {
  "id": "L449",
  "text": "자신의 어머니 사진을 본 학생들의"
 },
 {
  "id": "L450",
  "text": "가라앉은 기분이"
 },
 {
  "id": "L451",
  "text": "훨씬 더 빠르고 크게 회복되었습니다."
 },
 {
  "id": "L452",
  "text": "여기서 주목할 점은"
 },
 {
  "id": "L453",
  "text": "속상한 기억을 떠올리기 전에"
 },
 {
  "id": "L454",
  "text": "사진을 먼저 본 그룹에서는"
 },
 {
  "id": "L455",
  "text": "이런 기분 회복 효과가"
 },
 {
  "id": "L456",
  "text": "나타나지 않았다는 겁니다."
 },
 {
  "id": "L457",
  "text": "즉 이 방법은"
 },
 {
  "id": "L458",
  "text": "불안을 미리 막아주는"
 },
 {
  "id": "L459",
  "text": "예방주사가 아니라"
 },
 {
  "id": "L460",
  "text": "이미 상처받고 가라앉은 마음을"
 },
 {
  "id": "L461",
  "text": "달래주는"
 },
 {
  "id": "L462",
  "text": "'마음의 응급약'으로 써야"
 },
 {
  "id": "L463",
  "text": "효과가 있다는 뜻입니다."
 },
 {
  "id": "L464",
  "text": "만약 기다림에 지쳐"
 },
 {
  "id": "L465",
  "text": "마음이 무겁게 가라앉은 뒤라면"
 },
 {
  "id": "L466",
  "text": "답장 없는 그 사람의 프로필 사진을"
 },
 {
  "id": "L467",
  "text": "확대해 보는 대신"
 },
 {
  "id": "L468",
  "text": "부모님이나 오랜 친구"
 },
 {
  "id": "L469",
  "text": "혹은 반려동물처럼"
 },
 {
  "id": "L470",
  "text": "내 마음을 무조건적으로"
 },
 {
  "id": "L471",
  "text": "든든하게 만들어 주는"
 },
 {
  "id": "L472",
  "text": "존재의 사진을"
 },
 {
  "id": "L473",
  "text": "꺼내 보시길 바랍니다."
 },
 {
  "id": "L474",
  "text": "생각해 보면"
 },
 {
  "id": "L475",
  "text": "상대방의 답장이 유독 늦어지는 날엔"
 },
 {
  "id": "L476",
  "text": "나를 향한 마음이 변해서가 아니라"
 },
 {
  "id": "L477",
  "text": "어쩌면"
 },
 {
  "id": "L478",
  "text": "내가 모르는 그 사람의 하루에"
 },
 {
  "id": "L479",
  "text": "거센 바람이 불고 있는 건지도 모릅니다."
 },
 {
  "id": "L480",
  "text": "예상치 못하게 길어진 회의"
 },
 {
  "id": "L481",
  "text": "발 디딜 틈 없는 퇴근길 지하철"
 },
 {
  "id": "L482",
  "text": "갑자기 꺼져 버린 휴대폰 배터리 같은"
 },
 {
  "id": "L483",
  "text": "일상의 바람 말이에요."
 },
 {
  "id": "L484",
  "text": "물론 때로는 아무리 기다려도"
 },
 {
  "id": "L485",
  "text": "끝내 답장이 돌아오지 않는 날도"
 },
 {
  "id": "L486",
  "text": "있겠죠."
 },
 {
  "id": "L487",
  "text": "하지만 그건"
 },
 {
  "id": "L488",
  "text": "내가 휴대폰만 붙잡고"
 },
 {
  "id": "L489",
  "text": "밤새 애를 태운다고 해서"
 },
 {
  "id": "L490",
  "text": "바뀔 수 있는 일이 아닙니다."
 },
 {
  "id": "L491",
  "text": "어쩌면 답장 하나에"
 },
 {
  "id": "L492",
  "text": "이토록 쉽게 불안해지는 마음은"
 },
 {
  "id": "L493",
  "text": "내가 나약하고 못나서가 아니라"
 },
 {
  "id": "L494",
  "text": "지금 내 삶에서"
 },
 {
  "id": "L495",
  "text": "그 사람이 그만큼 소중하다는"
 },
 {
  "id": "L496",
  "text": "아주 솔직한 신호인지도 모르겠습니다."
 },
 {
  "id": "L497",
  "text": "여러분들만의"
 },
 {
  "id": "L498",
  "text": "마음의 안정을 찾는 방법이 있다면"
 },
 {
  "id": "L499",
  "text": "댓글로 공유해 주세요."
 }
]