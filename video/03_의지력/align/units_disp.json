[
 {
  "id": "L001",
  "text": "당신은 오늘 퇴근하고"
 },
 {
  "id": "L002",
  "text": "미뤄 왔던 헬스장에 가려고 합니다."
 },
 {
  "id": "L003",
  "text": "아침에 운동복도 챙겼습니다."
 },
 {
  "id": "L004",
  "text": "오늘은 정말"
 },
 {
  "id": "L005",
  "text": "가야겠다고 생각했죠."
 },
 {
  "id": "L006",
  "text": "그런데 하루 일을 마치고"
 },
 {
  "id": "L007",
  "text": "집에 돌아오니"
 },
 {
  "id": "L008",
  "text": "신발을 벗는 것도 귀찮습니다."
 },
 {
  "id": "L009",
  "text": "가방을 내려놓고"
 },
 {
  "id": "L010",
  "text": "침대에 눕습니다."
 },
 {
  "id": "L011",
  "text": "운동은 조금만 쉬었다가"
 },
 {
  "id": "L012",
  "text": "가기로 합니다."
 },
 {
  "id": "L013",
  "text": "30분이 지났습니다."
 },
 {
  "id": "L014",
  "text": "몸은 여전히 무겁습니다."
 },
 {
  "id": "L015",
  "text": "지금 나가려면"
 },
 {
  "id": "L016",
  "text": "옷부터 갈아입고"
 },
 {
  "id": "L017",
  "text": "헬스장까지 걸어가야 합니다."
 },
 {
  "id": "L018",
  "text": "운동하고 씻고"
 },
 {
  "id": "L019",
  "text": "돌아올 생각을 하니"
 },
 {
  "id": "L020",
  "text": "그냥 오늘은"
 },
 {
  "id": "L021",
  "text": "여기 누워 있고 싶습니다."
 },
 {
  "id": "L022",
  "text": "결국 오늘만 쉬고"
 },
 {
  "id": "L023",
  "text": "내일은 꼭 운동하겠다고 다짐합니다."
 },
 {
  "id": "L024",
  "text": "휴대폰을 보다가"
 },
 {
  "id": "L025",
  "text": "퇴근 후에 운동도 하고"
 },
 {
  "id": "L026",
  "text": "외국어도 배우는 사람을 발견합니다."
 },
 {
  "id": "L027",
  "text": "저 사람도 일하고 왔을 텐데"
 },
 {
  "id": "L028",
  "text": "안 피곤한가?"
 },
 {
  "id": "L029",
  "text": "생각합니다."
 },
 {
  "id": "L030",
  "text": "그러면서 문득"
 },
 {
  "id": "L031",
  "text": "나는 왜 아무것도 안 하고"
 },
 {
  "id": "L032",
  "text": "쉬고만 싶을까?"
 },
 {
  "id": "L033",
  "text": "생각합니다."
 },
 {
  "id": "L034",
  "text": "하고 싶은 게"
 },
 {
  "id": "L035",
  "text": "없는 것도 아닙니다."
 },
 {
  "id": "L036",
  "text": "배워 보고 싶은 악기도 있고"
 },
 {
  "id": "L037",
  "text": "읽고 싶은 책도 있습니다."
 },
 {
  "id": "L038",
  "text": "그런데 출근했다가 돌아오면"
 },
 {
  "id": "L039",
  "text": "그걸 할 힘이 없습니다."
 },
 {
  "id": "L040",
  "text": "회사에서는 어떻게든"
 },
 {
  "id": "L041",
  "text": "하루를 버텼는데"
 },
 {
  "id": "L042",
  "text": "정작 나를 위해"
 },
 {
  "id": "L043",
  "text": "쓰고 싶은 시간에는"
 },
 {
  "id": "L044",
  "text": "아무것도 남아 있지 않은 기분입니다."
 },
 {
  "id": "L045",
  "text": "하지만 이게 정말"
 },
 {
  "id": "L046",
  "text": "내가 게을러서 생기는 일일까요?"
 },
 {
  "id": "L047",
  "text": "오늘은 퇴근 후"
 },
 {
  "id": "L048",
  "text": "하고 싶은 일이 있어도"
 },
 {
  "id": "L049",
  "text": "시작하기 어려운 이유를 살펴보고"
 },
 {
  "id": "L050",
  "text": "지친 하루 뒤에도"
 },
 {
  "id": "L051",
  "text": "내 생활을 조금씩 이어 갈"
 },
 {
  "id": "L052",
  "text": "방법 3가지를"
 },
 {
  "id": "L053",
  "text": "이야기해 보겠습니다."
 },
 {
  "id": "L054",
  "text": "수요일 저녁 8시입니다."
 },
 {
  "id": "L055",
  "text": "씻고 밥을 먹고 나니"
 },
 {
  "id": "L056",
  "text": "잠들기 전까지"
 },
 {
  "id": "L057",
  "text": "2시간 정도가 남았습니다."
 },
 {
  "id": "L058",
  "text": "시계만 보면"
 },
 {
  "id": "L059",
  "text": "뭔가 하나쯤은"
 },
 {
  "id": "L060",
  "text": "할 수 있을 것 같습니다."
 },
 {
  "id": "L061",
  "text": "주말에 산 영어책이"
 },
 {
  "id": "L062",
  "text": "눈에 들어옵니다."
 },
 {
  "id": "L063",
  "text": "영어 공부를 해 보고 싶기는 합니다."
 },
 {
  "id": "L064",
  "text": "그런데 책상에 앉아서"
 },
 {
  "id": "L065",
  "text": "공부할 생각을 하니"
 },
 {
  "id": "L066",
  "text": "손이 가지 않습니다."
 },
 {
  "id": "L067",
  "text": "그래서 조금만 쉬었다 하자는 생각으로"
 },
 {
  "id": "L068",
  "text": "침대에 누워서"
 },
 {
  "id": "L069",
  "text": "유튜브를 켭니다."
 },
 {
  "id": "L070",
  "text": "쇼츠 화면을 넘기는 정도는"
 },
 {
  "id": "L071",
  "text": "할 수 있습니다."
 },
 {
  "id": "L072",
  "text": "하지만 몸을 일으켜"
 },
 {
  "id": "L073",
  "text": "뭔가를 시작하는 건"
 },
 {
  "id": "L074",
  "text": "전혀 다른 일처럼 느껴집니다."
 },
 {
  "id": "L075",
  "text": "그러다 이런 생각이 듭니다."
 },
 {
  "id": "L076",
  "text": "휴대폰 볼 힘은 있으면서"
 },
 {
  "id": "L077",
  "text": "영어 공부할 힘은 없다는 건"
 },
 {
  "id": "L078",
  "text": "핑계 아닐까?"
 },
 {
  "id": "L079",
  "text": "하지만 두 행동에 필요한 수고는"
 },
 {
  "id": "L080",
  "text": "같지 않습니다."
 },
 {
  "id": "L081",
  "text": "누운 채로 아무 생각 없이"
 },
 {
  "id": "L082",
  "text": "화면을 넘기는 일과"
 },
 {
  "id": "L083",
  "text": "책상에 앉아 머리를 쓰며"
 },
 {
  "id": "L084",
  "text": "공부하는 일을"
 },
 {
  "id": "L085",
  "text": "같은 기준으로"
 },
 {
  "id": "L086",
  "text": "비교할 수는 없죠."
 },
 {
  "id": "L087",
  "text": "휴대폰을 보고 있다는 사실만으로"
 },
 {
  "id": "L088",
  "text": "피곤하지 않다는 결론을"
 },
 {
  "id": "L089",
  "text": "내릴 수는 없습니다."
 },
 {
  "id": "L090",
  "text": "우리는 달력에 빈칸이 있으면"
 },
 {
  "id": "L091",
  "text": "그 시간에 할 일을 넣습니다."
 },
 {
  "id": "L092",
  "text": "그런데 달력에는"
 },
 {
  "id": "L093",
  "text": "그때 내가 얼마나 지쳐 있을지가"
 },
 {
  "id": "L094",
  "text": "표시돼 있지 않습니다."
 },
 {
  "id": "L095",
  "text": "저녁 8시부터 9시까지"
 },
 {
  "id": "L096",
  "text": "비어 있다는 것과"
 },
 {
  "id": "L097",
  "text": "그 1시간에"
 },
 {
  "id": "L098",
  "text": "영어 공부를 할 힘이 있다는 것은"
 },
 {
  "id": "L099",
  "text": "다른 문제입니다."
 },
 {
  "id": "L100",
  "text": "퇴근 후 계획이 자꾸 무너진다면"
 },
 {
  "id": "L101",
  "text": "이 차이부터"
 },
 {
  "id": "L102",
  "text": "살펴볼 필요가 있습니다."
 },
 {
  "id": "L103",
  "text": "그렇다면 하루 동안 쌓인 피로는"
 },
 {
  "id": "L104",
  "text": "이후의 활동에"
 },
 {
  "id": "L105",
  "text": "어떤 영향을 줄까요?"
 },
 {
  "id": "L106",
  "text": "이를 알아보고자"
 },
 {
  "id": "L107",
  "text": "마코라 연구팀은"
 },
 {
  "id": "L108",
  "text": "한 실험을 진행했습니다."
 },
 {
  "id": "L109",
  "text": "실험에 참가한 16명의 사람들 앞에는"
 },
 {
  "id": "L110",
  "text": "수학 문제집이 있고"
 },
 {
  "id": "L111",
  "text": "직원의 안내에 따라"
 },
 {
  "id": "L112",
  "text": "그들은 90분 동안"
 },
 {
  "id": "L113",
  "text": "수학 문제를 풀었습니다."
 },
 {
  "id": "L114",
  "text": "그리고 나서"
 },
 {
  "id": "L115",
  "text": "실내 자전거를 타게 했습니다."
 },
 {
  "id": "L116",
  "text": "그다음 날에는"
 },
 {
  "id": "L117",
  "text": "같은 시간 동안"
 },
 {
  "id": "L118",
  "text": "차분한 다큐멘터리를 본 뒤"
 },
 {
  "id": "L119",
  "text": "자전거를 탔습니다."
 },
 {
  "id": "L120",
  "text": "과연 이들은"
 },
 {
  "id": "L121",
  "text": "두 날에 탄 자전거 시간이"
 },
 {
  "id": "L122",
  "text": "똑같았을까요?"
 },
 {
  "id": "L123",
  "text": "다큐멘터리를 본 뒤에는"
 },
 {
  "id": "L124",
  "text": "평균 약 12분을 버텼지만"
 },
 {
  "id": "L125",
  "text": "수학 문제를 푼 뒤에는"
 },
 {
  "id": "L126",
  "text": "약 9분에 멈췄습니다."
 },
 {
  "id": "L127",
  "text": "더 눈여겨볼 점은 그다음입니다."
 },
 {
  "id": "L128",
  "text": "두 날 모두"
 },
 {
  "id": "L129",
  "text": "운동 중의 심폐 반응에는"
 },
 {
  "id": "L130",
  "text": "큰 차이가 없었지만"
 },
 {
  "id": "L131",
  "text": "그들은 모두"
 },
 {
  "id": "L132",
  "text": "수학 문제를 풀었던 날"
 },
 {
  "id": "L133",
  "text": "즉 정신적으로 피곤한 날에"
 },
 {
  "id": "L134",
  "text": "한 운동이"
 },
 {
  "id": "L135",
  "text": "더 힘들었다고 답했습니다."
 },
 {
  "id": "L136",
  "text": "한마디로 머리를 오래 쓴 뒤에는"
 },
 {
  "id": "L137",
  "text": "몸으로 하는 일도"
 },
 {
  "id": "L138",
  "text": "더 버거워질 수 있다는 뜻입니다."
 },
 {
  "id": "L139",
  "text": "주로 앉아서 일했다고 해서"
 },
 {
  "id": "L140",
  "text": "퇴근 후 운동할 힘이"
 },
 {
  "id": "L141",
  "text": "그대로 남아 있다고"
 },
 {
  "id": "L142",
  "text": "볼 수는 없는 것이죠."
 },
 {
  "id": "L143",
  "text": "하루 종일 서 있거나"
 },
 {
  "id": "L144",
  "text": "물건을 옮기며 일했다면"
 },
 {
  "id": "L145",
  "text": "몸을 쓴 부담도 있습니다."
 },
 {
  "id": "L146",
  "text": "출퇴근길에 오래 서 있었을 수도 있고"
 },
 {
  "id": "L147",
  "text": "전날 잠을 충분히 못 잤을 수도 있습니다."
 },
 {
  "id": "L148",
  "text": "퇴근했다는 이유만으로"
 },
 {
  "id": "L149",
  "text": "이런 피로가"
 },
 {
  "id": "L150",
  "text": "초기화되지는 않습니다."
 },
 {
  "id": "L151",
  "text": "그런데 우리는 저녁의 자신에게"
 },
 {
  "id": "L152",
  "text": "아침에 세운 계획을"
 },
 {
  "id": "L153",
  "text": "그대로 건넵니다."
 },
 {
  "id": "L154",
  "text": "그래서 아침에는 할 만해 보였던"
 },
 {
  "id": "L155",
  "text": "1시간 운동이"
 },
 {
  "id": "L156",
  "text": "저녁에는"
 },
 {
  "id": "L157",
  "text": "너무 큰 일로 느껴지는 겁니다."
 },
 {
  "id": "L158",
  "text": "여기서 이상한 점이 있습니다."
 },
 {
  "id": "L159",
  "text": "적당한 운동과"
 },
 {
  "id": "L160",
  "text": "취미 생활이"
 },
 {
  "id": "L161",
  "text": "피로 회복에 도움이 된다는 건"
 },
 {
  "id": "L162",
  "text": "여러 연구를 통해"
 },
 {
  "id": "L163",
  "text": "증명된 사실입니다."
 },
 {
  "id": "L164",
  "text": "그런데 정작 지친 날에는"
 },
 {
  "id": "L165",
  "text": "그 활동을 시작하는 것 자체가"
 },
 {
  "id": "L166",
  "text": "힘듭니다."
 },
 {
  "id": "L167",
  "text": "회복이 필요할수록"
 },
 {
  "id": "L168",
  "text": "회복을 위한 행동에"
 },
 {
  "id": "L169",
  "text": "들어가기 어려워지는 것이죠."
 },
 {
  "id": "L170",
  "text": "조직심리학자"
 },
 {
  "id": "L171",
  "text": "자비네 존넨탁은"
 },
 {
  "id": "L172",
  "text": "2018년 논문에서"
 },
 {
  "id": "L173",
  "text": "이런 문제를"
 },
 {
  "id": "L174",
  "text": "회복의 역설이라는 개념으로"
 },
 {
  "id": "L175",
  "text": "정리했습니다."
 },
 {
  "id": "L176",
  "text": "그래서"
 },
 {
  "id": "L177",
  "text": "운동하면 덜 피곤해진다는데"
 },
 {
  "id": "L178",
  "text": "일단 해"
 },
 {
  "id": "L179",
  "text": "라는 말만으로는"
 },
 {
  "id": "L180",
  "text": "충분하지 않습니다."
 },
 {
  "id": "L181",
  "text": "운동이 좋다는 사실은"
 },
 {
  "id": "L182",
  "text": "이미 알고 있습니다."
 },
 {
  "id": "L183",
  "text": "지금 막힌 곳은"
 },
 {
  "id": "L184",
  "text": "운동의 필요성을 이해하는 단계가"
 },
 {
  "id": "L185",
  "text": "아닙니다."
 },
 {
  "id": "L186",
  "text": "지친 몸으로 그 활동을"
 },
 {
  "id": "L187",
  "text": "시작하고 이어 가는"
 },
 {
  "id": "L188",
  "text": "단계입니다."
 },
 {
  "id": "L189",
  "text": "그런데 왜 좋아하는 취미까지"
 },
 {
  "id": "L190",
  "text": "이렇게 부담스러울까요?"
 },
 {
  "id": "L191",
  "text": "좋아한다는 마음이 있어도"
 },
 {
  "id": "L192",
  "text": "그 일을 하는 데 필요한 수고가"
 },
 {
  "id": "L193",
  "text": "없어지지는 않기 때문입니다."
 },
 {
  "id": "L194",
  "text": "여행을 좋아해도"
 },
 {
  "id": "L195",
  "text": "여행 가기 전에 짐을 싸고"
 },
 {
  "id": "L196",
  "text": "여행지까지 가는 데"
 },
 {
  "id": "L197",
  "text": "힘이 듭니다."
 },
 {
  "id": "L198",
  "text": "기타 연주를 좋아해도"
 },
 {
  "id": "L199",
  "text": "등을 세우고 앉아"
 },
 {
  "id": "L200",
  "text": "손가락을 움직이며"
 },
 {
  "id": "L201",
  "text": "연습하는 일에는"
 },
 {
  "id": "L202",
  "text": "힘이 듭니다."
 },
 {
  "id": "L203",
  "text": "헬스장에 가는 일도"
 },
 {
  "id": "L204",
  "text": "자세히 보면"
 },
 {
  "id": "L205",
  "text": "운동 하나로 끝나지 않습니다."
 },
 {
  "id": "L206",
  "text": "준비하고 이동하고 운동하고"
 },
 {
  "id": "L207",
  "text": "씻고 돌아와야 합니다."
 },
 {
  "id": "L208",
  "text": "이미 지친 저녁에는"
 },
 {
  "id": "L209",
  "text": "운동 시간 앞뒤로 붙어 있는 과정까지"
 },
 {
  "id": "L210",
  "text": "크게 느껴질 수 있습니다."
 },
 {
  "id": "L211",
  "text": "그러니"
 },
 {
  "id": "L212",
  "text": "내가 정말 좋아하는 일이었다면"
 },
 {
  "id": "L213",
  "text": "피곤해도 했겠지"
 },
 {
  "id": "L214",
  "text": "라고 너무 빨리 결론 내리지"
 },
 {
  "id": "L215",
  "text": "않았으면 합니다."
 },
 {
  "id": "L216",
  "text": "좋아하는 마음과"
 },
 {
  "id": "L217",
  "text": "지금 할 수 있는 상태는"
 },
 {
  "id": "L218",
  "text": "서로 다를 수 있습니다."
 },
 {
  "id": "L219",
  "text": "이 문제를 풀려면"
 },
 {
  "id": "L220",
  "text": "피곤함을 무시한 채"
 },
 {
  "id": "L221",
  "text": "계획을 밀어붙이기보다"
 },
 {
  "id": "L222",
  "text": "지친 날에도 들어갈 수 있도록"
 },
 {
  "id": "L223",
  "text": "활동의 문턱을"
 },
 {
  "id": "L224",
  "text": "바꿔 볼 필요가 있습니다."
 },
 {
  "id": "L225",
  "text": "자 그렇다면"
 },
 {
  "id": "L226",
  "text": "무엇부터 해 보면 좋을까요?"
 },
 {
  "id": "L227",
  "text": "첫째"
 },
 {
  "id": "L228",
  "text": "남는 시간에 쉬려고 하지 말고"
 },
 {
  "id": "L229",
  "text": "쉴 시간을 미리 정해 두세요."
 },
 {
  "id": "L230",
  "text": "퇴근하고 집에 오자마자"
 },
 {
  "id": "L231",
  "text": "운동을 해야 한다고 생각하면"
 },
 {
  "id": "L232",
  "text": "소파에 잠깐 앉는 순간부터"
 },
 {
  "id": "L233",
  "text": "자괴감이 들고"
 },
 {
  "id": "L234",
  "text": "실패한 기분이 들 수 있습니다."
 },
 {
  "id": "L235",
  "text": "하지만 하루를 보내고"
 },
 {
  "id": "L236",
  "text": "무언가를 바로 할 수 없는"
 },
 {
  "id": "L237",
  "text": "지친 상태라면"
 },
 {
  "id": "L238",
  "text": "쉬는 시간이"
 },
 {
  "id": "L239",
  "text": "저녁 계획에"
 },
 {
  "id": "L240",
  "text": "무조건 들어가야 합니다."
 },
 {
  "id": "L241",
  "text": "밥을 먹어야 하는데 미루고 있는지"
 },
 {
  "id": "L242",
  "text": "잠이 부족한데"
 },
 {
  "id": "L243",
  "text": "또 취침 시간을 늦추려는지"
 },
 {
  "id": "L244",
  "text": "먼저 살펴보세요."
 },
 {
  "id": "L245",
  "text": "운동과 취미를 넣기 위해"
 },
 {
  "id": "L246",
  "text": "이미 필요한 휴식까지"
 },
 {
  "id": "L247",
  "text": "빼고 있지는 않은지"
 },
 {
  "id": "L248",
  "text": "보는 겁니다."
 },
 {
  "id": "L249",
  "text": "그리고 집에 돌아와서는"
 },
 {
  "id": "L250",
  "text": "당장 뭔가를 시작할 수 있는지부터"
 },
 {
  "id": "L251",
  "text": "시험하지 말고"
 },
 {
  "id": "L252",
  "text": "먼저 편히 쉬어 보세요."
 },
 {
  "id": "L253",
  "text": "쉬고 나서"
 },
 {
  "id": "L254",
  "text": "오늘 할 수 있는 활동의 크기를"
 },
 {
  "id": "L255",
  "text": "정하는 겁니다."
 },
 {
  "id": "L256",
  "text": "물론 잠깐 쉬었다고"
 },
 {
  "id": "L257",
  "text": "아침처럼 기운이"
 },
 {
  "id": "L258",
  "text": "돌아오는 것은 아닙니다."
 },
 {
  "id": "L259",
  "text": "만약 쉬었는데도 여전히 지치면"
 },
 {
  "id": "L260",
  "text": "오늘은 더 쉬어야 하는"
 },
 {
  "id": "L261",
  "text": "날일 수 있습니다."
 },
 {
  "id": "L262",
  "text": "여기서 중요한 것은"
 },
 {
  "id": "L263",
  "text": "매일 저녁에"
 },
 {
  "id": "L264",
  "text": "무엇이든 해내는 것이 아닙니다."
 },
 {
  "id": "L265",
  "text": "내가 실제로 쓸 수 있는 힘이"
 },
 {
  "id": "L266",
  "text": "어느 정도인지 살핀 다음"
 },
 {
  "id": "L267",
  "text": "그 안에서 선택하는 겁니다."
 },
 {
  "id": "L268",
  "text": "하지만 조금 쉬고 나서도"
 },
 {
  "id": "L269",
  "text": "원래 계획한 1시간 운동은"
 },
 {
  "id": "L270",
  "text": "부담스러울 수 있습니다."
 },
 {
  "id": "L271",
  "text": "그래서"
 },
 {
  "id": "L272",
  "text": "두 번째 방법이 필요합니다."
 },
 {
  "id": "L273",
  "text": "둘째"
 },
 {
  "id": "L274",
  "text": "피곤한 날에 할 수 있는 분량을"
 },
 {
  "id": "L275",
  "text": "따로 만들고"
 },
 {
  "id": "L276",
  "text": "준비 과정도"
 },
 {
  "id": "L277",
  "text": "함께 줄여 보세요."
 },
 {
  "id": "L278",
  "text": "2002년"
 },
 {
  "id": "L279",
  "text": "밀른 연구팀이 발표한 연구에서는"
 },
 {
  "id": "L280",
  "text": "248명을"
 },
 {
  "id": "L281",
  "text": "두 그룹으로 나누었습니다."
 },
 {
  "id": "L282",
  "text": "A그룹은"
 },
 {
  "id": "L283",
  "text": "운동 동기를 높이는 설명을 들었습니다."
 },
 {
  "id": "L284",
  "text": "운동하려는 마음은 강해졌지만"
 },
 {
  "id": "L285",
  "text": "이후 운동 행동이"
 },
 {
  "id": "L286",
  "text": "유의하게 늘지는 않았습니다."
 },
 {
  "id": "L287",
  "text": "같은 설명에"
 },
 {
  "id": "L288",
  "text": "구체적인 실행 계획까지"
 },
 {
  "id": "L289",
  "text": "듣고 정리한 B그룹은"
 },
 {
  "id": "L290",
  "text": "운동 행동이"
 },
 {
  "id": "L291",
  "text": "눈에 띄게 늘었습니다."
 },
 {
  "id": "L292",
  "text": "하고 싶다는 마음과"
 },
 {
  "id": "L293",
  "text": "실제로 무엇을 할지 정하는 일 사이에는"
 },
 {
  "id": "L294",
  "text": "차이가 있다는 뜻입니다."
 },
 {
  "id": "L295",
  "text": "언제 어디서 행동할지를"
 },
 {
  "id": "L296",
  "text": "구체화하는 이런 방식을"
 },
 {
  "id": "L297",
  "text": "실행 의도라고 부릅니다."
 },
 {
  "id": "L298",
  "text": "그러면"
 },
 {
  "id": "L299",
  "text": "오늘의 피로를 고려한"
 },
 {
  "id": "L300",
  "text": "선택지를 만들어 봅시다."
 },
 {
  "id": "L301",
  "text": "평소에는 헬스장에 가더라도"
 },
 {
  "id": "L302",
  "text": "많이 지친 날에는"
 },
 {
  "id": "L303",
  "text": "집 앞을 잠깐 걷는 것으로"
 },
 {
  "id": "L304",
  "text": "바꿀 수 있습니다."
 },
 {
  "id": "L305",
  "text": "그림을 그린다면"
 },
 {
  "id": "L306",
  "text": "한 장을 완성하는 대신"
 },
 {
  "id": "L307",
  "text": "식탁에 놓인 컵 하나만"
 },
 {
  "id": "L308",
  "text": "그려 볼 수 있겠죠."
 },
 {
  "id": "L309",
  "text": "계획은"
 },
 {
  "id": "L310",
  "text": "이렇게 적어 볼 수 있습니다."
 },
 {
  "id": "L311",
  "text": "수요일 저녁에는"
 },
 {
  "id": "L312",
  "text": "밥 먹고"
 },
 {
  "id": "L313",
  "text": "집 앞을 5분 걷는다."
 },
 {
  "id": "L314",
  "text": "그림이라면"
 },
 {
  "id": "L315",
  "text": "목요일 저녁에는"
 },
 {
  "id": "L316",
  "text": "쉬고 나서"
 },
 {
  "id": "L317",
  "text": "펼쳐 둔 스케치북에"
 },
 {
  "id": "L318",
  "text": "컵 하나를 그린다"
 },
 {
  "id": "L319",
  "text": "가 되겠죠."
 },
 {
  "id": "L320",
  "text": "5분이 특별한 효과를 보장하는"
 },
 {
  "id": "L321",
  "text": "숫자는 아닙니다."
 },
 {
  "id": "L322",
  "text": "지친 날에도 선택할 수 있는"
 },
 {
  "id": "L323",
  "text": "작은 활동을 정하기 위한"
 },
 {
  "id": "L324",
  "text": "예시입니다."
 },
 {
  "id": "L325",
  "text": "평소 운동량을 채우는 목표와"
 },
 {
  "id": "L326",
  "text": "오늘 조금 움직이는 목표를"
 },
 {
  "id": "L327",
  "text": "구분하는 것이죠."
 },
 {
  "id": "L328",
  "text": "여기서"
 },
 {
  "id": "L329",
  "text": "준비 과정도 같이 줄여 보세요."
 },
 {
  "id": "L330",
  "text": "그림을 그릴 때마다"
 },
 {
  "id": "L331",
  "text": "가방을 뒤져야 한다면"
 },
 {
  "id": "L332",
  "text": "스케치북과 연필을"
 },
 {
  "id": "L333",
  "text": "한곳에 두는 겁니다."
 },
 {
  "id": "L334",
  "text": "걷는 날에는"
 },
 {
  "id": "L335",
  "text": "멀리 있는 공원까지 이동하기보다"
 },
 {
  "id": "L336",
  "text": "집 근처에서"
 },
 {
  "id": "L337",
  "text": "시작할 수 있겠죠."
 },
 {
  "id": "L338",
  "text": "그리고 5분만 하기로 했다면"
 },
 {
  "id": "L339",
  "text": "정말 5분 만에"
 },
 {
  "id": "L340",
  "text": "끝내도 됩니다."
 },
 {
  "id": "L341",
  "text": "일단 시작했으니"
 },
 {
  "id": "L342",
  "text": "30분은 해야 한다고 요구하면"
 },
 {
  "id": "L343",
  "text": "다음번의 5분도"
 },
 {
  "id": "L344",
  "text": "무겁게 느껴질 수 있으니까요."
 },
 {
  "id": "L345",
  "text": "그런데 분량을 줄여도"
 },
 {
  "id": "L346",
  "text": "활동 자체가 내내 괴롭기만 하다면"
 },
 {
  "id": "L347",
  "text": "손이 가지 않겠죠."
 },
 {
  "id": "L348",
  "text": "그래서 마지막으로 바꿔 볼 것은"
 },
 {
  "id": "L349",
  "text": "그 시간 안에서"
 },
 {
  "id": "L350",
  "text": "내가 무엇을 얻는가입니다."
 },
 {
  "id": "L351",
  "text": "셋째"
 },
 {
  "id": "L352",
  "text": "지금 조금이라도 더 즐거운 활동을"
 },
 {
  "id": "L353",
  "text": "골라 보세요."
 },
 {
  "id": "L354",
  "text": "독서를 즐겨 하는 60명을"
 },
 {
  "id": "L355",
  "text": "두 그룹으로 나누어"
 },
 {
  "id": "L356",
  "text": "A그룹에게는"
 },
 {
  "id": "L357",
  "text": "자신이 즐겨 읽는 장르의 책을"
 },
 {
  "id": "L358",
  "text": "고르게 했고"
 },
 {
  "id": "L359",
  "text": "B그룹에게는"
 },
 {
  "id": "L360",
  "text": "본인의 인생에 도움이 될 것 같은 책을"
 },
 {
  "id": "L361",
  "text": "고르게 했습니다."
 },
 {
  "id": "L362",
  "text": "본인이 즐겨 읽는 장르의 책을"
 },
 {
  "id": "L363",
  "text": "고른 사람들은"
 },
 {
  "id": "L364",
  "text": "평균 약 50페이지를 읽었고"
 },
 {
  "id": "L365",
  "text": "인생에 도움이 될 것 같은 책을"
 },
 {
  "id": "L366",
  "text": "고른 사람들은"
 },
 {
  "id": "L367",
  "text": "약 20페이지를 읽었습니다."
 },
 {
  "id": "L368",
  "text": "미래에 얻을 결과뿐 아니라"
 },
 {
  "id": "L369",
  "text": "지금 하는 과정의 즐거움도"
 },
 {
  "id": "L370",
  "text": "행동을 이어 가는 데"
 },
 {
  "id": "L371",
  "text": "도움이 될 수 있다는 것입니다."
 },
 {
  "id": "L372",
  "text": "퇴근 후 활동을 고를 때도"
 },
 {
  "id": "L373",
  "text": "이 질문을 더해 보세요."
 },
 {
  "id": "L374",
  "text": "지금의 내가"
 },
 {
  "id": "L375",
  "text": "그나마 하고 싶은 건"
 },
 {
  "id": "L376",
  "text": "무엇일까?"
 },
 {
  "id": "L377",
  "text": "혼자 달리는 것보다"
 },
 {
  "id": "L378",
  "text": "친구와 가볍게"
 },
 {
  "id": "L379",
  "text": "배드민턴을 치는 편이"
 },
 {
  "id": "L380",
  "text": "좋을 수 있습니다."
 },
 {
  "id": "L381",
  "text": "강의를 따라 그림을 배우는 것보다"
 },
 {
  "id": "L382",
  "text": "좋아하는 캐릭터를 그리는 편이"
 },
 {
  "id": "L383",
  "text": "오늘은 더 끌릴 수도 있죠."
 },
 {
  "id": "L384",
  "text": "기타를 배우고 있다면"
 },
 {
  "id": "L385",
  "text": "늘 새 진도를 나갈 필요는 없습니다."
 },
 {
  "id": "L386",
  "text": "이미 칠 줄 아는 좋아하는 곡의"
 },
 {
  "id": "L387",
  "text": "한 부분을"
 },
 {
  "id": "L388",
  "text": "다시 연주해 봐도 됩니다."
 },
 {
  "id": "L389",
  "text": "책도 오늘은"
 },
 {
  "id": "L390",
  "text": "공부해야 하는 책보다"
 },
 {
  "id": "L391",
  "text": "다음 이야기가 궁금한 소설을"
 },
 {
  "id": "L392",
  "text": "고를 수 있고요."
 },
 {
  "id": "L393",
  "text": "이런 선택이"
 },
 {
  "id": "L394",
  "text": "피로를 없애 주는 것은 아닙니다."
 },
 {
  "id": "L395",
  "text": "다만 힘을 들여 하는 그 시간 안에"
 },
 {
  "id": "L396",
  "text": "내가 좋아하는 경험을"
 },
 {
  "id": "L397",
  "text": "함께 넣어 보는 겁니다."
 },
 {
  "id": "L398",
  "text": "그리고 세 방법을 써 봐도"
 },
 {
  "id": "L399",
  "text": "평일 저녁에는"
 },
 {
  "id": "L400",
  "text": "도저히 여유가 생기지 않을 수 있습니다."
 },
 {
  "id": "L401",
  "text": "그렇다면"
 },
 {
  "id": "L402",
  "text": "활동을 배치한 시간도"
 },
 {
  "id": "L403",
  "text": "바꿔 볼 수 있습니다."
 },
 {
  "id": "L404",
  "text": "평일에 운동과 취미를 전부 넣기보다"
 },
 {
  "id": "L405",
  "text": "한 번씩 나눠 두거나"
 },
 {
  "id": "L406",
  "text": "긴 활동은"
 },
 {
  "id": "L407",
  "text": "상대적으로 여유 있는 휴일에"
 },
 {
  "id": "L408",
  "text": "하는 것이죠."
 },
 {
  "id": "L409",
  "text": "아침도 괜찮다면"
 },
 {
  "id": "L410",
  "text": "옮겨 볼 수 있겠지만"
 },
 {
  "id": "L411",
  "text": "잠을 줄여서까지"
 },
 {
  "id": "L412",
  "text": "새 시간을 만들 필요는 없습니다."
 },
 {
  "id": "L413",
  "text": "내 생활을 갖는다는 것이"
 },
 {
  "id": "L414",
  "text": "꼭 매일 퇴근 후 2시간을"
 },
 {
  "id": "L415",
  "text": "알차게 써야 한다는 뜻은"
 },
 {
  "id": "L416",
  "text": "아니니까요."
 },
 {
  "id": "L417",
  "text": "어떤 날은 짧게 하고"
 },
 {
  "id": "L418",
  "text": "어떤 날은 길게 하고"
 },
 {
  "id": "L419",
  "text": "어떤 날은 쉬면서"
 },
 {
  "id": "L420",
  "text": "이어 갈 수도 있습니다."
 },
 {
  "id": "L421",
  "text": "생각해 보면"
 },
 {
  "id": "L422",
  "text": "우리는 퇴근 뒤의 시간을"
 },
 {
  "id": "L423",
  "text": "꽤 쉽게 계산합니다."
 },
 {
  "id": "L424",
  "text": "9시까지 2시간이 남았으니"
 },
 {
  "id": "L425",
  "text": "운동도 하고"
 },
 {
  "id": "L426",
  "text": "책도 조금 읽을 수 있을 것 같습니다."
 },
 {
  "id": "L427",
  "text": "하지만 그 2시간을 살아갈 사람은"
 },
 {
  "id": "L428",
  "text": "하루를 이미 보내고 돌아온"
 },
 {
  "id": "L429",
  "text": "나입니다."
 },
 {
  "id": "L430",
  "text": "시간표에 빈칸이 있다는 이유만으로"
 },
 {
  "id": "L431",
  "text": "그 빈칸을 전부 채울 힘까지"
 },
 {
  "id": "L432",
  "text": "남아 있는 것은 아닙니다."
 },
 {
  "id": "L433",
  "text": "오늘 너무 피곤해서"
 },
 {
  "id": "L434",
  "text": "운동 가방을 내려놓았다고 해서"
 },
 {
  "id": "L435",
  "text": "하고 싶은 마음까지"
 },
 {
  "id": "L436",
  "text": "없었던 것은 아닐 겁니다."
 },
 {
  "id": "L437",
  "text": "내일도 똑같은 크기의 계획을"
 },
 {
  "id": "L438",
  "text": "건네기 전에"
 },
 {
  "id": "L439",
  "text": "오늘의 내가 어떤 상태였는지"
 },
 {
  "id": "L440",
  "text": "먼저 살펴봐 주세요."
 },
 {
  "id": "L441",
  "text": "어쩌면 필요한 것은"
 },
 {
  "id": "L442",
  "text": "더 단단한 결심보다"
 },
 {
  "id": "L443",
  "text": "조금 더 쉴 자리와"
 },
 {
  "id": "L444",
  "text": "조금 더 작은 시작인지도"
 },
 {
  "id": "L445",
  "text": "모르겠습니다."
 },
 {
  "id": "L446",
  "text": "여러분은 퇴근하고"
 },
 {
  "id": "L447",
  "text": "즐겨 하는 취미가 있나요?"
 },
 {
  "id": "L448",
  "text": "댓글로 공유해 주세요."
 }
]