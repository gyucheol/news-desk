[
 {
  "id": "L001",
  "from": "U001",
  "at": 0,
  "center": false,
  "text": "주말 내내 분명 푹 잤는데,",
  "spoken": "주말 내내 분명 푹 잤는데,"
 },
 {
  "id": "L002",
  "from": "U002",
  "at": 0,
  "center": false,
  "text": "월요일 아침 알람을 끄고",
  "spoken": "월요일 아침 알람을 끄고"
 },
 {
  "id": "L003",
  "from": "U003",
  "at": 0,
  "center": false,
  "text": "또 그대로 눕게 됩니다.",
  "spoken": "또 그대로 눕게 됩니다."
 },
 {
  "id": "L004",
  "from": "U004",
  "at": 0,
  "center": true,
  "text": "'이번 주말엔 진짜 아무것도 안 하고 쉬었는데,",
  "spoken": "'이번 주말엔 진짜 아무것도 안 하고 쉬었는데,"
 },
 {
  "id": "L005",
  "from": "U006",
  "at": 0,
  "center": true,
  "text": "왜 몸이 그대로지?'",
  "spoken": "왜 몸이 그대로지?'"
 },
 {
  "id": "L006",
  "from": "U007",
  "at": 0,
  "center": false,
  "text": "번아웃을 이겨 내 보려고",
  "spoken": "번아웃을 이겨 내 보려고"
 },
 {
  "id": "L007",
  "from": "U008",
  "at": 0,
  "center": false,
  "text": "나름대로 쉬어 봤는데도",
  "spoken": "나름대로 쉬어 봤는데도"
 },
 {
  "id": "L008",
  "from": "U009",
  "at": 0,
  "center": false,
  "text": "좀처럼 나아지질 않아서,",
  "spoken": "좀처럼 나아지질 않아서,"
 },
 {
  "id": "L009",
  "from": "U010",
  "at": 0,
  "center": false,
  "text": "혹시 '내가 그냥 게을러서 그런가'",
  "spoken": "혹시 '내가 그냥 게을러서 그런가'"
 },
 {
  "id": "L010",
  "from": "U010",
  "at": 13,
  "center": false,
  "text": "하고 자책하고 계셨나요?",
  "spoken": "하고 자책하고 계셨나요?"
 },
 {
  "id": "L011",
  "from": "U012",
  "at": 0,
  "center": false,
  "text": "그렇다면 오늘 이야기가",
  "spoken": "그렇다면 오늘 이야기가"
 },
 {
  "id": "L012",
  "from": "U012b",
  "at": 0,
  "center": false,
  "text": "그 질문의 답을 찾는 데",
  "spoken": "그 질문의 답을 찾는 데"
 },
 {
  "id": "L013",
  "from": "U013",
  "at": 0,
  "center": false,
  "text": "작은 힌트가 될지도 모르겠습니다.",
  "spoken": "작은 힌트가 될지도 모르겠습니다."
 },
 {
  "id": "L014",
  "from": "U014",
  "at": 0,
  "center": false,
  "text": "분명 쉬었는데도",
  "spoken": "분명 쉬었는데도"
 },
 {
  "id": "L015",
  "from": "U014",
  "at": 7,
  "center": false,
  "text": "피로가 왜 잘 풀리지 않는지,",
  "spoken": "피로가 왜 잘 풀리지 않는지,"
 },
 {
  "id": "L016",
  "from": "U016",
  "at": 0,
  "center": false,
  "text": "그리고 그게 왜",
  "spoken": "그리고 그게 왜"
 },
 {
  "id": "L017",
  "from": "U016",
  "at": 6,
  "center": false,
  "text": "내 게으름 탓이 아닐 수 있는지",
  "spoken": "내 게으름 탓이 아닐 수 있는지"
 },
 {
  "id": "L018",
  "from": "U017",
  "at": 6,
  "center": false,
  "text": "하나씩 차근차근 이야기해 볼게요.",
  "spoken": "하나씩 차근차근 이야기해 볼게요."
 },
 {
  "id": "L019",
  "from": "U019",
  "at": 0,
  "center": false,
  "text": "출근길에",
  "spoken": "출근길에"
 },
 {
  "id": "L020",
  "from": "U019",
  "at": 4,
  "center": false,
  "text": "업무 메일 알림이 하나 뜹니다.",
  "spoken": "업무 메일 알림이 하나 뜹니다."
 },
 {
  "id": "L021",
  "from": "U020",
  "at": 0,
  "center": false,
  "text": "아직 열어 보지도 않았는데",
  "spoken": "아직 열어 보지도 않았는데"
 },
 {
  "id": "L022",
  "from": "U021",
  "at": 0,
  "center": false,
  "text": "한숨부터 푹 나오죠.",
  "spoken": "한숨부터 푹 나오죠."
 },
 {
  "id": "L023",
  "from": "U022",
  "at": 0,
  "center": false,
  "text": "회사에서 동료가 말을 걸어와도",
  "spoken": "회사에서 동료가 말을 걸어와도"
 },
 {
  "id": "L024",
  "from": "U023",
  "at": 0,
  "center": false,
  "text": "맞장구칠 힘이 잘 나질 않습니다.",
  "spoken": "맞장구칠 힘이 잘 나질 않습니다."
 },
 {
  "id": "L025",
  "from": "U024",
  "at": 0,
  "center": false,
  "text": "퇴근길엔",
  "spoken": "퇴근길엔"
 },
 {
  "id": "L026",
  "from": "U024",
  "at": 4,
  "center": false,
  "text": "아침까지만 해도 가려고 했던 운동을",
  "spoken": "아침까지만 해도 가려고 했던 운동을"
 },
 {
  "id": "L027",
  "from": "U026",
  "at": 0,
  "center": false,
  "text": "슬그머니 접어요.",
  "spoken": "슬그머니 접어요."
 },
 {
  "id": "L028",
  "from": "U027",
  "at": 0,
  "center": true,
  "text": "'아, 오늘은 너무 피곤하니까 내일 하자.'",
  "spoken": "'아, 오늘은 너무 피곤하니까 내일 하자.'"
 },
 {
  "id": "L029",
  "from": "U029",
  "at": 0,
  "center": false,
  "text": "집에 와서는",
  "spoken": "집에 와서는"
 },
 {
  "id": "L030",
  "from": "U029",
  "at": 5,
  "center": false,
  "text": "아무 영상이나 틀어 놓고",
  "spoken": "아무 영상이나 틀어 놓고"
 },
 {
  "id": "L031",
  "from": "U030",
  "at": 0,
  "center": false,
  "text": "휴대폰 화면만 멍하니 들여다보는데,",
  "spoken": "휴대폰 화면만 멍하니 들여다보는데,"
 },
 {
  "id": "L032",
  "from": "U031",
  "at": 0,
  "center": false,
  "text": "한참을 보고 나서도",
  "spoken": "한참을 보고 나서도"
 },
 {
  "id": "L033",
  "from": "U032",
  "at": 0,
  "center": false,
  "text": "방금 뭘 봤는지",
  "spoken": "방금 뭘 봤는지"
 },
 {
  "id": "L034",
  "from": "U032",
  "at": 6,
  "center": false,
  "text": "기억이 잘 안 납니다.",
  "spoken": "기억이 잘 안 납니다."
 },
 {
  "id": "L035",
  "from": "U033",
  "at": 0,
  "center": false,
  "text": "그렇게 겨우 금요일이 오면,",
  "spoken": "그렇게 겨우 금요일이 오면,"
 },
 {
  "id": "L036",
  "from": "U034",
  "at": 0,
  "center": false,
  "text": "'그래도 이번 주말엔 푹 쉬면 괜찮아지겠지'",
  "spoken": "'그래도 이번 주말엔 푹 쉬면 괜찮아지겠지'"
 },
 {
  "id": "L037",
  "from": "U035",
  "at": 6,
  "center": false,
  "text": "하고 기대하게 되죠.",
  "spoken": "하고 기대하게 되죠."
 },
 {
  "id": "L038",
  "from": "U036",
  "at": 0,
  "center": false,
  "text": "토요일엔 늦잠을 자고,",
  "spoken": "토요일엔 늦잠을 자고,"
 },
 {
  "id": "L039",
  "from": "U037",
  "at": 0,
  "center": false,
  "text": "일요일엔",
  "spoken": "일요일엔"
 },
 {
  "id": "L040",
  "from": "U037",
  "at": 4,
  "center": false,
  "text": "하루 종일 누워만 있었습니다.",
  "spoken": "하루 종일 누워만 있었습니다."
 },
 {
  "id": "L041",
  "from": "U038",
  "at": 0,
  "center": false,
  "text": "정말 아무것도 안 하고",
  "spoken": "정말 아무것도 안 하고"
 },
 {
  "id": "L042",
  "from": "U038",
  "at": 9,
  "center": false,
  "text": "쉬기만 했어요.",
  "spoken": "쉬기만 했어요."
 },
 {
  "id": "L043",
  "from": "U039",
  "at": 0,
  "center": true,
  "text": "그런데 참 이상하죠.",
  "spoken": "그런데 참 이상하죠."
 },
 {
  "id": "L044",
  "from": "U040",
  "at": 0,
  "center": false,
  "text": "일요일 저녁만 되면",
  "spoken": "일요일 저녁만 되면"
 },
 {
  "id": "L045",
  "from": "U040",
  "at": 8,
  "center": false,
  "text": "마음이 다시 쿵 무거워집니다.",
  "spoken": "마음이 다시 쿵 무거워집니다."
 },
 {
  "id": "L046",
  "from": "U042",
  "at": 0,
  "center": true,
  "text": "'아, 내일 또 출근이네.'",
  "spoken": "'아, 내일 또 출근이네.'"
 },
 {
  "id": "L047",
  "from": "U043",
  "at": 0,
  "center": false,
  "text": "혹시 여러분도",
  "spoken": "혹시 여러분도"
 },
 {
  "id": "L048",
  "from": "U043",
  "at": 6,
  "center": false,
  "text": "일요일 저녁 여섯 시쯤만 되면",
  "spoken": "일요일 저녁 여섯 시쯤만 되면"
 },
 {
  "id": "L049",
  "from": "U045",
  "at": 0,
  "center": false,
  "text": "이런 기분이",
  "spoken": "이런 기분이"
 },
 {
  "id": "L050",
  "from": "U045",
  "at": 5,
  "center": false,
  "text": "슬슬 올라오지 않으시나요?",
  "spoken": "슬슬 올라오지 않으시나요?"
 },
 {
  "id": "L051",
  "from": "U046",
  "at": 0,
  "center": true,
  "text": "바로 이런 상태를 부르는 이름이",
  "spoken": "바로 이런 상태를 부르는 이름이"
 },
 {
  "id": "L052",
  "from": "U047",
  "at": 0,
  "center": true,
  "text": "우리가 잘 아는 '[번아웃]'입니다.",
  "spoken": "우리가 잘 아는 '[번아웃]'입니다."
 },
 {
  "id": "L053",
  "from": "U048",
  "at": 0,
  "center": false,
  "text": "심리학에서 이 말을 처음 쓴 사람은",
  "spoken": "심리학에서 이 말을 처음 쓴 사람은"
 },
 {
  "id": "L054",
  "from": "U049",
  "at": 0,
  "center": false,
  "text": "미국의 심리학자, 허버트 프로이덴버거인데요.",
  "spoken": "미국의 심리학자, 허버트 프로이덴버거인데요."
 },
 {
  "id": "L055",
  "from": "U051",
  "at": 0,
  "center": false,
  "text": "천구백칠십 년대 뉴욕에서 일하던 그는",
  "spoken": "천구백칠십 년대 뉴욕에서 일하던 그는"
 },
 {
  "id": "L056",
  "from": "U052",
  "at": 0,
  "center": false,
  "text": "누구보다",
  "spoken": "누구보다"
 },
 {
  "id": "L057",
  "from": "U052",
  "at": 4,
  "center": false,
  "text": "열정과 사명감이 넘치는 사람이었습니다.",
  "spoken": "열정과 사명감이 넘치는 사람이었습니다."
 },
 {
  "id": "L058",
  "from": "U054",
  "at": 0,
  "center": false,
  "text": "낮에는",
  "spoken": "낮에는"
 },
 {
  "id": "L059",
  "from": "U054",
  "at": 3,
  "center": false,
  "text": "자기 상담실에서",
  "spoken": "자기 상담실에서"
 },
 {
  "id": "L060",
  "from": "U055",
  "at": 0,
  "center": false,
  "text": "열두 시간 동안 환자들을 돌보고,",
  "spoken": "열두 시간 동안 환자들을 돌보고,"
 },
 {
  "id": "L061",
  "from": "U056",
  "at": 0,
  "center": false,
  "text": "밤이 되면",
  "spoken": "밤이 되면"
 },
 {
  "id": "L062",
  "from": "U056",
  "at": 4,
  "center": false,
  "text": "형편이 어려운 사람들을 돕겠다며",
  "spoken": "형편이 어려운 사람들을 돕겠다며"
 },
 {
  "id": "L063",
  "from": "U057",
  "at": 0,
  "center": false,
  "text": "무료 진료소로 건너가",
  "spoken": "무료 진료소로 건너가"
 },
 {
  "id": "L064",
  "from": "U058",
  "at": 0,
  "center": false,
  "text": "새벽 두 시까지 일하곤 했죠.",
  "spoken": "새벽 두 시까지 일하곤 했죠."
 },
 {
  "id": "L065",
  "from": "U059",
  "at": 0,
  "center": false,
  "text": "몸이 부서져라 일하면서도",
  "spoken": "몸이 부서져라 일하면서도"
 },
 {
  "id": "L066",
  "from": "U060",
  "at": 0,
  "center": false,
  "text": "본인은 괜찮다고 생각했습니다.",
  "spoken": "본인은 괜찮다고 생각했습니다."
 },
 {
  "id": "L067",
  "from": "U061",
  "at": 0,
  "center": false,
  "text": "그러다 사단이 난 건,",
  "spoken": "그러다 사단이 난 건,"
 },
 {
  "id": "L068",
  "from": "U062",
  "at": 0,
  "center": false,
  "text": "모처럼 가족들과",
  "spoken": "모처럼 가족들과"
 },
 {
  "id": "L069",
  "from": "U062",
  "at": 7,
  "center": false,
  "text": "크리스마스 여행을 떠나기로 한 아침이었어요.",
  "spoken": "크리스마스 여행을 떠나기로 한 아침이었어요."
 },
 {
  "id": "L070",
  "from": "U064",
  "at": 0,
  "center": false,
  "text": "일에서 손을 놓고 긴장이 풀리자마자,",
  "spoken": "일에서 손을 놓고 긴장이 풀리자마자,"
 },
 {
  "id": "L071",
  "from": "U065",
  "at": 0,
  "center": false,
  "text": "그동안 쌓였던 피로가",
  "spoken": "그동안 쌓였던 피로가"
 },
 {
  "id": "L072",
  "from": "U066",
  "at": 0,
  "center": false,
  "text": "한꺼번에 덮친 겁니다.",
  "spoken": "한꺼번에 덮친 겁니다."
 },
 {
  "id": "L073",
  "from": "U067",
  "at": 0,
  "center": false,
  "text": "그는 그날 아침 침대에서",
  "spoken": "그는 그날 아침 침대에서"
 },
 {
  "id": "L074",
  "from": "U068",
  "at": 0,
  "center": false,
  "text": "손가락 하나 까딱하지 못했고,",
  "spoken": "손가락 하나 까딱하지 못했고,"
 },
 {
  "id": "L075",
  "from": "U069",
  "at": 0,
  "center": false,
  "text": "결국 약속했던 여행을 가지 못한 채",
  "spoken": "결국 약속했던 여행을 가지 못한 채"
 },
 {
  "id": "L076",
  "from": "U070",
  "at": 0,
  "center": false,
  "text": "며칠 내내 앓아누웠습니다.",
  "spoken": "며칠 내내 앓아누웠습니다."
 },
 {
  "id": "L077",
  "from": "U071",
  "at": 0,
  "center": false,
  "text": "충격을 받은 그는",
  "spoken": "충격을 받은 그는"
 },
 {
  "id": "L078",
  "from": "U072",
  "at": 0,
  "center": false,
  "text": "자신이 왜 이렇게 무너졌는지",
  "spoken": "자신이 왜 이렇게 무너졌는지"
 },
 {
  "id": "L079",
  "from": "U073",
  "at": 0,
  "center": false,
  "text": "알아내기 위해 녹음기를 켰습니다.",
  "spoken": "알아내기 위해 녹음기를 켰습니다."
 },
 {
  "id": "L080",
  "from": "U074",
  "at": 0,
  "center": false,
  "text": "매일 한두 시간씩",
  "spoken": "매일 한두 시간씩"
 },
 {
  "id": "L081",
  "from": "U075",
  "at": 0,
  "center": false,
  "text": "지금 자기가 느끼는 피로감과 짜증, 공허함을",
  "spoken": "지금 자기가 느끼는 피로감과 짜증, 공허함을"
 },
 {
  "id": "L082",
  "from": "U076",
  "at": 4,
  "center": false,
  "text": "있는 그대로 녹음한 뒤",
  "spoken": "있는 그대로 녹음한 뒤"
 },
 {
  "id": "L083",
  "from": "U077",
  "at": 0,
  "center": false,
  "text": "다시 돌려 들어 본 거예요.",
  "spoken": "다시 돌려 들어 본 거예요."
 },
 {
  "id": "L084",
  "from": "U078",
  "at": 0,
  "center": false,
  "text": "거기엔",
  "spoken": "거기엔"
 },
 {
  "id": "L085",
  "from": "U078",
  "at": 3,
  "center": false,
  "text": "평소 따뜻하던 자신의 모습 대신,",
  "spoken": "평소 따뜻하던 자신의 모습 대신,"
 },
 {
  "id": "L086",
  "from": "U079",
  "at": 0,
  "center": false,
  "text": "완전히 지쳐서 날이 서 있는 낯선 목소리가",
  "spoken": "완전히 지쳐서 날이 서 있는 낯선 목소리가"
 },
 {
  "id": "L087",
  "from": "U080",
  "at": 6,
  "center": false,
  "text": "담겨 있었습니다.",
  "spoken": "담겨 있었습니다."
 },
 {
  "id": "L088",
  "from": "U081",
  "at": 0,
  "center": false,
  "text": "그는 진료소에서 함께 일하던 동료들을",
  "spoken": "그는 진료소에서 함께 일하던 동료들을"
 },
 {
  "id": "L089",
  "from": "U082",
  "at": 4,
  "center": false,
  "text": "떠올렸어요.",
  "spoken": "떠올렸어요."
 },
 {
  "id": "L090",
  "from": "U083",
  "at": 0,
  "center": false,
  "text": "가만히 돌아보니,",
  "spoken": "가만히 돌아보니,"
 },
 {
  "id": "L091",
  "from": "U084",
  "at": 0,
  "center": false,
  "text": "처음에 가장 뜨겁게 헌신하던 동료들일수록",
  "spoken": "처음에 가장 뜨겁게 헌신하던 동료들일수록"
 },
 {
  "id": "L092",
  "from": "U085",
  "at": 6,
  "center": false,
  "text": "가장 먼저 지치고, 예민해지고,",
  "spoken": "가장 먼저 지치고, 예민해지고,"
 },
 {
  "id": "L093",
  "from": "U087",
  "at": 0,
  "center": false,
  "text": "결국엔",
  "spoken": "결국엔"
 },
 {
  "id": "L094",
  "from": "U087",
  "at": 3,
  "center": false,
  "text": "차갑고 냉소적으로 변해 가고 있었던 겁니다.",
  "spoken": "차갑고 냉소적으로 변해 가고 있었던 겁니다."
 },
 {
  "id": "L095",
  "from": "U089",
  "at": 0,
  "center": false,
  "text": "마치 연료를 끝까지 다 태워버리고",
  "spoken": "마치 연료를 끝까지 다 태워버리고"
 },
 {
  "id": "L096",
  "from": "U090",
  "at": 0,
  "center": false,
  "text": "잿더미만 남은 것처럼요.",
  "spoken": "잿더미만 남은 것처럼요."
 },
 {
  "id": "L097",
  "from": "U091",
  "at": 0,
  "center": false,
  "text": "그는 천구백칠십사 년 논문에서,",
  "spoken": "그는 천구백칠십사 년 논문에서,"
 },
 {
  "id": "L098",
  "from": "U092",
  "at": 0,
  "center": false,
  "text": "이렇게 열정을 다 태우고",
  "spoken": "이렇게 열정을 다 태우고"
 },
 {
  "id": "L099",
  "from": "U093",
  "at": 0,
  "center": false,
  "text": "텅 비어버린 상태를",
  "spoken": "텅 비어버린 상태를"
 },
 {
  "id": "L100",
  "from": "U094",
  "at": 0,
  "center": false,
  "text": "처음으로 '[번아웃]'이라고 불렀습니다.",
  "spoken": "처음으로 '[번아웃]'이라고 불렀습니다."
 },
 {
  "id": "L101",
  "from": "U095",
  "at": 0,
  "center": true,
  "text": "여기서 우리가 꼭 눈여겨봐야 할 점이 있어요.",
  "spoken": "여기서 우리가 꼭 눈여겨봐야 할 점이 있어요."
 },
 {
  "id": "L102",
  "from": "U097",
  "at": 0,
  "center": false,
  "text": "번아웃이라는 말을 만든 사람도,",
  "spoken": "번아웃이라는 말을 만든 사람도,"
 },
 {
  "id": "L103",
  "from": "U098",
  "at": 0,
  "center": false,
  "text": "그가 지켜본 동료들도",
  "spoken": "그가 지켜본 동료들도"
 },
 {
  "id": "L104",
  "from": "U099",
  "at": 0,
  "center": false,
  "text": "결코 게으른 사람들이 아니었다는 겁니다.",
  "spoken": "결코 게으른 사람들이 아니었다는 겁니다."
 },
 {
  "id": "L105",
  "from": "U100",
  "at": 0,
  "center": false,
  "text": "오히려 누구보다 책임감이 강하고,",
  "spoken": "오히려 누구보다 책임감이 강하고,"
 },
 {
  "id": "L106",
  "from": "U101",
  "at": 0,
  "center": false,
  "text": "가장 열심히 애쓰던 사람들이",
  "spoken": "가장 열심히 애쓰던 사람들이"
 },
 {
  "id": "L107",
  "from": "U102",
  "at": 0,
  "center": false,
  "text": "제일 먼저 번아웃에 빠졌다는 거죠.",
  "spoken": "제일 먼저 번아웃에 빠졌다는 거죠."
 },
 {
  "id": "L108",
  "from": "U103",
  "at": 0,
  "center": false,
  "text": "그로부터 한참 뒤인 이천십구 년,",
  "spoken": "그로부터 한참 뒤인 이천십구 년,"
 },
 {
  "id": "L109",
  "from": "U104",
  "at": 0,
  "center": false,
  "text": "세계보건기구는 번아웃을",
  "spoken": "세계보건기구는 번아웃을"
 },
 {
  "id": "L110",
  "from": "U105",
  "at": 0,
  "center": true,
  "text": "'제대로 관리되지 않은\n만성적인 [직장 스트레스]에서 생기는 증후군'",
  "spoken": "'제대로 관리되지 않은 만성적인 [직장 스트레스]에서 생기는 증후군'"
 },
 {
  "id": "L111",
  "from": "U107",
  "at": 0,
  "center": true,
  "text": "이라고 정의했습니다.",
  "spoken": "이라고 정의했습니다."
 },
 {
  "id": "L112",
  "from": "U108",
  "at": 0,
  "center": false,
  "text": "쉽게 말해,",
  "spoken": "쉽게 말해,"
 },
 {
  "id": "L113",
  "from": "U108",
  "at": 4,
  "center": false,
  "text": "일 때문에 쌓인 스트레스가",
  "spoken": "일 때문에 쌓인 스트레스가"
 },
 {
  "id": "L114",
  "from": "U109",
  "at": 0,
  "center": false,
  "text": "오랫동안 풀리지 못해서",
  "spoken": "오랫동안 풀리지 못해서"
 },
 {
  "id": "L115",
  "from": "U110",
  "at": 0,
  "center": false,
  "text": "생긴 상태라는 거예요.",
  "spoken": "생긴 상태라는 거예요."
 },
 {
  "id": "L116",
  "from": "U111",
  "at": 0,
  "center": true,
  "text": "흥미로운 건,",
  "spoken": "흥미로운 건,"
 },
 {
  "id": "L117",
  "from": "U112",
  "at": 0,
  "center": true,
  "text": "세계보건기구가",
  "spoken": "세계보건기구가"
 },
 {
  "id": "L118",
  "from": "U112",
  "at": 7,
  "center": true,
  "text": "번아웃을 개인의 [질병]으로\n분류하지 않았다는 점입니다.",
  "spoken": "번아웃을 개인의 [질병]으로 분류하지 않았다는 점입니다."
 },
 {
  "id": "L119",
  "from": "U115",
  "at": 0,
  "center": false,
  "text": "대신 일과 관련된 현상으로 분류했고,",
  "spoken": "대신 일과 관련된 현상으로 분류했고,"
 },
 {
  "id": "L120",
  "from": "U116",
  "at": 0,
  "center": false,
  "text": "[직장]이라는 맥락에서만 쓰는 말이라고",
  "spoken": "[직장]이라는 맥락에서만 쓰는 말이라고"
 },
 {
  "id": "L121",
  "from": "U117",
  "at": 0,
  "center": false,
  "text": "분명히 선을 그어 두었죠.",
  "spoken": "분명히 선을 그어 두었죠."
 },
 {
  "id": "L122",
  "from": "U118",
  "at": 0,
  "center": false,
  "text": "저는 이 번아웃을",
  "spoken": "저는 이 번아웃을"
 },
 {
  "id": "L123",
  "from": "U118",
  "at": 7,
  "center": false,
  "text": "휴대폰에 한 번 비유해 보고 싶습니다.",
  "spoken": "휴대폰에 한 번 비유해 보고 싶습니다."
 },
 {
  "id": "L124",
  "from": "U120",
  "at": 0,
  "center": false,
  "text": "충전하는 속도보다",
  "spoken": "충전하는 속도보다"
 },
 {
  "id": "L125",
  "from": "U121",
  "at": 0,
  "center": false,
  "text": "[배터리]가 닳는 속도가 더 빠른 휴대폰 말이에요.",
  "spoken": "[배터리]가 닳는 속도가 더 빠른 휴대폰 말이에요."
 },
 {
  "id": "L126",
  "from": "U123",
  "at": 0,
  "center": false,
  "text": "이런 휴대폰은",
  "spoken": "이런 휴대폰은"
 },
 {
  "id": "L127",
  "from": "U124",
  "at": 0,
  "center": false,
  "text": "하룻밤 충전기를 꽂아 둔다고 해서",
  "spoken": "하룻밤 충전기를 꽂아 둔다고 해서"
 },
 {
  "id": "L128",
  "from": "U125",
  "at": 0,
  "center": false,
  "text": "문제가 해결되지 않습니다.",
  "spoken": "문제가 해결되지 않습니다."
 },
 {
  "id": "L129",
  "from": "U126",
  "at": 0,
  "center": false,
  "text": "보이지 않는 곳에서 배터리를 빼 가는 [무언가]가",
  "spoken": "보이지 않는 곳에서 배터리를 빼 가는 [무언가]가"
 },
 {
  "id": "L130",
  "from": "U127",
  "at": 4,
  "center": false,
  "text": "여전히 켜져 있으니까요.",
  "spoken": "여전히 켜져 있으니까요."
 },
 {
  "id": "L131",
  "from": "U128",
  "at": 0,
  "center": true,
  "text": "세계보건기구는 번아웃의 특징을\n크게 [세 가지]로 설명합니다.",
  "spoken": "세계보건기구는 번아웃의 특징을 크게 [세 가지]로 설명합니다."
 },
 {
  "id": "L132",
  "from": "U130",
  "at": 0,
  "center": true,
  "text": "먼저 번아웃의 첫 번째 신호는",
  "spoken": "먼저 번아웃의 첫 번째 신호는"
 },
 {
  "id": "L133",
  "from": "U131",
  "at": 0,
  "center": true,
  "text": "[에너지]가 바닥나는 겁니다.",
  "spoken": "[에너지]가 바닥나는 겁니다."
 },
 {
  "id": "L134",
  "from": "U132",
  "at": 0,
  "center": false,
  "text": "토요일에 열 시간을 자고",
  "spoken": "토요일에 열 시간을 자고"
 },
 {
  "id": "L135",
  "from": "U133",
  "at": 0,
  "center": false,
  "text": "일요일엔 낮잠까지 잤는데도,",
  "spoken": "일요일엔 낮잠까지 잤는데도,"
 },
 {
  "id": "L136",
  "from": "U134",
  "at": 0,
  "center": false,
  "text": "월요일 아침이면",
  "spoken": "월요일 아침이면"
 },
 {
  "id": "L137",
  "from": "U134",
  "at": 7,
  "center": false,
  "text": "몸이 여전히 무겁습니다.",
  "spoken": "몸이 여전히 무겁습니다."
 },
 {
  "id": "L138",
  "from": "U135",
  "at": 0,
  "center": false,
  "text": "'이 정도 쉬었으면 괜찮아야 하는데'",
  "spoken": "'이 정도 쉬었으면 괜찮아야 하는데'"
 },
 {
  "id": "L139",
  "from": "U136",
  "at": 7,
  "center": false,
  "text": "싶다가도, 어느새 자책이 따라오죠.",
  "spoken": "싶다가도, 어느새 자책이 따라오죠."
 },
 {
  "id": "L140",
  "from": "U138",
  "at": 0,
  "center": false,
  "text": "'남들은 주말에 운동도 하고 공부도 한다는데,",
  "spoken": "'남들은 주말에 운동도 하고 공부도 한다는데,"
 },
 {
  "id": "L141",
  "from": "U140",
  "at": 0,
  "center": false,
  "text": "나는 왜 누워만 있지?'",
  "spoken": "나는 왜 누워만 있지?'"
 },
 {
  "id": "L142",
  "from": "U141",
  "at": 0,
  "center": false,
  "text": "보통의 피로는 푹 쉬고 나면",
  "spoken": "보통의 피로는 푹 쉬고 나면"
 },
 {
  "id": "L143",
  "from": "U142",
  "at": 0,
  "center": false,
  "text": "어느 정도 풀리지만,",
  "spoken": "어느 정도 풀리지만,"
 },
 {
  "id": "L144",
  "from": "U143",
  "at": 0,
  "center": false,
  "text": "번아웃의 피로는 아무리 쉬어도",
  "spoken": "번아웃의 피로는 아무리 쉬어도"
 },
 {
  "id": "L145",
  "from": "U144",
  "at": 0,
  "center": false,
  "text": "잘 채워지지 않는다고",
  "spoken": "잘 채워지지 않는다고"
 },
 {
  "id": "L146",
  "from": "U145",
  "at": 0,
  "center": false,
  "text": "느끼는 경우가 많습니다.",
  "spoken": "느끼는 경우가 많습니다."
 },
 {
  "id": "L147",
  "from": "U146",
  "at": 0,
  "center": true,
  "text": "그럼 게으름과는 뭐가 다를까요?",
  "spoken": "그럼 게으름과는 뭐가 다를까요?"
 },
 {
  "id": "L148",
  "from": "U147",
  "at": 0,
  "center": false,
  "text": "게으름이 '하기 싫은 마음'에 가깝다면,",
  "spoken": "게으름이 '하기 싫은 마음'에 가깝다면,"
 },
 {
  "id": "L149",
  "from": "U148",
  "at": 0,
  "center": false,
  "text": "번아웃은",
  "spoken": "번아웃은"
 },
 {
  "id": "L150",
  "from": "U148",
  "at": 4,
  "center": false,
  "text": "'하고 싶어도 [꺼내 쓸 힘]이 남아 있지 않은 상태'에",
  "spoken": "'하고 싶어도 [꺼내 쓸 힘]이 남아 있지 않은 상태'에"
 },
 {
  "id": "L151",
  "from": "U150",
  "at": 0,
  "center": false,
  "text": "가깝습니다.",
  "spoken": "가깝습니다."
 },
 {
  "id": "L152",
  "from": "U151",
  "at": 0,
  "center": false,
  "text": "그러니까 이건 마음가짐의 문제가 아니라,",
  "spoken": "그러니까 이건 마음가짐의 문제가 아니라,"
 },
 {
  "id": "L153",
  "from": "U152",
  "at": 0,
  "center": false,
  "text": "바닥난 [연료]의 문제인 거죠.",
  "spoken": "바닥난 [연료]의 문제인 거죠."
 },
 {
  "id": "L154",
  "from": "U153",
  "at": 0,
  "center": true,
  "text": "번아웃의 두 번째 신호는",
  "spoken": "번아웃의 두 번째 신호는"
 },
 {
  "id": "L155",
  "from": "U154",
  "at": 0,
  "center": true,
  "text": "일과 내 마음 사이의 [거리]가\n점점 멀어지는 겁니다.",
  "spoken": "일과 내 마음 사이의 [거리]가 점점 멀어지는 겁니다."
 },
 {
  "id": "L156",
  "from": "U156",
  "at": 0,
  "center": false,
  "text": "회의에서 새로운 의견이 나오면,",
  "spoken": "회의에서 새로운 의견이 나오면,"
 },
 {
  "id": "L157",
  "from": "U157",
  "at": 0,
  "center": false,
  "text": "예전 같았으면 같이 고민했을 텐데",
  "spoken": "예전 같았으면 같이 고민했을 텐데"
 },
 {
  "id": "L158",
  "from": "U158",
  "at": 0,
  "center": false,
  "text": "요즘은",
  "spoken": "요즘은"
 },
 {
  "id": "L159",
  "from": "U158",
  "at": 3,
  "center": false,
  "text": "'어차피 해도 안 바뀌어'라는 생각부터 듭니다.",
  "spoken": "'어차피 해도 안 바뀌어'라는 생각부터 듭니다."
 },
 {
  "id": "L160",
  "from": "U160",
  "at": 0,
  "center": false,
  "text": "메신저에 팀장님 이름만 떠도",
  "spoken": "메신저에 팀장님 이름만 떠도"
 },
 {
  "id": "L161",
  "from": "U161",
  "at": 0,
  "center": false,
  "text": "가슴이 답답해지고,",
  "spoken": "가슴이 답답해지고,"
 },
 {
  "id": "L162",
  "from": "U162",
  "at": 0,
  "center": false,
  "text": "점심은 그냥 혼자 먹고 싶어지죠.",
  "spoken": "점심은 그냥 혼자 먹고 싶어지죠."
 },
 {
  "id": "L163",
  "from": "U165",
  "at": 0,
  "center": true,
  "text": "세계보건기구는 이런 모습을",
  "spoken": "세계보건기구는 이런 모습을"
 },
 {
  "id": "L164",
  "from": "U166",
  "at": 0,
  "center": true,
  "text": "일에 대한 '[심리적 거리감]',\n혹은 '[냉소]'라고 설명합니다.",
  "spoken": "일에 대한 '[심리적 거리감]', 혹은 '[냉소]'라고 설명합니다."
 },
 {
  "id": "L165",
  "from": "U168",
  "at": 0,
  "center": false,
  "text": "이게 게으름과 다른 건,",
  "spoken": "이게 게으름과 다른 건,"
 },
 {
  "id": "L166",
  "from": "U169",
  "at": 0,
  "center": false,
  "text": "처음부터",
  "spoken": "처음부터"
 },
 {
  "id": "L167",
  "from": "U169",
  "at": 4,
  "center": false,
  "text": "일에 관심이 없었던 게 아니라는 점이에요.",
  "spoken": "일에 관심이 없었던 게 아니라는 점이에요."
 },
 {
  "id": "L168",
  "from": "U171",
  "at": 0,
  "center": false,
  "text": "너무 오랫동안 애쓰다 보니,",
  "spoken": "너무 오랫동안 애쓰다 보니,"
 },
 {
  "id": "L169",
  "from": "U172",
  "at": 0,
  "center": false,
  "text": "지친 마음이 상처받지 않으려고",
  "spoken": "지친 마음이 상처받지 않으려고"
 },
 {
  "id": "L170",
  "from": "U173",
  "at": 0,
  "center": false,
  "text": "스스로 한 발 물러나 버린 쪽에 가깝습니다.",
  "spoken": "스스로 한 발 물러나 버린 쪽에 가깝습니다."
 },
 {
  "id": "L171",
  "from": "U175",
  "at": 0,
  "center": false,
  "text": "원래 무관심했던 게 아니라,",
  "spoken": "원래 무관심했던 게 아니라,"
 },
 {
  "id": "L172",
  "from": "U176",
  "at": 0,
  "center": false,
  "text": "지친 마음이 스스로 [거리]를 두는 거죠.",
  "spoken": "지친 마음이 스스로 [거리]를 두는 거죠."
 },
 {
  "id": "L173",
  "from": "U177",
  "at": 0,
  "center": true,
  "text": "번아웃의 세 번째 신호는",
  "spoken": "번아웃의 세 번째 신호는"
 },
 {
  "id": "L174",
  "from": "U178",
  "at": 0,
  "center": true,
  "text": "내가 일을 잘 해내고 있다는 [느낌]이\n부쩍 줄어드는 겁니다.",
  "spoken": "내가 일을 잘 해내고 있다는 [느낌]이 부쩍 줄어드는 겁니다."
 },
 {
  "id": "L175",
  "from": "U180",
  "at": 0,
  "center": false,
  "text": "분명 작년엔 칭찬까지 받았던 보고서인데,",
  "spoken": "분명 작년엔 칭찬까지 받았던 보고서인데,"
 },
 {
  "id": "L176",
  "from": "U181",
  "at": 0,
  "center": false,
  "text": "올해는 쓰는 내내 자신이 없어요.",
  "spoken": "올해는 쓰는 내내 자신이 없어요."
 },
 {
  "id": "L177",
  "from": "U182",
  "at": 0,
  "center": false,
  "text": "빈 파일을 열어 놓고",
  "spoken": "빈 파일을 열어 놓고"
 },
 {
  "id": "L178",
  "from": "U183",
  "at": 0,
  "center": false,
  "text": "한 시간째 첫 문장만 고치고 있죠.",
  "spoken": "한 시간째 첫 문장만 고치고 있죠."
 },
 {
  "id": "L179",
  "from": "U184",
  "at": 0,
  "center": true,
  "text": "'나 원래 이 일 잘하던 사람 맞나?'",
  "spoken": "'나 원래 이 일 잘하던 사람 맞나?'"
 },
 {
  "id": "L180",
  "from": "U185",
  "at": 0,
  "center": false,
  "text": "싶고, 작은 실수 하나에도",
  "spoken": "싶고, 작은 실수 하나에도"
 },
 {
  "id": "L181",
  "from": "U186",
  "at": 0,
  "center": false,
  "text": "내가 무능한 사람처럼 느껴집니다.",
  "spoken": "내가 무능한 사람처럼 느껴집니다."
 },
 {
  "id": "L182",
  "from": "U187",
  "at": 0,
  "center": true,
  "text": "세계보건기구는",
  "spoken": "세계보건기구는"
 },
 {
  "id": "L183",
  "from": "U187",
  "at": 7,
  "center": true,
  "text": "이걸 '[직업적 효능감]',",
  "spoken": "이걸 '[직업적 효능감]', (그러니까)"
 },
 {
  "id": "L184",
  "from": "U188",
  "at": 4,
  "center": true,
  "text": "내가 해낼 수 있다는 믿음이\n줄어드는 거라고 표현합니다.",
  "spoken": "내가 해낼 수 있다는 믿음이 줄어드는 거라고 표현합니다."
 },
 {
  "id": "L185",
  "from": "U190",
  "at": 0,
  "center": false,
  "text": "그런데 이것도",
  "spoken": "그런데 이것도"
 },
 {
  "id": "L186",
  "from": "U190",
  "at": 6,
  "center": false,
  "text": "내 능력이 없어서 생기는 일이 아니에요.",
  "spoken": "내 능력이 없어서 생기는 일이 아니에요."
 },
 {
  "id": "L187",
  "from": "U192",
  "at": 0,
  "center": false,
  "text": "오히려 잘하고 싶은 마음이",
  "spoken": "오히려 잘하고 싶은 마음이"
 },
 {
  "id": "L188",
  "from": "U193",
  "at": 0,
  "center": false,
  "text": "아직 남아 있으니까 더 괴로운 겁니다.",
  "spoken": "아직 남아 있으니까 더 괴로운 겁니다."
 },
 {
  "id": "L189",
  "from": "U194",
  "at": 0,
  "center": false,
  "text": "내 능력이 사라진 게 아니라,",
  "spoken": "내 능력이 사라진 게 아니라,"
 },
 {
  "id": "L190",
  "from": "U195",
  "at": 0,
  "center": false,
  "text": "내 능력을 느끼고 발휘할 [힘]이",
  "spoken": "내 능력을 느끼고 발휘할 [힘]이"
 },
 {
  "id": "L191",
  "from": "U196",
  "at": 0,
  "center": false,
  "text": "줄어든 거예요.",
  "spoken": "줄어든 거예요."
 },
 {
  "id": "L192",
  "from": "U197",
  "at": 0,
  "center": true,
  "text": "그렇다면 번아웃은 푹 쉬면 나아질까요?",
  "spoken": "그렇다면 번아웃은 푹 쉬면 나아질까요?"
 },
 {
  "id": "L193",
  "from": "U198",
  "at": 0,
  "center": false,
  "text": "흔히들 그렇게 생각하지만,",
  "spoken": "흔히들 그렇게 생각하지만,"
 },
 {
  "id": "L194",
  "from": "U199",
  "at": 0,
  "center": false,
  "text": "휴가에 관한 연구들은",
  "spoken": "휴가에 관한 연구들은"
 },
 {
  "id": "L195",
  "from": "U200",
  "at": 0,
  "center": false,
  "text": "조금 다른 이야기를 들려줍니다.",
  "spoken": "조금 다른 이야기를 들려줍니다."
 },
 {
  "id": "L196",
  "from": "U201",
  "at": 0,
  "center": false,
  "text": "이천구 년, 한 연구진이",
  "spoken": "이천구 년, 한 연구진이"
 },
 {
  "id": "L197",
  "from": "U202",
  "at": 0,
  "center": false,
  "text": "휴가의 효과를 다룬 연구 [일곱 편]을",
  "spoken": "휴가의 효과를 다룬 연구 [일곱 편]을"
 },
 {
  "id": "L198",
  "from": "U203",
  "at": 0,
  "center": false,
  "text": "모아서 분석했는데요.",
  "spoken": "모아서 분석했는데요."
 },
 {
  "id": "L199",
  "from": "U204",
  "at": 0,
  "center": false,
  "text": "휴가는 분명 건강과 행복감을 높여 줬지만,",
  "spoken": "휴가는 분명 건강과 행복감을 높여 줬지만,"
 },
 {
  "id": "L200",
  "from": "U205",
  "at": 0,
  "center": false,
  "text": "일터로 돌아가자마자",
  "spoken": "일터로 돌아가자마자"
 },
 {
  "id": "L201",
  "from": "U206",
  "at": 0,
  "center": false,
  "text": "그 효과는 금방 [사라졌습니다].",
  "spoken": "그 효과는 금방 [사라졌습니다]."
 },
 {
  "id": "L202",
  "from": "U207",
  "at": 0,
  "center": false,
  "text": "같은 연구진이 더 많은 연구를",
  "spoken": "같은 연구진이 더 많은 연구를"
 },
 {
  "id": "L203",
  "from": "U208",
  "at": 0,
  "center": false,
  "text": "모아 다시 분석했을 때도",
  "spoken": "모아 다시 분석했을 때도"
 },
 {
  "id": "L204",
  "from": "U209",
  "at": 0,
  "center": false,
  "text": "결과는 비슷했어요.",
  "spoken": "결과는 비슷했어요."
 },
 {
  "id": "L205",
  "from": "U210",
  "at": 0,
  "center": false,
  "text": "직장에 복귀하고 [첫 주]가 지나면",
  "spoken": "직장에 복귀하고 [첫 주]가 지나면"
 },
 {
  "id": "L206",
  "from": "U211",
  "at": 0,
  "center": false,
  "text": "휴가 전과 큰 차이가 없었고,",
  "spoken": "휴가 전과 큰 차이가 없었고,"
 },
 {
  "id": "L207",
  "from": "U212",
  "at": 0,
  "center": false,
  "text": "휴가를 길게 다녀온다고 해서",
  "spoken": "휴가를 길게 다녀온다고 해서"
 },
 {
  "id": "L208",
  "from": "U213",
  "at": 0,
  "center": false,
  "text": "그 효과가 더 커지지도 않았습니다.",
  "spoken": "그 효과가 더 커지지도 않았습니다."
 },
 {
  "id": "L209",
  "from": "U214",
  "at": 0,
  "center": true,
  "text": "도대체 왜 그럴까요?",
  "spoken": "도대체 왜 그럴까요?"
 },
 {
  "id": "L210",
  "from": "U215",
  "at": 0,
  "center": false,
  "text": "매슬랙과 동료 연구자 마이클 라이터는",
  "spoken": "매슬랙과 동료 연구자 마이클 라이터는"
 },
 {
  "id": "L211",
  "from": "U216",
  "at": 0,
  "center": false,
  "text": "번아웃의 진짜 원인을",
  "spoken": "번아웃의 진짜 원인을"
 },
 {
  "id": "L212",
  "from": "U217",
  "at": 0,
  "center": false,
  "text": "개인보다 [일터]에서 찾았습니다.",
  "spoken": "개인보다 [일터]에서 찾았습니다."
 },
 {
  "id": "L213",
  "from": "U218",
  "at": 0,
  "center": false,
  "text": "업무량,",
  "spoken": "업무량,"
 },
 {
  "id": "L214",
  "from": "U219",
  "at": 0,
  "center": false,
  "text": "일을 내 방식대로 해 나갈 수 있는 정도,",
  "spoken": "일을 내 방식대로 해 나갈 수 있는 정도,"
 },
 {
  "id": "L215",
  "from": "U220",
  "at": 0,
  "center": false,
  "text": "보상, 함께 일하는 사람들,",
  "spoken": "보상, 함께 일하는 사람들,"
 },
 {
  "id": "L216",
  "from": "U221",
  "at": 0,
  "center": false,
  "text": "공정함, 그리고 가치관.",
  "spoken": "공정함, 그리고 가치관."
 },
 {
  "id": "L217",
  "from": "U222",
  "at": 0,
  "center": false,
  "text": "이 여섯 가지가 나와 계속 [어긋날 때]",
  "spoken": "이 여섯 가지가 나와 계속 [어긋날 때]"
 },
 {
  "id": "L218",
  "from": "U223",
  "at": 0,
  "center": false,
  "text": "번아웃이 생기기 쉽다고 본 거죠.",
  "spoken": "번아웃이 생기기 쉽다고 본 거죠."
 },
 {
  "id": "L219",
  "from": "U224",
  "at": 0,
  "center": false,
  "text": "물론 지쳤을 때 쉬는 건 꼭 필요합니다.",
  "spoken": "물론 지쳤을 때 쉬는 건 꼭 필요합니다."
 },
 {
  "id": "L220",
  "from": "U225",
  "at": 0,
  "center": false,
  "text": "하지만 배터리를 닳게 하는 원인이",
  "spoken": "하지만 배터리를 닳게 하는 원인이"
 },
 {
  "id": "L221",
  "from": "U226",
  "at": 3,
  "center": false,
  "text": "일터에 그대로 있다면,",
  "spoken": "일터에 그대로 있다면,"
 },
 {
  "id": "L222",
  "from": "U227",
  "at": 0,
  "center": false,
  "text": "다시 돌아가는 순간 배터리는",
  "spoken": "다시 돌아가는 순간 배터리는"
 },
 {
  "id": "L223",
  "from": "U228",
  "at": 0,
  "center": false,
  "text": "또 닳기 시작할 거예요.",
  "spoken": "또 닳기 시작할 거예요."
 },
 {
  "id": "L224",
  "from": "U229",
  "at": 0,
  "center": true,
  "text": "바로 이 때문에 번아웃을\n개인의 [의지]만의 문제로 보기는 어렵습니다.",
  "spoken": "바로 이 때문에 번아웃을 개인의 [의지]만의 문제로 보기는 어렵습니다."
 },
 {
  "id": "L225",
  "from": "U231",
  "at": 0,
  "center": true,
  "text": "이쯤에서",
  "spoken": "이쯤에서"
 },
 {
  "id": "L226",
  "from": "U231b",
  "at": 0,
  "center": true,
  "text": "한 사람의 실제 이야기를",
  "spoken": "한 사람의 실제 이야기를"
 },
 {
  "id": "L227",
  "from": "U232b",
  "at": 0,
  "center": true,
  "text": "들려드릴게요.",
  "spoken": "들려드릴게요."
 },
 {
  "id": "L228",
  "from": "U233",
  "at": 0,
  "center": false,
  "text": "작년 십이월, 한 언론 기사에",
  "spoken": "작년 십이월, 한 언론 기사에"
 },
 {
  "id": "L229",
  "from": "U234",
  "at": 0,
  "center": false,
  "text": "서른한 살 직장인 박 모 씨의 이야기가 실렸습니다.",
  "spoken": "서른한 살 직장인 박 모 씨의 이야기가 실렸습니다."
 },
 {
  "id": "L230",
  "from": "U236",
  "at": 0,
  "center": false,
  "text": "그는 처음엔",
  "spoken": "그는 처음엔"
 },
 {
  "id": "L231",
  "from": "U236",
  "at": 5,
  "center": false,
  "text": "자기 상태가 번아웃이라는 걸 몰랐다고 해요.",
  "spoken": "자기 상태가 번아웃이라는 걸 몰랐다고 해요."
 },
 {
  "id": "L232",
  "from": "U238",
  "at": 0,
  "center": false,
  "text": "출근하면",
  "spoken": "출근하면"
 },
 {
  "id": "L233",
  "from": "U238",
  "at": 4,
  "center": false,
  "text": "일할 의욕이 없고,",
  "spoken": "일할 의욕이 없고,"
 },
 {
  "id": "L234",
  "from": "U239",
  "at": 0,
  "center": false,
  "text": "퇴근해서",
  "spoken": "퇴근해서"
 },
 {
  "id": "L235",
  "from": "U239",
  "at": 4,
  "center": false,
  "text": "취미를 하나 만들어보려고 해도",
  "spoken": "취미를 하나 만들어보려고 해도"
 },
 {
  "id": "L236",
  "from": "U241",
  "at": 0,
  "center": false,
  "text": "너무 피곤해서 잠만 자는 날이",
  "spoken": "너무 피곤해서 잠만 자는 날이"
 },
 {
  "id": "L237",
  "from": "U241b",
  "at": 0,
  "center": false,
  "text": "계속 이어졌다고 합니다.",
  "spoken": "계속 이어졌다고 합니다."
 },
 {
  "id": "L238",
  "from": "U242",
  "at": 0,
  "center": false,
  "text": "그리고 기사에서 당시의 마음을",
  "spoken": "그리고 기사에서 당시의 마음을"
 },
 {
  "id": "L239",
  "from": "U243",
  "at": 0,
  "center": false,
  "text": "이렇게 말했어요.",
  "spoken": "이렇게 말했어요."
 },
 {
  "id": "L240",
  "from": "U244",
  "at": 0,
  "center": true,
  "text": "\"열심히 살고 있는데도\n늘 부족하다고 느끼는 감정이 쌓이다,\n결국 감당이 안 되는 지점이 오는 것 같다.\"",
  "spoken": "\"열심히 살고 있는데도 늘 부족하다고 느끼는 감정이 쌓이다, 결국 감당이 안 되는 지점이 오는 것 같다.\""
 },
 {
  "id": "L241",
  "from": "U248",
  "at": 0,
  "center": true,
  "text": "저는 이 말 중에서",
  "spoken": "저는 이 말 중에서"
 },
 {
  "id": "L242",
  "from": "U249",
  "at": 0,
  "center": true,
  "text": "'[열심히 살고 있는데도]'라는 부분이",
  "spoken": "'[열심히 살고 있는데도]'라는 부분이"
 },
 {
  "id": "L243",
  "from": "U250b",
  "at": 0,
  "center": true,
  "text": "유독 마음에 오래 남더라고요.",
  "spoken": "유독 마음에 오래 남더라고요."
 },
 {
  "id": "L244",
  "from": "U251",
  "at": 0,
  "center": false,
  "text": "번아웃은 게을러서 오는 게 아니라,",
  "spoken": "번아웃은 게을러서 오는 게 아니라,"
 },
 {
  "id": "L245",
  "from": "U252",
  "at": 0,
  "center": false,
  "text": "열심히 사는 사람에게도",
  "spoken": "열심히 사는 사람에게도"
 },
 {
  "id": "L246",
  "from": "U253",
  "at": 0,
  "center": false,
  "text": "찾아올 수 있다는 말처럼 들렸거든요.",
  "spoken": "찾아올 수 있다는 말처럼 들렸거든요."
 },
 {
  "id": "L247",
  "from": "U254",
  "at": 0,
  "center": false,
  "text": "번아웃이라는 이름을 처음 붙인 프로이덴버거가",
  "spoken": "번아웃이라는 이름을 처음 붙인 프로이덴버거가"
 },
 {
  "id": "L248",
  "from": "U255",
  "at": 7,
  "center": false,
  "text": "그랬던 것처럼요.",
  "spoken": "그랬던 것처럼요."
 },
 {
  "id": "L249",
  "from": "U256",
  "at": 0,
  "center": true,
  "text": "혹시 지금 이 이야기가",
  "spoken": "혹시 지금 이 이야기가"
 },
 {
  "id": "L250",
  "from": "U257",
  "at": 0,
  "center": true,
  "text": "본인의 얘기처럼 들리셨다면,",
  "spoken": "본인의 얘기처럼 들리셨다면,"
 },
 {
  "id": "L251",
  "from": "U258",
  "at": 0,
  "center": true,
  "text": "이어서 말씀드릴",
  "spoken": "이어서 말씀드릴"
 },
 {
  "id": "L252",
  "from": "U259",
  "at": 0,
  "center": true,
  "text": "번아웃을 극복하는 작은 방법 [두 가지]를\n가볍게 기억해 주세요.",
  "spoken": "번아웃을 극복하는 작은 방법 [두 가지]를 가볍게 기억해 주세요."
 },
 {
  "id": "L253",
  "from": "U261",
  "at": 0,
  "center": false,
  "text": "첫 번째는,",
  "spoken": "첫 번째는,"
 },
 {
  "id": "L254",
  "from": "U262",
  "at": 0,
  "center": false,
  "text": "오늘 내 에너지가 [십 점 만점]에 몇 점인지",
  "spoken": "오늘 내 에너지가 [십 점 만점]에 몇 점인지"
 },
 {
  "id": "L255",
  "from": "U263",
  "at": 4,
  "center": false,
  "text": "메모해 보는 거예요.",
  "spoken": "메모해 보는 거예요."
 },
 {
  "id": "L256",
  "from": "U264",
  "at": 0,
  "center": false,
  "text": "아침에 한 번,",
  "spoken": "아침에 한 번,"
 },
 {
  "id": "L257",
  "from": "U265",
  "at": 0,
  "center": false,
  "text": "퇴근하고 한 번이면 충분하고,",
  "spoken": "퇴근하고 한 번이면 충분하고,"
 },
 {
  "id": "L258",
  "from": "U266",
  "at": 0,
  "center": false,
  "text": "이유를 길게 적을 필요도 없습니다.",
  "spoken": "이유를 길게 적을 필요도 없습니다."
 },
 {
  "id": "L259",
  "from": "U267",
  "at": 0,
  "center": true,
  "text": "그냥 [숫자 하나]면 돼요.",
  "spoken": "그냥 [숫자 하나]면 돼요."
 },
 {
  "id": "L260",
  "from": "U268",
  "at": 0,
  "center": false,
  "text": "이렇게 며칠만 적어 봐도",
  "spoken": "이렇게 며칠만 적어 봐도"
 },
 {
  "id": "L261",
  "from": "U269",
  "at": 0,
  "center": false,
  "text": "유독 점수가 낮아지는 날이",
  "spoken": "유독 점수가 낮아지는 날이"
 },
 {
  "id": "L262",
  "from": "U270",
  "at": 0,
  "center": false,
  "text": "눈에 들어오기 시작합니다.",
  "spoken": "눈에 들어오기 시작합니다."
 },
 {
  "id": "L263",
  "from": "U271",
  "at": 0,
  "center": false,
  "text": "'아, 월요일 회의가 있는 날은 늘 삼 점이네' 하고요.",
  "spoken": "'아, 월요일 회의가 있는 날은 늘 삼 점이네' 하고요."
 },
 {
  "id": "L264",
  "from": "U273",
  "at": 0,
  "center": false,
  "text": "이런 흐름이 눈에 보이면,",
  "spoken": "이런 흐름이 눈에 보이면,"
 },
 {
  "id": "L265",
  "from": "U274",
  "at": 0,
  "center": false,
  "text": "정체를 알 수 없던 막연한 피로가",
  "spoken": "정체를 알 수 없던 막연한 피로가"
 },
 {
  "id": "L266",
  "from": "U275",
  "at": 0,
  "center": false,
  "text": "조금씩 다룰 수 있는 구체적인 문제로 바뀝니다.",
  "spoken": "조금씩 다룰 수 있는 구체적인 문제로 바뀝니다."
 },
 {
  "id": "L267",
  "from": "U277",
  "at": 0,
  "center": false,
  "text": "두 번째는,",
  "spoken": "두 번째는,"
 },
 {
  "id": "L268",
  "from": "U278",
  "at": 0,
  "center": false,
  "text": "아까 말씀드린 여섯 가지 일터의 조건을",
  "spoken": "아까 말씀드린 여섯 가지 일터의 조건을"
 },
 {
  "id": "L269",
  "from": "U279",
  "at": 0,
  "center": false,
  "text": "떠올려 보고,",
  "spoken": "떠올려 보고,"
 },
 {
  "id": "L270",
  "from": "U280",
  "at": 0,
  "center": false,
  "text": "그중 지금 나와 가장 크게 어긋나 있는 것 [하나만]",
  "spoken": "그중 지금 나와 가장 크게 어긋나 있는 것 [하나만]"
 },
 {
  "id": "L271",
  "from": "U281",
  "at": 3,
  "center": false,
  "text": "골라 적어 보는 거예요.",
  "spoken": "골라 적어 보는 거예요."
 },
 {
  "id": "L272",
  "from": "U282",
  "at": 0,
  "center": false,
  "text": "업무량인지, 보상인지,",
  "spoken": "업무량인지, 보상인지,"
 },
 {
  "id": "L273",
  "from": "U283",
  "at": 0,
  "center": false,
  "text": "아니면 함께 일하는 사람인지",
  "spoken": "아니면 함께 일하는 사람인지"
 },
 {
  "id": "L274",
  "from": "U284",
  "at": 4,
  "center": false,
  "text": "짚어 보는 거죠.",
  "spoken": "짚어 보는 거죠."
 },
 {
  "id": "L275",
  "from": "U285",
  "at": 0,
  "center": false,
  "text": "나를 지치게 하는 원인을",
  "spoken": "나를 지치게 하는 원인을"
 },
 {
  "id": "L276",
  "from": "U286",
  "at": 0,
  "center": false,
  "text": "딱 하나만 짚어 봐도,",
  "spoken": "딱 하나만 짚어 봐도,"
 },
 {
  "id": "L277",
  "from": "U287",
  "at": 0,
  "center": false,
  "text": "이게 내 의지 탓만은 아니라는 걸",
  "spoken": "이게 내 의지 탓만은 아니라는 걸"
 },
 {
  "id": "L278",
  "from": "U288",
  "at": 5,
  "center": false,
  "text": "알게 됩니다.",
  "spoken": "알게 됩니다."
 },
 {
  "id": "L279",
  "from": "U289",
  "at": 0,
  "center": false,
  "text": "그리고 저는 그걸 아는 것부터가",
  "spoken": "그리고 저는 그걸 아는 것부터가"
 },
 {
  "id": "L280",
  "from": "U290",
  "at": 0,
  "center": false,
  "text": "자책을 멈추고 회복을 고민하는 첫걸음이",
  "spoken": "자책을 멈추고 회복을 고민하는 첫걸음이"
 },
 {
  "id": "L281",
  "from": "U291",
  "at": 4,
  "center": false,
  "text": "될 수 있다고 생각해요.",
  "spoken": "될 수 있다고 생각해요."
 },
 {
  "id": "L282",
  "from": "U292",
  "at": 0,
  "center": false,
  "text": "주말 내내 자고도",
  "spoken": "주말 내내 자고도"
 },
 {
  "id": "L283",
  "from": "U293",
  "at": 0,
  "center": false,
  "text": "알람을 끄고 다시 눕게 되는 아침.",
  "spoken": "알람을 끄고 다시 눕게 되는 아침."
 },
 {
  "id": "L284",
  "from": "U294",
  "at": 0,
  "center": false,
  "text": "그 무거운 아침은",
  "spoken": "그 무거운 아침은"
 },
 {
  "id": "L285",
  "from": "U294",
  "at": 7,
  "center": false,
  "text": "어쩌면 게으름이 아니라,",
  "spoken": "어쩌면 게으름이 아니라,"
 },
 {
  "id": "L286",
  "from": "U295",
  "at": 0,
  "center": false,
  "text": "그동안 오래 닳아 온 내 마음의 [배터리]를",
  "spoken": "그동안 오래 닳아 온 내 마음의 [배터리]를"
 },
 {
  "id": "L287",
  "from": "U297",
  "at": 0,
  "center": false,
  "text": "보여 주는 건지도 모릅니다.",
  "spoken": "보여 주는 건지도 모릅니다."
 },
 {
  "id": "L288",
  "from": "U298",
  "at": 0,
  "center": false,
  "text": "지금 번아웃을 이겨 내려고",
  "spoken": "지금 번아웃을 이겨 내려고"
 },
 {
  "id": "L289",
  "from": "U299",
  "at": 0,
  "center": false,
  "text": "애쓰는 중이시라면",
  "spoken": "애쓰는 중이시라면"
 },
 {
  "id": "L290",
  "from": "U300",
  "at": 0,
  "center": false,
  "text": "이 말을 꼭 전하고 싶습니다.",
  "spoken": "이 말을 꼭 전하고 싶습니다."
 },
 {
  "id": "L291",
  "from": "U301",
  "at": 0,
  "center": false,
  "text": "주말 내내 쉬었는데도 그대로인 건,",
  "spoken": "주말 내내 쉬었는데도 그대로인 건,"
 },
 {
  "id": "L292",
  "from": "U302",
  "at": 0,
  "center": false,
  "text": "여러분이 극복을 못 해서가 아닐 수 있다고요.",
  "spoken": "여러분이 극복을 못 해서가 아닐 수 있다고요."
 },
 {
  "id": "L293",
  "from": "U304",
  "at": 0,
  "center": true,
  "text": "당신은 게을러진 게 아니라,\n그만큼 오랫동안 [애써 온] 거라고요.",
  "spoken": "당신은 게을러진 게 아니라, 그만큼 오랫동안 [애써 온] 거라고요."
 },
 {
  "id": "L294",
  "from": "U306",
  "at": 0,
  "center": false,
  "text": "쉬어도 풀리지 않는 피로가",
  "spoken": "쉬어도 풀리지 않는 피로가"
 },
 {
  "id": "L295",
  "from": "U307",
  "at": 0,
  "center": false,
  "text": "왜 의지의 문제가 아닐 수 있는지,",
  "spoken": "왜 의지의 문제가 아닐 수 있는지,"
 },
 {
  "id": "L296",
  "from": "U308",
  "at": 0,
  "center": false,
  "text": "그리고 지금 내 상태를",
  "spoken": "그리고 지금 내 상태를"
 },
 {
  "id": "L297",
  "from": "U309",
  "at": 0,
  "center": false,
  "text": "어떻게 점검해 볼 수 있는지,",
  "spoken": "어떻게 점검해 볼 수 있는지,"
 },
 {
  "id": "L298",
  "from": "U310",
  "at": 0,
  "center": false,
  "text": "오늘 이야기가 그걸 아는 데",
  "spoken": "오늘 이야기가 그걸 아는 데"
 },
 {
  "id": "L299",
  "from": "U311",
  "at": 0,
  "center": false,
  "text": "작은 도움이 되었으면 좋겠습니다.",
  "spoken": "작은 도움이 되었으면 좋겠습니다."
 }
]