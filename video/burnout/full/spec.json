 ],
 "subs": [
  {
   "unit": "U001",
   "text": "주말 내내 분명 푹 잤는데,"
  },
  {
   "unit": "U002",
   "text": "월요일 아침 알람을 끄고"
  },
  {
   "unit": "U003",
   "text": "또 그대로 눕게 됩니다."
  },
  {
   "unit": "U004",
   "text": "'이번 주말엔 진짜 아무것도",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U005",
   "text": "안 하고 쉬었는데,",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U006",
   "text": "왜 몸이 그대로지?'",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U007",
   "text": "번아웃을 이겨 내 보려고"
  },
  {
   "unit": "U008",
   "text": "나름대로 쉬어 봤는데도"
  },
  {
   "unit": "U009",
   "text": "좀처럼 나아지질 않아서,"
  },
  {
   "unit": "U010",
   "text": "혹시 '내가 그냥 게을러서 그런가' 하고"
  },
  {
   "unit": "U011",
   "text": "자책하고 계셨나요?"
  },
  {
   "unit": "U012",
   "text": "그렇다면 오늘 이야기가",
   "box": false
  },
  {
   "unit": "U012b",
   "text": "그 질문의 답을 찾는 데",
   "box": false
  },
  {
   "unit": "U013",
   "text": "작은 힌트가 될지도 모르겠습니다.",
   "box": false
  },
  {
   "unit": "U014",
   "text": "분명 쉬었는데도 피로가",
   "box": false
  },
  {
   "unit": "U015",
   "text": "왜 잘 풀리지 않는지,",
   "box": false
  },
  {
   "unit": "U016",
   "text": "그리고 그게 왜 내 게으름 탓이"
  },
  {
   "unit": "U017",
   "text": "아닐 수 있는지 하나씩"
  },
  {
   "unit": "U018",
   "text": "차근차근 이야기해 볼게요."
  },
  {
   "unit": "U019",
   "text": "출근길에 업무 메일 알림이 하나 뜹니다."
  },
  {
   "unit": "U020",
   "text": "아직 열어 보지도 않았는데"
  },
  {
   "unit": "U021",
   "text": "한숨부터 푹 나오죠."
  },
  {
   "unit": "U022",
   "text": "회사에서 동료가 말을 걸어와도"
  },
  {
   "unit": "U023",
   "text": "맞장구칠 힘이 잘 나질 않습니다."
  },
  {
   "unit": "U024",
   "text": "퇴근길엔 아침까지만 해도"
  },
  {
   "unit": "U025",
   "text": "가려고 했던 운동을"
  },
  {
   "unit": "U026",
   "text": "슬그머니 접어요."
  },
  {
   "unit": "U027",
   "text": "'아, 오늘은 너무 피곤하니까",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U028",
   "text": "내일 하자.'",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U029",
   "text": "집에 와서는 아무 영상이나 틀어 놓고"
  },
  {
   "unit": "U030",
   "text": "휴대폰 화면만 멍하니 들여다보는데,"
  },
  {
   "unit": "U031",
   "text": "한참을 보고 나서도"
  },
  {
   "unit": "U032",
   "text": "방금 뭘 봤는지 기억이 잘 안 납니다."
  },
  {
   "unit": "U033",
   "text": "그렇게 겨우 금요일이 오면,"
  },
  {
   "unit": "U034",
   "text": "'그래도 이번 주말엔 푹 쉬면"
  },
  {
   "unit": "U035",
   "text": "괜찮아지겠지' 하고 기대하게 되죠."
  },
  {
   "unit": "U036",
   "text": "토요일엔 늦잠을 자고,"
  },
  {
   "unit": "U037",
   "text": "일요일엔 하루 종일 누워만 있었습니다."
  },
  {
   "unit": "U038",
   "text": "정말 아무것도 안 하고 쉬기만 했어요."
  },
  {
   "unit": "U039",
   "text": "그런데 참 이상하죠.",
   "pos": "center"
  },
  {
   "unit": "U040",
   "text": "일요일 저녁만 되면 마음이"
  },
  {
   "unit": "U041",
   "text": "다시 쿵 무거워집니다."
  },
  {
   "unit": "U042",
   "text": "'아, 내일 또 출근이네.'",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U043",
   "text": "혹시 여러분도 일요일",
   "box": false
  },
  {
   "unit": "U044",
   "text": "저녁 6시쯤만 되면",
   "box": false
  },
  {
   "unit": "U045",
   "text": "이런 기분이 슬슬 올라오지 않으시나요?",
   "box": false
  },
  {
   "unit": "U046",
   "text": "바로 이런 상태를 부르는 이름이",
   "pos": "center"
  },
  {
   "unit": "U047",
   "text": "우리가 잘 아는 '[번아웃]'입니다.",
   "pos": "center"
  },
  {
   "unit": "U048",
   "text": "심리학에서 이 말을 처음 쓴 사람은"
  },
  {
   "unit": "U049",
   "text": "미국의 심리학자",
   "box": false
  },
  {
   "unit": "U050",
   "text": "허버트 프로이덴버거인데요.",
   "box": false
  },
  {
   "unit": "U051",
   "text": "1970년대 뉴욕에서 일하던 그는"
  },
  {
   "unit": "U052",
   "text": "누구보다 열정과 사명감이"
  },
  {
   "unit": "U053",
   "text": "넘치는 사람이었습니다."
  },
  {
   "unit": "U054",
   "text": "낮에는 자기 상담실에서"
  },
  {
   "unit": "U055",
   "text": "12시간 동안 환자들을 돌보고,"
  },
  {
   "unit": "U056",
   "text": "밤이 되면 형편이 어려운 사람들을 돕겠다며"
  },
  {
   "unit": "U057",
   "text": "무료 진료소로 건너가"
  },
  {
   "unit": "U058",
   "text": "새벽 2시까지 일하곤 했죠.",
   "box": false
  },
  {
   "unit": "U059",
   "text": "몸이 부서져라 일하면서도"
  },
  {
   "unit": "U060",
   "text": "본인은 괜찮다고 생각했습니다."
  },
  {
   "unit": "U061",
   "text": "그러다 사단이 난 건,"
  },
  {
   "unit": "U062",
   "text": "모처럼 가족들과 크리스마스 여행을"
  },
  {
   "unit": "U063",
   "text": "떠나기로 한 아침이었어요."
  },
  {
   "unit": "U064",
   "text": "일에서 손을 놓고 긴장이 풀리자마자,"
  },
  {
   "unit": "U065",
   "text": "그동안 쌓였던 피로가"
  },
  {
   "unit": "U066",
   "text": "한꺼번에 덮친 겁니다."
  },
  {
   "unit": "U067",
   "text": "그는 그날 아침 침대에서"
  },
  {
   "unit": "U068",
   "text": "손가락 하나 까딱하지 못했고,"
  },
  {
   "unit": "U069",
   "text": "결국 약속했던 여행을 가지 못한 채"
  },
  {
   "unit": "U070",
   "text": "며칠 내내 앓아누웠습니다."
  },
  {
   "unit": "U071",
   "text": "충격을 받은 그는"
  },
  {
   "unit": "U072",
   "text": "자신이 왜 이렇게 무너졌는지"
  },
  {
   "unit": "U073",
   "text": "알아내기 위해 녹음기를 켰습니다."
  },
  {
   "unit": "U074",
   "text": "매일 1~2시간씩"
  },
  {
   "unit": "U075",
   "text": "지금 자기가 느끼는 피로감과 짜증,"
  },
  {
   "unit": "U076",
   "text": "공허함을 있는 그대로 녹음한 뒤"
  },
  {
   "unit": "U077",
   "text": "다시 돌려 들어 본 거예요."
  },
  {
   "unit": "U078",
   "text": "거기엔 평소 따뜻하던 자신의 모습 대신,"
  },
  {
   "unit": "U079",
   "text": "완전히 지쳐서 날이 서 있는"
  },
  {
   "unit": "U080",
   "text": "낯선 목소리가 담겨 있었습니다."
  },
  {
   "unit": "U081",
   "text": "그는 진료소에서 함께 일하던"
  },
  {
   "unit": "U082",
   "text": "동료들을 떠올렸어요."
  },
  {
   "unit": "U083",
   "text": "가만히 돌아보니,"
  },
  {
   "unit": "U084",
   "text": "처음에 가장 뜨겁게 헌신하던"
  },
  {
   "unit": "U085",
   "text": "동료들일수록 가장 먼저"
  },
  {
   "unit": "U086",
   "text": "지치고, 예민해지고,"
  },
  {
   "unit": "U087",
   "text": "결국엔 차갑고 냉소적으로"
  },
  {
   "unit": "U088",
   "text": "변해 가고 있었던 겁니다."
  },
  {
   "unit": "U089",
   "text": "마치 연료를 끝까지 다 태워버리고"
  },
  {
   "unit": "U090",
   "text": "잿더미만 남은 것처럼요."
  },
  {
   "unit": "U091",
   "text": "그는 1974년 논문에서,"
  },
  {
   "unit": "U092",
   "text": "이렇게 열정을 다 태우고"
  },
  {
   "unit": "U093",
   "text": "텅 비어버린 상태를"
  },
  {
   "unit": "U094",
   "text": "처음으로 '[번아웃]'이라고 불렀습니다."
  },
  {
   "unit": "U095",
   "text": "여기서 우리가",
   "pos": "center"
  },
  {
   "unit": "U096",
   "text": "꼭 눈여겨봐야 할 점이 있어요.",
   "pos": "center"
  },
  {
   "unit": "U097",
   "text": "번아웃이라는 말을 만든 사람도,"
  },
  {
   "unit": "U098",
   "text": "그가 지켜본 동료들도"
  },
  {
   "unit": "U099",
   "text": "결코 게으른 사람들이 아니었다는 겁니다."
  },
  {
   "unit": "U100",
   "text": "오히려 누구보다 책임감이 강하고,"
  },
  {
   "unit": "U101",
   "text": "가장 열심히 애쓰던 사람들이"
  },
  {
   "unit": "U102",
   "text": "제일 먼저 번아웃에 빠졌다는 거죠."
  },
  {
   "unit": "U103",
   "text": "그로부터 한참 뒤인 2019년,",
   "box": false
  },
  {
   "unit": "U104",
   "text": "세계보건기구는 번아웃을",
   "box": false
  },
  {
   "unit": "U105",
   "text": "'제대로 관리되지 않은",
   "pos": "center"
  },
  {
   "unit": "U106",
   "text": "만성적인 [직장 스트레스]에서 생기는 증후군'",
   "pos": "center"
  },
  {
   "unit": "U107",
   "text": "이라고 정의했습니다.",
   "pos": "center"
  },
  {
   "unit": "U108",
   "text": "쉽게 말해, 일 때문에 쌓인 스트레스가",
   "box": false
  },
  {
   "unit": "U109",
   "text": "오랫동안 풀리지 못해서",
   "box": false
  },
  {
   "unit": "U110",
   "text": "생긴 상태라는 거예요.",
   "box": false
  },
  {
   "unit": "U111",
   "text": "흥미로운 건,",
   "pos": "center"
  },
  {
   "unit": "U112",
   "text": "세계보건기구가 번아웃을",
   "pos": "center"
  },
  {
   "unit": "U113",
   "text": "개인의 [질병]으로",
   "pos": "center"
  },
  {
   "unit": "U114",
   "text": "분류하지 않았다는 점입니다.",
   "pos": "center"
  },
  {
   "unit": "U115",
   "text": "대신 일과 관련된 현상으로 분류했고,"
  },
  {
   "unit": "U116",
   "text": "[직장]이라는 맥락에서만 쓰는 말이라고"
  },
  {
   "unit": "U117",
   "text": "분명히 선을 그어 두었죠."
  },
  {
   "unit": "U118",
   "text": "저는 이 번아웃을 휴대폰에"
  },
  {
   "unit": "U119",
   "text": "한 번 비유해 보고 싶습니다."
  },
  {
   "unit": "U120",
   "text": "충전하는 속도보다",
   "box": false
  },
  {
   "unit": "U121",
   "text": "[배터리]가 닳는 속도가 더 빠른",
   "box": false
  },
  {
   "unit": "U122",
   "text": "휴대폰 말이에요.",
   "box": false
  },
  {
   "unit": "U123",
   "text": "이런 휴대폰은",
   "box": false
  },
  {
   "unit": "U124",
   "text": "하룻밤 충전기를 꽂아 둔다고 해서",
   "box": false
  },
  {
   "unit": "U125",
   "text": "문제가 해결되지 않습니다.",
   "box": false
  },
  {
   "unit": "U126",
   "text": "보이지 않는 곳에서 배터리를 빼 가는",
   "box": false
  },
  {
   "unit": "U127",
   "text": "[무언가]가 여전히 켜져 있으니까요.",
   "box": false
  },
  {
   "unit": "U128",
   "text": "세계보건기구는 번아웃의 특징을",
   "pos": "center"
  },
  {
   "unit": "U129",
   "text": "크게 [3가지]로 설명합니다.",
   "pos": "center"
  },
  {
   "unit": "U130",
   "text": "먼저 번아웃의 첫 번째 신호는",
   "pos": "center"
  },
  {
   "unit": "U131",
   "text": "[에너지]가 바닥나는 겁니다.",
   "pos": "center"
  },
  {
   "unit": "U132",
   "text": "토요일에 10시간을 자고"
  },
  {
   "unit": "U133",
   "text": "일요일엔 낮잠까지 잤는데도,"
  },
  {
   "unit": "U134",
   "text": "월요일 아침이면 몸이 여전히 무겁습니다."
  },
  {
   "unit": "U135",
   "text": "'이 정도 쉬었으면"
  },
  {
   "unit": "U136",
   "text": "괜찮아야 하는데' 싶다가도,"
  },
  {
   "unit": "U137",
   "text": "어느새 자책이 따라오죠."
  },
  {
   "unit": "U138",
   "text": "'남들은 주말에"
  },
  {
   "unit": "U139",
   "text": "운동도 하고 공부도 한다는데,"
  },
  {
   "unit": "U140",
   "text": "나는 왜 누워만 있지?'"
  },
  {
   "unit": "U141",
   "text": "보통의 피로는 푹 쉬고 나면",
   "box": false
  },
  {
   "unit": "U142",
   "text": "어느 정도 풀리지만,",
   "box": false
  },
  {
   "unit": "U143",
   "text": "번아웃의 피로는 아무리 쉬어도",
   "box": false
  },
  {
   "unit": "U144",
   "text": "잘 채워지지 않는다고",
   "box": false
  },
  {
   "unit": "U145",
   "text": "느끼는 경우가 많습니다.",
   "box": false
  },
  {
   "unit": "U146",
   "text": "그럼 게으름과는 뭐가 다를까요?",
   "pos": "center"
  },
  {
   "unit": "U147",
   "text": "게으름이 '하기 싫은 마음'에 가깝다면,"
  },
  {
   "unit": "U148",
   "text": "번아웃은 '하고 싶어도",
   "box": false
  },
  {
   "unit": "U149",
   "text": "[꺼내 쓸 힘]이 남아 있지 않은 상태'에",
   "box": false
  },
  {
   "unit": "U150",
   "text": "가깝습니다.",
   "box": false
  },
  {
   "unit": "U151",
   "text": "그러니까 이건 마음가짐의 문제가 아니라,",
   "box": false
  },
  {
   "unit": "U152",
   "text": "바닥난 [연료]의 문제인 거죠.",
   "box": false
  },
  {
   "unit": "U153",
   "text": "번아웃의 두 번째 신호는",
   "pos": "center"
  },
  {
   "unit": "U154",
   "text": "일과 내 마음 사이의 [거리]가",
   "pos": "center"
  },
  {
   "unit": "U155",
   "text": "점점 멀어지는 겁니다.",
   "pos": "center"
  },
  {
   "unit": "U156",
   "text": "회의에서 새로운 의견이 나오면,"
  },
  {
   "unit": "U157",
   "text": "예전 같았으면 같이 고민했을 텐데"
  },
  {
   "unit": "U158",
   "text": "요즘은 '어차피 해도 안 바뀌어'라는"
  },
  {
   "unit": "U159",
   "text": "생각부터 듭니다."
  },
  {
   "unit": "U160",
   "text": "메신저에 팀장님 이름만 떠도"
  },
  {
   "unit": "U161",
   "text": "가슴이 답답해지고,"
  },
  {
   "unit": "U162",
   "text": "점심은 그냥 혼자 먹고 싶어지죠."
  },
  {
   "unit": "U165",
   "text": "세계보건기구는 이런 모습을",
   "pos": "center"
  },
  {
   "unit": "U166",
   "text": "일에 대한 '[심리적 거리감]',",
   "pos": "center"
  },
  {
   "unit": "U167",
   "text": "혹은 '[냉소]'라고 설명합니다.",
   "pos": "center"
  },
  {
   "unit": "U168",
   "text": "이게 게으름과 다른 건,"
  },
  {
   "unit": "U169",
   "text": "처음부터 일에 관심이 없었던 게"
  },
  {
   "unit": "U170",
   "text": "아니라는 점이에요."
  },
  {
   "unit": "U171",
   "text": "너무 오랫동안 애쓰다 보니,"
  },
  {
   "unit": "U172",
   "text": "지친 마음이 상처받지 않으려고"
  },
  {
   "unit": "U173",
   "text": "스스로 한 발 물러나 버린"
  },
  {
   "unit": "U174",
   "text": "쪽에 가깝습니다."
  },
  {
   "unit": "U175",
   "text": "원래 무관심했던 게 아니라,"
  },
  {
   "unit": "U176",
   "text": "지친 마음이 스스로 [거리]를 두는 거죠."
  },
  {
   "unit": "U177",
   "text": "번아웃의 세 번째 신호는",
   "pos": "center"
  },
  {
   "unit": "U178",
   "text": "내가 일을 잘 해내고 있다는 [느낌]이",
   "pos": "center"
  },
  {
   "unit": "U179",
   "text": "부쩍 줄어드는 겁니다.",
   "pos": "center"
  },
  {
   "unit": "U180",
   "text": "분명 작년엔 칭찬까지 받았던 보고서인데,"
  },
  {
   "unit": "U181",
   "text": "올해는 쓰는 내내 자신이 없어요."
  },
  {
   "unit": "U182",
   "text": "빈 파일을 열어 놓고"
  },
  {
   "unit": "U183",
   "text": "1시간째 첫 문장만 고치고 있죠."
  },
  {
   "unit": "U184",
   "text": "'나 원래 이 일 잘하던 사람 맞나?'",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U185",
   "text": "싶고, 작은 실수 하나에도"
  },
  {
   "unit": "U186",
   "text": "내가 무능한 사람처럼 느껴집니다."
  },
  {
   "unit": "U187",
   "text": "세계보건기구는 이걸 '[직업적 효능감]',",
   "pos": "center"
  },
  {
   "unit": "U188",
   "text": "내가 해낼 수 있다는 믿음이",
   "pos": "center"
  },
  {
   "unit": "U189",
   "text": "줄어드는 거라고 표현합니다.",
   "pos": "center"
  },
  {
   "unit": "U190",
   "text": "그런데 이것도 내 능력이 없어서"
  },
  {
   "unit": "U191",
   "text": "생기는 일이 아니에요."
  },
  {
   "unit": "U192",
   "text": "오히려 잘하고 싶은 마음이"
  },
  {
   "unit": "U193",
   "text": "아직 남아 있으니까 더 괴로운 겁니다."
  },
  {
   "unit": "U194",
   "text": "내 능력이 사라진 게 아니라,",
   "box": false
  },
  {
   "unit": "U195",
   "text": "내 능력을 느끼고 발휘할 [힘]이",
   "box": false
  },
  {
   "unit": "U196",
   "text": "줄어든 거예요.",
   "box": false
  },
  {
   "unit": "U197",
   "text": "그렇다면 번아웃은 푹 쉬면 나아질까요?",
   "pos": "center"
  },
  {
   "unit": "U198",
   "text": "흔히들 그렇게 생각하지만,"
  },
  {
   "unit": "U199",
   "text": "휴가에 관한 연구들은"
  },
  {
   "unit": "U200",
   "text": "조금 다른 이야기를 들려줍니다."
  },
  {
   "unit": "U201",
   "text": "2009년, 한 연구진이",
   "box": false
  },
  {
   "unit": "U202",
   "text": "휴가의 효과를 다룬 연구 [7편]을",
   "box": false
  },
  {
   "unit": "U203",
   "text": "모아서 분석했는데요.",
   "box": false
  },
  {
   "unit": "U204",
   "text": "휴가는 분명 건강과 행복감을 높여 줬지만,"
  },
  {
   "unit": "U205",
   "text": "일터로 돌아가자마자",
   "box": false
  },
  {
   "unit": "U206",
   "text": "그 효과는 금방 [사라졌습니다].",
   "box": false
  },
  {
   "unit": "U207",
   "text": "같은 연구진이 더 많은 연구를",
   "box": false
  },
  {
   "unit": "U208",
   "text": "모아 다시 분석했을 때도",
   "box": false
  },
  {
   "unit": "U209",
   "text": "결과는 비슷했어요.",
   "box": false
  },
  {
   "unit": "U210",
   "text": "직장에 복귀하고 [첫 주]가 지나면",
   "box": false
  },
  {
   "unit": "U211",
   "text": "휴가 전과 큰 차이가 없었고,",
   "box": false
  },
  {
   "unit": "U212",
   "text": "휴가를 길게 다녀온다고 해서",
   "box": false
  },
  {
   "unit": "U213",
   "text": "그 효과가 더 커지지도 않았습니다.",
   "box": false
  },
  {
   "unit": "U214",
   "text": "도대체 왜 그럴까요?",
   "pos": "center"
  },
  {
   "unit": "U215",
   "text": "매슬랙과 동료 연구자 마이클 라이터는"
  },
  {
   "unit": "U216",
   "text": "번아웃의 진짜 원인을"
  },
  {
   "unit": "U217",
   "text": "개인보다 [일터]에서 찾았습니다."
  },
  {
   "unit": "U218",
   "text": "업무량,",
   "box": false
  },
  {
   "unit": "U219",
   "text": "일을 내 방식대로 해 나갈 수 있는 정도,",
   "box": false
  },
  {
   "unit": "U220",
   "text": "보상, 함께 일하는 사람들,",
   "box": false
  },
  {
   "unit": "U221",
   "text": "공정함, 그리고 가치관.",
   "box": false
  },
  {
   "unit": "U222",
   "text": "이 6가지가 나와 계속 [어긋날 때]",
   "box": false
  },
  {
   "unit": "U223",
   "text": "번아웃이 생기기 쉽다고 본 거죠.",
   "box": false
  },
  {
   "unit": "U224",
   "text": "물론 지쳤을 때 쉬는 건 꼭 필요합니다."
  },
  {
   "unit": "U225",
   "text": "하지만 배터리를 닳게 하는",
   "box": false
  },
  {
   "unit": "U226",
   "text": "원인이 일터에 그대로 있다면,",
   "box": false
  },
  {
   "unit": "U227",
   "text": "다시 돌아가는 순간 배터리는"
  },
  {
   "unit": "U228",
   "text": "또 닳기 시작할 거예요."
  },
  {
   "unit": "U229",
   "text": "바로 이 때문에",
   "pos": "center"
  },
  {
   "unit": "U229b",
   "text": "번아웃을",
   "pos": "center"
  },
  {
   "unit": "U230",
   "text": "개인의 [의지]만의 문제로 보기는",
   "pos": "center"
  },
  {
   "unit": "U230b",
   "text": "어렵습니다.",
   "pos": "center"
  },
  {
   "unit": "U231",
   "text": "이쯤에서",
   "pos": "center"
  },
  {
   "unit": "U231b",
   "text": "한 사람의",
   "pos": "center"
  },
  {
   "unit": "U232",
   "text": "실제 이야기를",
   "pos": "center"
  },
  {
   "unit": "U232b",
   "text": "들려드릴게요.",
   "pos": "center"
  },
  {
   "unit": "U233",
   "text": "작년 12월, 한 언론 기사에",
   "box": false
  },
  {
   "unit": "U234",
   "text": "26살 직장인",
   "box": false
  },
  {
   "unit": "U235",
   "text": "박 모 씨의 이야기가 실렸습니다.",
   "box": false
  },
  {
   "unit": "U236",
   "text": "그는 처음엔 자기 상태가"
  },
  {
   "unit": "U237",
   "text": "번아웃이라는 걸 몰랐다고 해요."
  },
  {
   "unit": "U238",
   "text": "폭식을 하다가도"
  },
  {
   "unit": "U239",
   "text": "갑자기 입맛이 싹 사라지는 날이 반복됐고,"
  },
  {
   "unit": "U240",
   "text": "화장실 갈 기운도 없어"
  },
  {
   "unit": "U241",
   "text": "잠만 자는 날이 이어졌다고 합니다."
  },
  {
   "unit": "U242",
   "text": "그리고 기사에서 당시의 마음을"
  },
  {
   "unit": "U243",
   "text": "이렇게 말했어요."
  },
  {
   "unit": "U244",
   "text": "\"열심히 살고 있는데도",
   "pos": "center",
   "box": false,
   "shadow": true
  },
  {
   "unit": "U245",
   "text": "늘 부족하다고 느끼는 감정이 쌓이다,",
   "pos": "center",
   "box": false,
   "shadow": true
  },
  {
   "unit": "U246",
   "text": "결국 감당이 안 되는 지점이",
   "pos": "center",
   "box": false,
   "shadow": true
  },
  {
   "unit": "U247",
   "text": "오는 것 같다.\"",
   "pos": "center",
   "box": false,
   "shadow": true
  },
  {
   "unit": "U248",
   "text": "저는 이 말 중에서",
   "pos": "center"
  },
  {
   "unit": "U249",
   "text": "'[열심히 살고 있는데도]'라는",
   "pos": "center"
  },
  {
   "unit": "U250",
   "text": "부분이 유독 마음에 오래 남더라고요.",
   "pos": "center"
  },
  {
   "unit": "U251",
   "text": "번아웃은 게을러서 오는 게 아니라,"
  },
  {
   "unit": "U252",
   "text": "열심히 사는 사람에게도"
  },
  {
   "unit": "U253",
   "text": "찾아올 수 있다는 말처럼 들렸거든요."
  },
  {
   "unit": "U254",
   "text": "번아웃이라는 이름을 처음 붙인"
  },
  {
   "unit": "U255",
   "text": "프로이덴버거가 그랬던 것처럼요."
  },
  {
   "unit": "U256",
   "text": "혹시 지금 이 이야기가",
   "pos": "center"
  },
  {
   "unit": "U257",
   "text": "본인의 얘기처럼 들리셨다면,",
   "pos": "center"
  },
  {
   "unit": "U258",
   "text": "이어서 말씀드릴",
   "pos": "center"
  },
  {
   "unit": "U259",
   "text": "번아웃을 극복하는 작은 방법 [2가지]를",
   "pos": "center"
  },
  {
   "unit": "U260",
   "text": "가볍게 기억해 주세요.",
   "pos": "center"
  },
  {
   "unit": "U261",
   "text": "첫 번째는,",
   "box": false
  },
  {
   "unit": "U262",
   "text": "오늘 내 에너지가 [10점 만점]에",
   "box": false
  },
  {
   "unit": "U263",
   "text": "몇 점인지 메모해 보는 거예요.",
   "box": false
  },
  {
   "unit": "U264",
   "text": "아침에 한 번,"
  },
  {
   "unit": "U265",
   "text": "퇴근하고 한 번이면 충분하고,"
  },
  {
   "unit": "U266",
   "text": "이유를 길게 적을 필요도 없습니다."
  },
  {
   "unit": "U267",
   "text": "그냥 [숫자 하나]면 돼요.",
   "pos": "center"
  },
  {
   "unit": "U268",
   "text": "이렇게 며칠만 적어 봐도",
   "box": false
  },
  {
   "unit": "U269",
   "text": "유독 점수가 낮아지는 날이",
   "box": false
  },
  {
   "unit": "U270",
   "text": "눈에 들어오기 시작합니다.",
   "box": false
  },
  {
   "unit": "U271",
   "text": "'아, 월요일 회의가 있는 날은",
   "box": false
  },
  {
   "unit": "U272",
   "text": "늘 3점이네' 하고요.",
   "box": false
  },
  {
   "unit": "U273",
   "text": "이런 흐름이 눈에 보이면,"
  },
  {
   "unit": "U274",
   "text": "정체를 알 수 없던 막연한 피로가"
  },
  {
   "unit": "U275",
   "text": "조금씩 다룰 수 있는"
  },
  {
   "unit": "U276",
   "text": "구체적인 문제로 바뀝니다."
  },
  {
   "unit": "U277",
   "text": "두 번째는,",
   "box": false
  },
  {
   "unit": "U278",
   "text": "아까 말씀드린 6가지 일터의 조건을",
   "box": false
  },
  {
   "unit": "U279",
   "text": "떠올려 보고,",
   "box": false
  },
  {
   "unit": "U280",
   "text": "그중 지금 나와 가장 크게 어긋나 있는 것",
   "box": false
  },
  {
   "unit": "U281",
   "text": "[하나만] 골라 적어 보는 거예요.",
   "box": false
  },
  {
   "unit": "U282",
   "text": "업무량인지, 보상인지,",
   "box": false
  },
  {
   "unit": "U283",
   "text": "아니면 함께 일하는",
   "box": false
  },
  {
   "unit": "U284",
   "text": "사람인지 짚어 보는 거죠.",
   "box": false
  },
  {
   "unit": "U285",
   "text": "나를 지치게 하는 원인을"
  },
  {
   "unit": "U286",
   "text": "딱 하나만 짚어 봐도,"
  },
  {
   "unit": "U287",
   "text": "이게 내 의지 탓만은"
  },
  {
   "unit": "U288",
   "text": "아니라는 걸 알게 됩니다."
  },
  {
   "unit": "U289",
   "text": "그리고 저는 그걸 아는 것부터가"
  },
  {
   "unit": "U290",
   "text": "자책을 멈추고 회복을 고민하는"
  },
  {
   "unit": "U291",
   "text": "첫걸음이 될 수 있다고 생각해요."
  },
  {
   "unit": "U292",
   "text": "주말 내내 자고도"
  },
  {
   "unit": "U293",
   "text": "알람을 끄고 다시 눕게 되는 아침."
  },
  {
   "unit": "U294",
   "text": "그 무거운 아침은 어쩌면 게으름이 아니라,",
   "box": false
  },
  {
   "unit": "U295",
   "text": "그동안 오래 닳아 온",
   "box": false
  },
  {
   "unit": "U296",
   "text": "내 마음의 [배터리]를",
   "box": false
  },
  {
   "unit": "U297",
   "text": "보여 주는 건지도 모릅니다.",
   "box": false
  },
  {
   "unit": "U298",
   "text": "지금 번아웃을 이겨 내려고"
  },
  {
   "unit": "U299",
   "text": "애쓰는 중이시라면"
  },
  {
   "unit": "U300",
   "text": "이 말을 꼭 전하고 싶습니다."
  },
  {
   "unit": "U301",
   "text": "주말 내내 쉬었는데도 그대로인 건,"
  },
  {
   "unit": "U302",
   "text": "여러분이 극복을 못 해서가"
  },
  {
   "unit": "U303",
   "text": "아닐 수 있다고요."
  },
  {
   "unit": "U304",
   "text": "당신은 게을러진 게 아니라,",
   "pos": "center"
  },
  {
   "unit": "U305",
   "text": "그만큼 오랫동안 [애써 온] 거라고요.",
   "pos": "center"
  },
  {
   "unit": "U306",
   "text": "쉬어도 풀리지 않는 피로가"
  },
  {
   "unit": "U307",
   "text": "왜 의지의 문제가 아닐 수 있는지,"
  },
  {
   "unit": "U308",
   "text": "그리고 지금 내 상태를"
  },
  {
   "unit": "U309",
   "text": "어떻게 점검해 볼 수 있는지,"
  },
  {
   "unit": "U310",
   "text": "오늘 이야기가 그걸 아는 데"
  },
  {
   "unit": "U311",
   "text": "작은 도움이 되었으면 좋겠습니다."
  }
 ]
}