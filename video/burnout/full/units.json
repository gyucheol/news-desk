[
 {
  "id": "U001",
  "text": "주말 내내 분명 푹 잤는데,"
 },
 {
  "id": "U002",
  "text": "월요일 아침 알람을 끄고"
 },
 {
  "id": "U003",
  "text": "또 그대로 눕게 됩니다."
 },
 {
  "id": "U004",
  "text": "'이번 주말엔 진짜 아무것도"
 },
 {
  "id": "U005",
  "text": "안 하고 쉬었는데,"
 },
 {
  "id": "U006",
  "text": "왜 몸이 그대로지?'"
 },
 {
  "id": "U007",
  "text": "번아웃을 이겨 내 보려고"
 },
 {
  "id": "U008",
  "text": "나름대로 쉬어 봤는데도"
 },
 {
  "id": "U009",
  "text": "좀처럼 나아지질 않아서,"
 },
 {
  "id": "U010",
  "text": "혹시 '내가 그냥 게을러서 그런가' 하고"
 },
 {
  "id": "U011",
  "text": "자책하고 계셨나요?"
 },
 {
  "id": "U012",
  "text": "그렇다면 오늘 이야기가"
 },
 {
  "id": "U012b",
  "text": "그 질문의 답을 찾는 데"
 },
 {
  "id": "U013",
  "text": "작은 힌트가 될지도 모르겠습니다."
 },
 {
  "id": "U014",
  "text": "분명 쉬었는데도 피로가"
 },
 {
  "id": "U015",
  "text": "왜 잘 풀리지 않는지,"
 },
 {
  "id": "U016",
  "text": "그리고 그게 왜 내 게으름 탓이"
 },
 {
  "id": "U017",
  "text": "아닐 수 있는지 하나씩"
 },
 {
  "id": "U018",
  "text": "차근차근 이야기해 볼게요."
 },
 {
  "id": "U019",
  "text": "출근길에 업무 메일 알림이 하나 뜹니다."
 },
 {
  "id": "U020",
  "text": "아직 열어 보지도 않았는데"
 },
 {
  "id": "U021",
  "text": "한숨부터 푹 나오죠."
 },
 {
  "id": "U022",
  "text": "회사에서 동료가 말을 걸어와도"
 },
 {
  "id": "U023",
  "text": "맞장구칠 힘이 잘 나질 않습니다."
 },
 {
  "id": "U024",
  "text": "퇴근길엔 아침까지만 해도"
 },
 {
  "id": "U025",
  "text": "가려고 했던 운동을"
 },
 {
  "id": "U026",
  "text": "슬그머니 접어요."
 },
 {
  "id": "U027",
  "text": "'아, 오늘은 너무 피곤하니까"
 },
 {
  "id": "U028",
  "text": "내일 하자.'"
 },
 {
  "id": "U029",
  "text": "집에 와서는 아무 영상이나 틀어 놓고"
 },
 {
  "id": "U030",
  "text": "휴대폰 화면만 멍하니 들여다보는데,"
 },
 {
  "id": "U031",
  "text": "한참을 보고 나서도"
 },
 {
  "id": "U032",
  "text": "방금 뭘 봤는지 기억이 잘 안 납니다."
 },
 {
  "id": "U033",
  "text": "그렇게 겨우 금요일이 오면,"
 },
 {
  "id": "U034",
  "text": "'그래도 이번 주말엔 푹 쉬면"
 },
 {
  "id": "U035",
  "text": "괜찮아지겠지' 하고 기대하게 되죠."
 },
 {
  "id": "U036",
  "text": "토요일엔 늦잠을 자고,"
 },
 {
  "id": "U037",
  "text": "일요일엔 하루 종일 누워만 있었습니다."
 },
 {
  "id": "U038",
  "text": "정말 아무것도 안 하고 쉬기만 했어요."
 },
 {
  "id": "U039",
  "text": "그런데 참 이상하죠."
 },
 {
  "id": "U040",
  "text": "일요일 저녁만 되면 마음이"
 },
 {
  "id": "U041",
  "text": "다시 쿵 무거워집니다."
 },
 {
  "id": "U042",
  "text": "'아, 내일 또 출근이네.'"
 },
 {
  "id": "U043",
  "text": "혹시 여러분도 일요일"
 },
 {
  "id": "U044",
  "text": "저녁 여섯 시쯤만 되면"
 },
 {
  "id": "U045",
  "text": "이런 기분이 슬슬 올라오지 않으시나요?"
 },
 {
  "id": "U046",
  "text": "바로 이런 상태를 부르는 이름이"
 },
 {
  "id": "U047",
  "text": "우리가 잘 아는 '번아웃'입니다."
 },
 {
  "id": "U048",
  "text": "심리학에서 이 말을 처음 쓴 사람은"
 },
 {
  "id": "U049",
  "text": "미국의 심리학자"
 },
 {
  "id": "U050",
  "text": "허버트 프로이덴버거인데요."
 },
 {
  "id": "U051",
  "text": "천구백칠십 년대 뉴욕에서 일하던 그는"
 },
 {
  "id": "U052",
  "text": "누구보다 열정과 사명감이"
 },
 {
  "id": "U053",
  "text": "넘치는 사람이었습니다."
 },
 {
  "id": "U054",
  "text": "낮에는 자기 상담실에서"
 },
 {
  "id": "U055",
  "text": "열두 시간 동안 환자들을 돌보고,"
 },
 {
  "id": "U056",
  "text": "밤이 되면 형편이 어려운 사람들을 돕겠다며"
 },
 {
  "id": "U057",
  "text": "무료 진료소로 건너가"
 },
 {
  "id": "U058",
  "text": "새벽 두 시까지 일하곤 했죠."
 },
 {
  "id": "U059",
  "text": "몸이 부서져라 일하면서도"
 },
 {
  "id": "U060",
  "text": "본인은 괜찮다고 생각했습니다."
 },
 {
  "id": "U061",
  "text": "그러다 사단이 난 건,"
 },
 {
  "id": "U062",
  "text": "모처럼 가족들과 크리스마스 여행을"
 },
 {
  "id": "U063",
  "text": "떠나기로 한 아침이었어요."
 },
 {
  "id": "U064",
  "text": "일에서 손을 놓고 긴장이 풀리자마자,"
 },
 {
  "id": "U065",
  "text": "그동안 쌓였던 피로가"
 },
 {
  "id": "U066",
  "text": "한꺼번에 덮친 겁니다."
 },
 {
  "id": "U067",
  "text": "그는 그날 아침 침대에서"
 },
 {
  "id": "U068",
  "text": "손가락 하나 까딱하지 못했고,"
 },
 {
  "id": "U069",
  "text": "결국 약속했던 여행을 가지 못한 채"
 },
 {
  "id": "U070",
  "text": "며칠 내내 앓아누웠습니다."
 },
 {
  "id": "U071",
  "text": "충격을 받은 그는"
 },
 {
  "id": "U072",
  "text": "자신이 왜 이렇게 무너졌는지"
 },
 {
  "id": "U073",
  "text": "알아내기 위해 녹음기를 켰습니다."
 },
 {
  "id": "U074",
  "text": "매일 한두 시간씩"
 },
 {
  "id": "U075",
  "text": "지금 자기가 느끼는 피로감과 짜증,"
 },
 {
  "id": "U076",
  "text": "공허함을 있는 그대로 녹음한 뒤"
 },
 {
  "id": "U077",
  "text": "다시 돌려 들어 본 거예요."
 },
 {
  "id": "U078",
  "text": "거기엔 평소 따뜻하던 자신의 모습 대신,"
 },
 {
  "id": "U079",
  "text": "완전히 지쳐서 날이 서 있는"
 },
 {
  "id": "U080",
  "text": "낯선 목소리가 담겨 있었습니다."
 },
 {
  "id": "U081",
  "text": "그는 진료소에서 함께 일하던"
 },
 {
  "id": "U082",
  "text": "동료들을 떠올렸어요."
 },
 {
  "id": "U083",
  "text": "가만히 돌아보니,"
 },
 {
  "id": "U084",
  "text": "처음에 가장 뜨겁게 헌신하던"
 },
 {
  "id": "U085",
  "text": "동료들일수록 가장 먼저"
 },
 {
  "id": "U086",
  "text": "지치고, 예민해지고,"
 },
 {
  "id": "U087",
  "text": "결국엔 차갑고 냉소적으로"
 },
 {
  "id": "U088",
  "text": "변해 가고 있었던 겁니다."
 },
 {
  "id": "U089",
  "text": "마치 연료를 끝까지 다 태워버리고"
 },
 {
  "id": "U090",
  "text": "잿더미만 남은 것처럼요."
 },
 {
  "id": "U091",
  "text": "그는 천구백칠십사 년 논문에서,"
 },
 {
  "id": "U092",
  "text": "이렇게 열정을 다 태우고"
 },
 {
  "id": "U093",
  "text": "텅 비어버린 상태를"
 },
 {
  "id": "U094",
  "text": "처음으로 '번아웃'이라고 불렀습니다."
 },
 {
  "id": "U095",
  "text": "여기서 우리가"
 },
 {
  "id": "U096",
  "text": "꼭 눈여겨봐야 할 점이 있어요."
 },
 {
  "id": "U097",
  "text": "번아웃이라는 말을 만든 사람도,"
 },
 {
  "id": "U098",
  "text": "그가 지켜본 동료들도"
 },
 {
  "id": "U099",
  "text": "결코 게으른 사람들이 아니었다는 겁니다."
 },
 {
  "id": "U100",
  "text": "오히려 누구보다 책임감이 강하고,"
 },
 {
  "id": "U101",
  "text": "가장 열심히 애쓰던 사람들이"
 },
 {
  "id": "U102",
  "text": "제일 먼저 번아웃에 빠졌다는 거죠."
 },
 {
  "id": "U103",
  "text": "그로부터 한참 뒤인 이천십구 년,"
 },
 {
  "id": "U104",
  "text": "세계보건기구는 번아웃을"
 },
 {
  "id": "U105",
  "text": "'제대로 관리되지 않은"
 },
 {
  "id": "U106",
  "text": "만성적인 직장 스트레스에서 생기는 증후군'"
 },
 {
  "id": "U107",
  "text": "이라고 정의했습니다."
 },
 {
  "id": "U108",
  "text": "쉽게 말해, 일 때문에 쌓인 스트레스가"
 },
 {
  "id": "U109",
  "text": "오랫동안 풀리지 못해서"
 },
 {
  "id": "U110",
  "text": "생긴 상태라는 거예요."
 },
 {
  "id": "U111",
  "text": "흥미로운 건,"
 },
 {
  "id": "U112",
  "text": "세계보건기구가 번아웃을"
 },
 {
  "id": "U113",
  "text": "개인의 질병으로"
 },
 {
  "id": "U114",
  "text": "분류하지 않았다는 점입니다."
 },
 {
  "id": "U115",
  "text": "대신 일과 관련된 현상으로 분류했고,"
 },
 {
  "id": "U116",
  "text": "직장이라는 맥락에서만 쓰는 말이라고"
 },
 {
  "id": "U117",
  "text": "분명히 선을 그어 두었죠."
 },
 {
  "id": "U118",
  "text": "저는 이 번아웃을 휴대폰에"
 },
 {
  "id": "U119",
  "text": "한 번 비유해 보고 싶습니다."
 },
 {
  "id": "U120",
  "text": "충전하는 속도보다"
 },
 {
  "id": "U121",
  "text": "배터리가 닳는 속도가 더 빠른"
 },
 {
  "id": "U122",
  "text": "휴대폰 말이에요."
 },
 {
  "id": "U123",
  "text": "이런 휴대폰은"
 },
 {
  "id": "U124",
  "text": "하룻밤 충전기를 꽂아 둔다고 해서"
 },
 {
  "id": "U125",
  "text": "문제가 해결되지 않습니다."
 },
 {
  "id": "U126",
  "text": "보이지 않는 곳에서 배터리를 빼 가는"
 },
 {
  "id": "U127",
  "text": "무언가가 여전히 켜져 있으니까요."
 },
 {
  "id": "U128",
  "text": "세계보건기구는 번아웃의 특징을"
 },
 {
  "id": "U129",
  "text": "크게 세 가지로 설명합니다."
 },
 {
  "id": "U130",
  "text": "먼저 번아웃의 첫 번째 신호는"
 },
 {
  "id": "U131",
  "text": "에너지가 바닥나는 겁니다."
 },
 {
  "id": "U132",
  "text": "토요일에 열 시간을 자고"
 },
 {
  "id": "U133",
  "text": "일요일엔 낮잠까지 잤는데도,"
 },
 {
  "id": "U134",
  "text": "월요일 아침이면 몸이 여전히 무겁습니다."
 },
 {
  "id": "U135",
  "text": "'이 정도 쉬었으면"
 },
 {
  "id": "U136",
  "text": "괜찮아야 하는데' 싶다가도,"
 },
 {
  "id": "U137",
  "text": "어느새 자책이 따라오죠."
 },
 {
  "id": "U138",
  "text": "'남들은 주말에"
 },
 {
  "id": "U139",
  "text": "운동도 하고 공부도 한다는데,"
 },
 {
  "id": "U140",
  "text": "나는 왜 누워만 있지?'"
 },
 {
  "id": "U141",
  "text": "보통의 피로는 푹 쉬고 나면"
 },
 {
  "id": "U142",
  "text": "어느 정도 풀리지만,"
 },
 {
  "id": "U143",
  "text": "번아웃의 피로는 아무리 쉬어도"
 },
 {
  "id": "U144",
  "text": "잘 채워지지 않는다고"
 },
 {
  "id": "U145",
  "text": "느끼는 경우가 많습니다."
 },
 {
  "id": "U146",
  "text": "그럼 게으름과는 뭐가 다를까요?"
 },
 {
  "id": "U147",
  "text": "게으름이 '하기 싫은 마음'에 가깝다면,"
 },
 {
  "id": "U148",
  "text": "번아웃은 '하고 싶어도"
 },
 {
  "id": "U149",
  "text": "꺼내 쓸 힘이 남아 있지 않은 상태'에"
 },
 {
  "id": "U150",
  "text": "가깝습니다."
 },
 {
  "id": "U151",
  "text": "그러니까 이건 마음가짐의 문제가 아니라,"
 },
 {
  "id": "U152",
  "text": "바닥난 연료의 문제인 거죠."
 },
 {
  "id": "U153",
  "text": "번아웃의 두 번째 신호는"
 },
 {
  "id": "U154",
  "text": "일과 내 마음 사이의 거리가"
 },
 {
  "id": "U155",
  "text": "점점 멀어지는 겁니다."
 },
 {
  "id": "U156",
  "text": "회의에서 새로운 의견이 나오면,"
 },
 {
  "id": "U157",
  "text": "예전 같았으면 같이 고민했을 텐데"
 },
 {
  "id": "U158",
  "text": "요즘은 '어차피 해도 안 바뀌어'라는"
 },
 {
  "id": "U159",
  "text": "생각부터 듭니다."
 },
 {
  "id": "U160",
  "text": "메신저에 팀장님 이름만 떠도"
 },
 {
  "id": "U161",
  "text": "가슴이 답답해지고,"
 },
 {
  "id": "U162",
  "text": "점심은 그냥 혼자 먹고 싶어지죠."
 },
 {
  "id": "U165",
  "text": "세계보건기구는 이런 모습을"
 },
 {
  "id": "U166",
  "text": "일에 대한 '심리적 거리감',"
 },
 {
  "id": "U167",
  "text": "혹은 '냉소'라고 설명합니다."
 },
 {
  "id": "U168",
  "text": "이게 게으름과 다른 건,"
 },
 {
  "id": "U169",
  "text": "처음부터 일에 관심이 없었던 게"
 },
 {
  "id": "U170",
  "text": "아니라는 점이에요."
 },
 {
  "id": "U171",
  "text": "너무 오랫동안 애쓰다 보니,"
 },
 {
  "id": "U172",
  "text": "지친 마음이 상처받지 않으려고"
 },
 {
  "id": "U173",
  "text": "스스로 한 발 물러나 버린"
 },
 {
  "id": "U174",
  "text": "쪽에 가깝습니다."
 },
 {
  "id": "U175",
  "text": "원래 무관심했던 게 아니라,"
 },
 {
  "id": "U176",
  "text": "지친 마음이 스스로 거리를 두는 거죠."
 },
 {
  "id": "U177",
  "text": "번아웃의 세 번째 신호는"
 },
 {
  "id": "U178",
  "text": "내가 일을 잘 해내고 있다는 느낌이"
 },
 {
  "id": "U179",
  "text": "부쩍 줄어드는 겁니다."
 },
 {
  "id": "U180",
  "text": "분명 작년엔 칭찬까지 받았던 보고서인데,"
 },
 {
  "id": "U181",
  "text": "올해는 쓰는 내내 자신이 없어요."
 },
 {
  "id": "U182",
  "text": "빈 파일을 열어 놓고"
 },
 {
  "id": "U183",
  "text": "한 시간째 첫 문장만 고치고 있죠."
 },
 {
  "id": "U184",
  "text": "'나 원래 이 일 잘하던 사람 맞나?'"
 },
 {
  "id": "U185",
  "text": "싶고, 작은 실수 하나에도"
 },
 {
  "id": "U186",
  "text": "내가 무능한 사람처럼 느껴집니다."
 },
 {
  "id": "U187",
  "text": "세계보건기구는 이걸 '직업적 효능감',"
 },
 {
  "id": "U188",
  "text": "그러니까 내가 해낼 수 있다는 믿음이"
 },
 {
  "id": "U189",
  "text": "줄어드는 거라고 표현합니다."
 },
 {
  "id": "U190",
  "text": "그런데 이것도 내 능력이 없어서"
 },
 {
  "id": "U191",
  "text": "생기는 일이 아니에요."
 },
 {
  "id": "U192",
  "text": "오히려 잘하고 싶은 마음이"
 },
 {
  "id": "U193",
  "text": "아직 남아 있으니까 더 괴로운 겁니다."
 },
 {
  "id": "U194",
  "text": "내 능력이 사라진 게 아니라,"
 },
 {
  "id": "U195",
  "text": "내 능력을 느끼고 발휘할 힘이"
 },
 {
  "id": "U196",
  "text": "줄어든 거예요."
 },
 {
  "id": "U197",
  "text": "그렇다면 번아웃은 푹 쉬면 나아질까요?"
 },
 {
  "id": "U198",
  "text": "흔히들 그렇게 생각하지만,"
 },
 {
  "id": "U199",
  "text": "휴가에 관한 연구들은"
 },
 {
  "id": "U200",
  "text": "조금 다른 이야기를 들려줍니다."
 },
 {
  "id": "U201",
  "text": "이천구 년, 한 연구진이"
 },
 {
  "id": "U202",
  "text": "휴가의 효과를 다룬 연구 일곱 편을"
 },
 {
  "id": "U203",
  "text": "모아서 분석했는데요."
 },
 {
  "id": "U204",
  "text": "휴가는 분명 건강과 행복감을 높여 줬지만,"
 },
 {
  "id": "U205",
  "text": "일터로 돌아가자마자"
 },
 {
  "id": "U206",
  "text": "그 효과는 금방 사라졌습니다."
 },
 {
  "id": "U207",
  "text": "같은 연구진이 더 많은 연구를"
 },
 {
  "id": "U208",
  "text": "모아 다시 분석했을 때도"
 },
 {
  "id": "U209",
  "text": "결과는 비슷했어요."
 },
 {
  "id": "U210",
  "text": "직장에 복귀하고 첫 주가 지나면"
 },
 {
  "id": "U211",
  "text": "휴가 전과 큰 차이가 없었고,"
 },
 {
  "id": "U212",
  "text": "휴가를 길게 다녀온다고 해서"
 },
 {
  "id": "U213",
  "text": "그 효과가 더 커지지도 않았습니다."
 },
 {
  "id": "U214",
  "text": "도대체 왜 그럴까요?"
 },
 {
  "id": "U215",
  "text": "매슬랙과 동료 연구자 마이클 라이터는"
 },
 {
  "id": "U216",
  "text": "번아웃의 진짜 원인을"
 },
 {
  "id": "U217",
  "text": "개인보다 일터에서 찾았습니다."
 },
 {
  "id": "U218",
  "text": "업무량,"
 },
 {
  "id": "U219",
  "text": "일을 내 방식대로 해 나갈 수 있는 정도,"
 },
 {
  "id": "U220",
  "text": "보상, 함께 일하는 사람들,"
 },
 {
  "id": "U221",
  "text": "공정함, 그리고 가치관."
 },
 {
  "id": "U222",
  "text": "이 여섯 가지가 나와 계속 어긋날 때"
 },
 {
  "id": "U223",
  "text": "번아웃이 생기기 쉽다고 본 거죠."
 },
 {
  "id": "U224",
  "text": "물론 지쳤을 때 쉬는 건 꼭 필요합니다."
 },
 {
  "id": "U225",
  "text": "하지만 배터리를 닳게 하는"
 },
 {
  "id": "U226",
  "text": "원인이 일터에 그대로 있다면,"
 },
 {
  "id": "U227",
  "text": "다시 돌아가는 순간 배터리는"
 },
 {
  "id": "U228",
  "text": "또 닳기 시작할 거예요."
 },
 {
  "id": "U229",
  "text": "바로 이 때문에"
 },
 {
  "id": "U229b",
  "text": "번아웃을"
 },
 {
  "id": "U230",
  "text": "개인의 의지만의 문제로 보기는"
 },
 {
  "id": "U230b",
  "text": "어렵습니다."
 },
 {
  "id": "U231",
  "text": "이쯤에서"
 },
 {
  "id": "U231b",
  "text": "한 사람의"
 },
 {
  "id": "U232",
  "text": "실제 이야기를"
 },
 {
  "id": "U232b",
  "text": "들려드릴게요."
 },
 {
  "id": "U233",
  "text": "작년 십이월, 한 언론 기사에"
 },
 {
  "id": "U234",
  "text": "서른한 살 직장인"
 },
 {
  "id": "U235",
  "text": "박 모 씨의 이야기가 실렸습니다."
 },
 {
  "id": "U236",
  "text": "그는 처음엔 자기 상태가"
 },
 {
  "id": "U237",
  "text": "번아웃이라는 걸 몰랐다고 해요."
 },
 {
  "id": "U238",
  "text": "출근하면 일할 의욕이 없고,"
 },
 {
  "id": "U239",
  "text": "퇴근해서 취미를 하나"
 },
 {
  "id": "U240",
  "text": "만들어보려고 해도"
 },
 {
  "id": "U241",
  "text": "너무 피곤해서 잠만 자는 날이"
 },
 {
  "id": "U241b",
  "text": "계속 이어졌다고 합니다."
 },
 {
  "id": "U242",
  "text": "그리고 기사에서 당시의 마음을"
 },
 {
  "id": "U243",
  "text": "이렇게 말했어요."
 },
 {
  "id": "U244",
  "text": "\"열심히 살고 있는데도"
 },
 {
  "id": "U245",
  "text": "늘 부족하다고 느끼는 감정이 쌓이다,"
 },
 {
  "id": "U246",
  "text": "결국 감당이 안 되는 지점이"
 },
 {
  "id": "U247",
  "text": "오는 것 같다.\""
 },
 {
  "id": "U248",
  "text": "저는 이 말 중에서"
 },
 {
  "id": "U249",
  "text": "'열심히 살고 있는데도'"
 },
 {
  "id": "U250",
  "text": "라는 부분이"
 },
 {
  "id": "U250b",
  "text": "유독 마음에 오래 남더라고요."
 },
 {
  "id": "U251",
  "text": "번아웃은 게을러서 오는 게 아니라,"
 },
 {
  "id": "U252",
  "text": "열심히 사는 사람에게도"
 },
 {
  "id": "U253",
  "text": "찾아올 수 있다는 말처럼 들렸거든요."
 },
 {
  "id": "U254",
  "text": "번아웃이라는 이름을 처음 붙인"
 },
 {
  "id": "U255",
  "text": "프로이덴버거가 그랬던 것처럼요."
 },
 {
  "id": "U256",
  "text": "혹시 지금 이 이야기가"
 },
 {
  "id": "U257",
  "text": "본인의 얘기처럼 들리셨다면,"
 },
 {
  "id": "U258",
  "text": "이어서 말씀드릴"
 },
 {
  "id": "U259",
  "text": "번아웃을 극복하는 작은 방법 두 가지를"
 },
 {
  "id": "U260",
  "text": "가볍게 기억해 주세요."
 },
 {
  "id": "U261",
  "text": "첫 번째는,"
 },
 {
  "id": "U262",
  "text": "오늘 내 에너지가 십 점 만점에"
 },
 {
  "id": "U263",
  "text": "몇 점인지 메모해 보는 거예요."
 },
 {
  "id": "U264",
  "text": "아침에 한 번,"
 },
 {
  "id": "U265",
  "text": "퇴근하고 한 번이면 충분하고,"
 },
 {
  "id": "U266",
  "text": "이유를 길게 적을 필요도 없습니다."
 },
 {
  "id": "U267",
  "text": "그냥 숫자 하나면 돼요."
 },
 {
  "id": "U268",
  "text": "이렇게 며칠만 적어 봐도"
 },
 {
  "id": "U269",
  "text": "유독 점수가 낮아지는 날이"
 },
 {
  "id": "U270",
  "text": "눈에 들어오기 시작합니다."
 },
 {
  "id": "U271",
  "text": "'아, 월요일 회의가 있는 날은"
 },
 {
  "id": "U272",
  "text": "늘 삼 점이네' 하고요."
 },
 {
  "id": "U273",
  "text": "이런 흐름이 눈에 보이면,"
 },
 {
  "id": "U274",
  "text": "정체를 알 수 없던 막연한 피로가"
 },
 {
  "id": "U275",
  "text": "조금씩 다룰 수 있는"
 },
 {
  "id": "U276",
  "text": "구체적인 문제로 바뀝니다."
 },
 {
  "id": "U277",
  "text": "두 번째는,"
 },
 {
  "id": "U278",
  "text": "아까 말씀드린 여섯 가지 일터의 조건을"
 },
 {
  "id": "U279",
  "text": "떠올려 보고,"
 },
 {
  "id": "U280",
  "text": "그중 지금 나와 가장 크게 어긋나 있는 것"
 },
 {
  "id": "U281",
  "text": "하나만 골라 적어 보는 거예요."
 },
 {
  "id": "U282",
  "text": "업무량인지, 보상인지,"
 },
 {
  "id": "U283",
  "text": "아니면 함께 일하는"
 },
 {
  "id": "U284",
  "text": "사람인지 짚어 보는 거죠."
 },
 {
  "id": "U285",
  "text": "나를 지치게 하는 원인을"
 },
 {
  "id": "U286",
  "text": "딱 하나만 짚어 봐도,"
 },
 {
  "id": "U287",
  "text": "이게 내 의지 탓만은"
 },
 {
  "id": "U288",
  "text": "아니라는 걸 알게 됩니다."
 },
 {
  "id": "U289",
  "text": "그리고 저는 그걸 아는 것부터가"
 },
 {
  "id": "U290",
  "text": "자책을 멈추고 회복을 고민하는"
 },
 {
  "id": "U291",
  "text": "첫걸음이 될 수 있다고 생각해요."
 },
 {
  "id": "U292",
  "text": "주말 내내 자고도"
 },
 {
  "id": "U293",
  "text": "알람을 끄고 다시 눕게 되는 아침."
 },
 {
  "id": "U294",
  "text": "그 무거운 아침은 어쩌면 게으름이 아니라,"
 },
 {
  "id": "U295",
  "text": "그동안 오래 닳아 온"
 },
 {
  "id": "U296",
  "text": "내 마음의 배터리를"
 },
 {
  "id": "U297",
  "text": "보여 주는 건지도 모릅니다."
 },
 {
  "id": "U298",
  "text": "지금 번아웃을 이겨 내려고"
 },
 {
  "id": "U299",
  "text": "애쓰는 중이시라면"
 },
 {
  "id": "U300",
  "text": "이 말을 꼭 전하고 싶습니다."
 },
 {
  "id": "U301",
  "text": "주말 내내 쉬었는데도 그대로인 건,"
 },
 {
  "id": "U302",
  "text": "여러분이 극복을 못 해서가"
 },
 {
  "id": "U303",
  "text": "아닐 수 있다고요."
 },
 {
  "id": "U304",
  "text": "당신은 게을러진 게 아니라,"
 },
 {
  "id": "U305",
  "text": "그만큼 오랫동안 애써 온 거라고요."
 },
 {
  "id": "U306",
  "text": "쉬어도 풀리지 않는 피로가"
 },
 {
  "id": "U307",
  "text": "왜 의지의 문제가 아닐 수 있는지,"
 },
 {
  "id": "U308",
  "text": "그리고 지금 내 상태를"
 },
 {
  "id": "U309",
  "text": "어떻게 점검해 볼 수 있는지,"
 },
 {
  "id": "U310",
  "text": "오늘 이야기가 그걸 아는 데"
 },
 {
  "id": "U311",
  "text": "작은 도움이 되었으면 좋겠습니다."
 }
]