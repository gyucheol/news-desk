 "subs": [
  {
   "unit": "U01",
   "text": "주말 내내 분명 푹 잤는데,"
  },
  {
   "unit": "U02",
   "text": "월요일 아침 알람을 끄고"
  },
  {
   "unit": "U03",
   "text": "또 그대로 눕게 됩니다."
  },
  {
   "unit": "U04",
   "text": "'이번 주말엔 진짜 아무것도",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U05",
   "text": "안 하고 쉬었는데,",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U06",
   "text": "왜 몸이 그대로지?'",
   "pos": "center",
   "italic": true
  },
  {
   "unit": "U07",
   "text": "번아웃을 이겨 내 보려고"
  },
  {
   "unit": "U08",
   "text": "나름대로 쉬어 봤는데도"
  },
  {
   "unit": "U09",
   "text": "좀처럼 나아지질 않아서,"
  },
  {
   "unit": "U10",
   "text": "혹시 '내가 그냥 게을러서 그런가' 하고"
  },
  {
   "unit": "U11",
   "text": "자책하고 계셨나요?"
  },
  {
   "unit": "U12",
   "text": "그렇다면 오늘 이야기가",
   "box": false
  },
  {
   "unit": "U13",
   "text": "작은 힌트가 될지도 모르겠습니다.",
   "box": false
  },
  {
   "unit": "U14",
   "text": "분명 쉬었는데도 피로가",
   "box": false
  },
  {
   "unit": "U15",
   "text": "왜 잘 풀리지 않는지,",
   "box": false
  },
  {
   "unit": "U16",
   "text": "그리고 그게 왜 내 게으름 탓이"
  },
  {
   "unit": "U17",
   "text": "아닐 수 있는지 하나씩"
  },
  {
   "unit": "U18",
   "text": "차근차근 이야기해 볼게요."
  },
  {
   "unit": "U19",
   "text": "출근길에 업무 메일 알림이 하나 뜹니다."
  }
 ]
}