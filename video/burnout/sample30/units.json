[
 {"id": "U01", "text": "주말 내내 분명 푹 잤는데,"},
 {"id": "U02", "text": "월요일 아침 알람을 끄고"},
 {"id": "U03", "text": "또 그대로 눕게 됩니다."},
 {"id": "U04", "text": "'이번 주말엔 진짜 아무것도"},
 {"id": "U05", "text": "안 하고 쉬었는데,"},
 {"id": "U06", "text": "왜 몸이 그대로지?'"},
 {"id": "U07", "text": "번아웃을 이겨 내 보려고"},
 {"id": "U08", "text": "나름대로 쉬어 봤는데도"},
 {"id": "U09", "text": "좀처럼 나아지질 않아서,"},
 {"id": "U10", "text": "혹시 '내가 그냥 게을러서 그런가' 하고"},
 {"id": "U11", "text": "자책하고 계셨나요?"},
 {"id": "U12", "text": "그렇다면 오늘 이야기가"},
 {"id": "U13", "text": "작은 힌트가 될지도 모르겠습니다."},
