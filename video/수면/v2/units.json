[
 {
  "id": "V001",
  "text": "당신은 내일도"
 },
 {
  "id": "V002",
  "text": "아침 일곱 시에 일어나야 합니다."
 },
 {
  "id": "V003",
  "text": "휴대폰을 내려놓으려고"
 },
 {
  "id": "V004",
  "text": "시간을 보니 새벽 한 시입니다."
 },
 {
  "id": "V005",
  "text": "지금 자면 여섯 시간."
 },
 {
  "id": "V006",
  "text": "조금 짧은 것 같지만"
 },
 {
  "id": "V007",
  "text": "괜찮다고 생각합니다."
 },
 {
  "id": "V008",
  "text": "어제도 그만큼 잤고"
 },
 {
  "id": "V009",
  "text": "오늘도 별문제 없이"
 },
 {
  "id": "V010",
  "text": "하루를 보냈으니까요."
 },
 {
  "id": "V011",
  "text": "아침에는 일어나기 힘들어도"
 },
 {
  "id": "V012",
  "text": "씻고 출근해서"
 },
 {
  "id": "V013",
  "text": "커피를 마시면 일할 만해집니다."
 },
 {
  "id": "V014",
  "text": "가끔 머리가 멍하지만"
 },
 {
  "id": "V015",
  "text": "직장인이 다 그렇지 싶습니다."
 },
 {
  "id": "V016",
  "text": "그렇게 평일을 보내고"
 },
 {
  "id": "V017",
  "text": "토요일이 됩니다."
 },
 {
  "id": "V018",
  "text": "알람 없이 잠들었는데"
 },
 {
  "id": "V019",
  "text": "눈을 떠 보니 낮 열두 시입니다."
 },
 {
  "id": "V020",
  "text": "밥을 먹고 나니"
 },
 {
  "id": "V021",
  "text": "벌써 오후입니다."
 },
 {
  "id": "V022",
  "text": "쉬는 날이 아깝지만"
 },
 {
  "id": "V023",
  "text": "이렇게 생각합니다."
 },
 {
  "id": "V024",
  "text": "평일에 못 잔 잠을 몰아서 잤으니까"
 },
 {
  "id": "V025",
  "text": "이제 괜찮겠지."
 },
 {
  "id": "V026",
  "text": "그런데 월요일 아침이면"
 },
 {
  "id": "V027",
  "text": "다시 일어나기가 힘듭니다."
 },
 {
  "id": "V028",
  "text": "나는 정말 여섯 시간만 자도"
 },
 {
  "id": "V029",
  "text": "괜찮은 사람일까요?"
 },
 {
  "id": "V030",
  "text": "주말에 푹 자는데도"
 },
 {
  "id": "V031",
  "text": "왜 피곤함은 반복될까요?"
 },
 {
  "id": "V032",
  "text": "오늘은 이 두 가지 질문을 살펴보고"
 },
 {
  "id": "V033",
  "text": "잠자는 습관을 바꿔 볼"
 },
 {
  "id": "V034",
  "text": "방법 세 가지를"
 },
 {
  "id": "V035",
  "text": "이야기해 보겠습니다."
 },
 {
  "id": "V036",
  "text": "평일 오후"
 },
 {
  "id": "V037",
  "text": "당신은 회사에서 이메일을 읽고 있습니다."
 },
 {
  "id": "V038",
  "text": "같은 문장을 몇 번이나 읽고"
 },
 {
  "id": "V039",
  "text": "방금 확인한 숫자를 잊어"
 },
 {
  "id": "V040",
  "text": "앞의 화면으로 돌아갑니다."
 },
 {
  "id": "V041",
  "text": "집중이 잘 안 되지만"
 },
 {
  "id": "V042",
  "text": "눈이 감길 만큼 졸리지는 않습니다."
 },
 {
  "id": "V043",
  "text": "그래서 잠이 부족하다는 생각까지는"
 },
 {
  "id": "V044",
  "text": "하지 않습니다."
 },
 {
  "id": "V045",
  "text": "그런데 잠이 부족해도"
 },
 {
  "id": "V046",
  "text": "본인은 그 영향을"
 },
 {
  "id": "V047",
  "text": "충분히 알아차리지 못할 수 있습니다."
 },
 {
  "id": "V048",
  "text": "이천삼 년 반 동겐 연구팀은"
 },
 {
  "id": "V049",
  "text": "건강한 성인들을 세 집단으로 나누고"
 },
 {
  "id": "V050",
  "text": "매일 밤 잘 수 있는 시간을"
 },
 {
  "id": "V051",
  "text": "네 시간 여섯 시간 여덟 시간으로 정했습니다."
 },
 {
  "id": "V052",
  "text": "참가자들은 십사 일 동안"
 },
 {
  "id": "V053",
  "text": "이 일정에 맞춰 생활하면서"
 },
 {
  "id": "V054",
  "text": "주의력과 기억력 검사를"
 },
 {
  "id": "V055",
  "text": "반복해서 받았습니다."
 },
 {
  "id": "V056",
  "text": "화면에 신호가 나타나면"
 },
 {
  "id": "V057",
  "text": "빠르게 반응하는 검사 등이었습니다."
 },
 {
  "id": "V058",
  "text": "연구진은 검사 성적과 함께"
 },
 {
  "id": "V059",
  "text": "참가자들이 스스로 평가한"
 },
 {
  "id": "V060",
  "text": "졸림도 기록했습니다."
 },
 {
  "id": "V061",
  "text": "그리고 밤을 새운 별도 집단의"
 },
 {
  "id": "V062",
  "text": "검사 결과와 비교했습니다."
 },
 {
  "id": "V063",
  "text": "여섯 시간씩 자도록 한 집단에서는"
 },
 {
  "id": "V064",
  "text": "날이 지날수록"
 },
 {
  "id": "V065",
  "text": "신호에 제때 반응하지 못하는 경우가"
 },
 {
  "id": "V066",
  "text": "늘었습니다."
 },
 {
  "id": "V067",
  "text": "십사 일 뒤에는"
 },
 {
  "id": "V068",
  "text": "주의력과 일부 기억력 검사 성적이"
 },
 {
  "id": "V069",
  "text": "하룻밤을 꼬박 새운 집단의 성적과"
 },
 {
  "id": "V070",
  "text": "비슷한 수준까지 떨어졌습니다."
 },
 {
  "id": "V071",
  "text": "그런데 본인이 느끼는 졸림은"
 },
 {
  "id": "V072",
  "text": "그만큼 심해지지 않았습니다."
 },
 {
  "id": "V073",
  "text": "잠을 줄인 초기에는 졸림이 늘었지만"
 },
 {
  "id": "V074",
  "text": "그 뒤로는 검사 성적이"
 },
 {
  "id": "V075",
  "text": "계속 나빠지는 동안에도"
 },
 {
  "id": "V076",
  "text": "졸림이 크게 늘지 않았던 겁니다."
 },
 {
  "id": "V077",
  "text": "이 결과를 생각하면"
 },
 {
  "id": "V078",
  "text": "우리가 말하는 “괜찮다”의 기준도"
 },
 {
  "id": "V079",
  "text": "돌아볼 필요가 있습니다."
 },
 {
  "id": "V080",
  "text": "충분히 잤을 때처럼"
 },
 {
  "id": "V081",
  "text": "집중할 수 있다는 뜻일까요?"
 },
 {
  "id": "V082",
  "text": "아니면 어제만큼은"
 },
 {
  "id": "V083",
  "text": "버틸 수 있다는 뜻일까요?"
 },
 {
  "id": "V084",
  "text": "한동안 비슷하게 자 왔다면"
 },
 {
  "id": "V085",
  "text": "비교 대상인 어제의 나도"
 },
 {
  "id": "V086",
  "text": "잠이 부족한 상태였을 수 있습니다."
 },
 {
  "id": "V087",
  "text": "집중이 끊기는 이유는 여러 가지입니다."
 },
 {
  "id": "V088",
  "text": "다만 이런 일이 반복된다면"
 },
 {
  "id": "V089",
  "text": "직장인은 원래 피곤하지"
 },
 {
  "id": "V090",
  "text": "하고 넘기기 전에"
 },
 {
  "id": "V091",
  "text": "잠은 충분했는지도 확인해 봐야 합니다."
 },
 {
  "id": "V092",
  "text": "그러면 이렇게 생각할 수 있습니다."
 },
 {
  "id": "V093",
  "text": "평일에 부족한 건 맞아."
 },
 {
  "id": "V094",
  "text": "그래서 주말에 많이 자잖아."
 },
 {
  "id": "V095",
  "text": "평일에 덜 잔 만큼"
 },
 {
  "id": "V096",
  "text": "주말에 더 자면"
 },
 {
  "id": "V097",
  "text": "결국 비슷하지 않을까요?"
 },
 {
  "id": "V098",
  "text": "이천십구 년 데프너 연구팀은"
 },
 {
  "id": "V099",
  "text": "건강한 젊은 성인 서른여섯 명을"
 },
 {
  "id": "V100",
  "text": "세 집단으로 나눴습니다."
 },
 {
  "id": "V101",
  "text": "한 집단에는 매일 밤"
 },
 {
  "id": "V102",
  "text": "아홉 시간의 수면 기회를 줬고"
 },
 {
  "id": "V103",
  "text": "다른 집단에는 다섯 시간만 줬습니다."
 },
 {
  "id": "V104",
  "text": "나머지 집단은 처음 닷새 동안"
 },
 {
  "id": "V105",
  "text": "다섯 시간씩 자도록 한 뒤"
 },
 {
  "id": "V106",
  "text": "주말 이틀 동안"
 },
 {
  "id": "V107",
  "text": "자유롭게 잠을 보충하게 했습니다."
 },
 {
  "id": "V108",
  "text": "주말이 끝나면"
 },
 {
  "id": "V109",
  "text": "다시 짧게 자도록 했고요."
 },
 {
  "id": "V110",
  "text": "연구진은 이런 생활을 하면서"
 },
 {
  "id": "V111",
  "text": "식사량과 혈당 조절에 관련된 지표가"
 },
 {
  "id": "V112",
  "text": "어떻게 달라지는지 확인했습니다."
 },
 {
  "id": "V113",
  "text": "주말에 잠을 보충하는 동안에는"
 },
 {
  "id": "V114",
  "text": "저녁 식사 후 추가로 먹는 양이"
 },
 {
  "id": "V115",
  "text": "줄었습니다."
 },
 {
  "id": "V116",
  "text": "하지만 다시 잠을 줄이자"
 },
 {
  "id": "V117",
  "text": "먹는 양이 늘었고"
 },
 {
  "id": "V118",
  "text": "혈당을 조절하는 호르몬인"
 },
 {
  "id": "V119",
  "text": "인슐린에 몸이 반응하는 정도도"
 },
 {
  "id": "V120",
  "text": "실험 전보다 낮아졌습니다."
 },
 {
  "id": "V121",
  "text": "이 연구에서는"
 },
 {
  "id": "V122",
  "text": "주말에 잠을 보충하는 것만으로"
 },
 {
  "id": "V123",
  "text": "이런 변화를 막지 못했습니다."
 },
 {
  "id": "V124",
  "text": "주말에 더 자는 것이"
 },
 {
  "id": "V125",
  "text": "소용없다는 뜻은 아닙니다."
 },
 {
  "id": "V126",
  "text": "주말 이후 다시 잠을 줄이는 생활로"
 },
 {
  "id": "V127",
  "text": "돌아갔다는 점을 봐야 합니다."
 },
 {
  "id": "V128",
  "text": "우리도 주말에 얼마나 잤는지와 함께"
 },
 {
  "id": "V129",
  "text": "그다음 평일에 어떻게 자는지"
 },
 {
  "id": "V130",
  "text": "살펴볼 필요가 있습니다."
 },
 {
  "id": "V131",
  "text": "오늘도 조금만 더 보고 자자."
 },
 {
  "id": "V132",
  "text": "주말에 푹 자면 되니까."
 },
 {
  "id": "V133",
  "text": "이런 생각이 반복되면"
 },
 {
  "id": "V134",
  "text": "주말의 휴식이"
 },
 {
  "id": "V135",
  "text": "평일의 잠을 계속 미루는 이유가"
 },
 {
  "id": "V136",
  "text": "될 수 있습니다."
 },
 {
  "id": "V137",
  "text": "그렇다면"
 },
 {
  "id": "V138",
  "text": "무엇부터 바꿔 보면 좋을까요?"
 },
 {
  "id": "V139",
  "text": "첫째."
 },
 {
  "id": "V140",
  "text": "평일과 주말에 어떻게 자는지"
 },
 {
  "id": "V141",
  "text": "일주일 정도 기록해 보세요."
 },
 {
  "id": "V142",
  "text": "잠자리에 든 시각"
 },
 {
  "id": "V143",
  "text": "대략 잠든 시각"
 },
 {
  "id": "V144",
  "text": "아침에 일어난 시각을 적어 보는 겁니다."
 },
 {
  "id": "V145",
  "text": "밤중에 오래 깨어 있었거나"
 },
 {
  "id": "V146",
  "text": "낮잠을 잤다면"
 },
 {
  "id": "V147",
  "text": "그것도 함께 남겨 보세요."
 },
 {
  "id": "V148",
  "text": "밤마다 시계를 확인하지 말고"
 },
 {
  "id": "V149",
  "text": "다음 날 아침 기억나는 범위에서"
 },
 {
  "id": "V150",
  "text": "적으면 됩니다."
 },
 {
  "id": "V151",
  "text": "누워서 휴대폰을 본 시간까지"
 },
 {
  "id": "V152",
  "text": "잠잔 시간으로 세고 있지는 않았는지"
 },
 {
  "id": "V153",
  "text": "확인하는 겁니다."
 },
 {
  "id": "V154",
  "text": "낮에 유난히 졸렸던 때나"
 },
 {
  "id": "V155",
  "text": "집중이 어려웠던 순간도"
 },
 {
  "id": "V156",
  "text": "짧게 적어 봅니다."
 },
 {
  "id": "V157",
  "text": "이렇게 적어 보면"
 },
 {
  "id": "V158",
  "text": "평일에 짧게 자고"
 },
 {
  "id": "V159",
  "text": "휴일에 몰아 자는 패턴이"
 },
 {
  "id": "V160",
  "text": "더 잘 보일 수 있습니다."
 },
 {
  "id": "V161",
  "text": "미국 국립보건원은 성인에게"
 },
 {
  "id": "V162",
  "text": "대체로 하루 일곱 시간에서 아홉 시간의"
 },
 {
  "id": "V163",
  "text": "수면을 권합니다."
 },
 {
  "id": "V164",
  "text": "개인마다 차이는 있지만"
 },
 {
  "id": "V165",
  "text": "여섯 시간이면 충분하다고"
 },
 {
  "id": "V166",
  "text": "결론 내리기 전에"
 },
 {
  "id": "V167",
  "text": "충분히 잘 시간을 꾸준히"
 },
 {
  "id": "V168",
  "text": "확보하고 있는지부터"
 },
 {
  "id": "V169",
  "text": "살펴보는 것이 좋겠습니다."
 },
 {
  "id": "V170",
  "text": "둘째."
 },
 {
  "id": "V171",
  "text": "잠들 준비를 시작할 시간을 정하고"
 },
 {
  "id": "V172",
  "text": "그 전에 내가 즐길 시간도"
 },
 {
  "id": "V173",
  "text": "남겨 두세요."
 },
 {
  "id": "V174",
  "text": "잠을 더 자야 한다는 것을 알아도"
 },
 {
  "id": "V175",
  "text": "밤이 되면 이런 마음이 듭니다."
 },
 {
  "id": "V176",
  "text": "일찍 자면 내 시간은 언제 가져요?"
 },
 {
  "id": "V177",
  "text": "퇴근하고 밥을 먹고"
 },
 {
  "id": "V178",
  "text": "집안일을 마치면 벌써 밤입니다."
 },
 {
  "id": "V179",
  "text": "이제 겨우 좋아하는 영상을"
 },
 {
  "id": "V180",
  "text": "보기 시작했는데"
 },
 {
  "id": "V181",
  "text": "자려고 하니 아쉽습니다."
 },
 {
  "id": "V182",
  "text": "이때 무조건 휴대폰을 내려놓으라는 말은"
 },
 {
  "id": "V183",
  "text": "남은 즐거움마저"
 },
 {
  "id": "V184",
  "text": "포기하라는 말처럼 들릴 수 있습니다."
 },
 {
  "id": "V185",
  "text": "그래서 잠들 시각만 정하기보다"
 },
 {
  "id": "V186",
  "text": "저녁을 어떻게 보낼지도"
 },
 {
  "id": "V187",
  "text": "함께 정해 보는 겁니다."
 },
 {
  "id": "V188",
  "text": "밥을 먹고 나서"
 },
 {
  "id": "V189",
  "text": "보고 싶었던 드라마 한 편을 봅니다."
 },
 {
  "id": "V190",
  "text": "한 편이 끝나면"
 },
 {
  "id": "V191",
  "text": "새로운 영상을 계속 찾기보다"
 },
 {
  "id": "V192",
  "text": "씻고 하루를 마무리합니다."
 },
 {
  "id": "V193",
  "text": "음악을 들으며 쉬어도 좋습니다."
 },
 {
  "id": "V194",
  "text": "내가 좋아하는 시간을 보내되"
 },
 {
  "id": "V195",
  "text": "하루를 마칠 시점도"
 },
 {
  "id": "V196",
  "text": "함께 정하는 겁니다."
 },
 {
  "id": "V197",
  "text": "처음에는 평소보다 삼십 분 먼저"
 },
 {
  "id": "V198",
  "text": "저녁 일과를 마무리해 볼 수 있습니다."
 },
 {
  "id": "V199",
  "text": "삼십 분만 더 자면"
 },
 {
  "id": "V200",
  "text": "충분하다는 뜻은 아닙니다."
 },
 {
  "id": "V201",
  "text": "필요한 수면 시간을"
 },
 {
  "id": "V202",
  "text": "확보해 가기 위한 첫 단계입니다."
 },
 {
  "id": "V203",
  "text": "눕기로 한 시각에 씻기 시작하면"
 },
 {
  "id": "V204",
  "text": "잠자리에 드는 시간은"
 },
 {
  "id": "V205",
  "text": "다시 늦어집니다."
 },
 {
  "id": "V206",
  "text": "잠자리 준비도 함께 앞당겨 보세요."
 },
 {
  "id": "V207",
  "text": "야근이나 돌봄으로"
 },
 {
  "id": "V208",
  "text": "시간을 조정하기 어려운 날도 있습니다."
 },
 {
  "id": "V209",
  "text": "그런 상황까지 의지의 문제로"
 },
 {
  "id": "V210",
  "text": "돌리지 말고"
 },
 {
  "id": "V211",
  "text": "바꿀 수 있는 일정부터 살펴보세요."
 },
 {
  "id": "V212",
  "text": "셋째."
 },
 {
  "id": "V213",
  "text": "주말에도 잠들고 일어나는 시각이"
 },
 {
  "id": "V214",
  "text": "크게 달라지지 않도록 해 보세요."
 },
 {
  "id": "V215",
  "text": "주말에는 늦게 자고"
 },
 {
  "id": "V216",
  "text": "늦게 일어나는 생활이 이어지기 쉽습니다."
 },
 {
  "id": "V217",
  "text": "이런 변화는"
 },
 {
  "id": "V218",
  "text": "수면 리듬을 흔들 수 있습니다."
 },
 {
  "id": "V219",
  "text": "일요일 낮 열두 시에 일어난 뒤"
 },
 {
  "id": "V220",
  "text": "내일 출근해야 한다며"
 },
 {
  "id": "V221",
  "text": "밤 열한 시에 누웠던 장면을"
 },
 {
  "id": "V222",
  "text": "떠올려 보세요."
 },
 {
  "id": "V223",
  "text": "마음은 급한데"
 },
 {
  "id": "V224",
  "text": "잠은 바로 오지 않을 수 있습니다."
 },
 {
  "id": "V225",
  "text": "미국 국립보건원은"
 },
 {
  "id": "V226",
  "text": "평일과 주말의 수면 일정을"
 },
 {
  "id": "V227",
  "text": "비슷하게 유지하고"
 },
 {
  "id": "V228",
  "text": "그 차이를 대략 한 시간 이내로"
 },
 {
  "id": "V229",
  "text": "줄이도록 권합니다."
 },
 {
  "id": "V230",
  "text": "다만 이미 잠이 부족한데"
 },
 {
  "id": "V231",
  "text": "기상 시각만 맞추려고"
 },
 {
  "id": "V232",
  "text": "필요한 잠까지 줄이지는 마세요."
 },
 {
  "id": "V233",
  "text": "평일의 수면 시간을 늘리면서"
 },
 {
  "id": "V234",
  "text": "주말에도 지나치게 늦게 잠들지 않도록"
 },
 {
  "id": "V235",
  "text": "함께 조정하는 겁니다."
 },
 {
  "id": "V236",
  "text": "아침에는 가능하면"
 },
 {
  "id": "V237",
  "text": "밖에서 자연광을 쬐고"
 },
 {
  "id": "V238",
  "text": "밤에는 밝은 조명과 화면을 줄이며"
 },
 {
  "id": "V239",
  "text": "잠들 준비를 해 보세요."
 },
 {
  "id": "V240",
  "text": "충분히 잘 시간을 확보했는데도"
 },
 {
  "id": "V241",
  "text": "낮에 심하게 졸리거나"
 },
 {
  "id": "V242",
  "text": "큰 코골이와 함께"
 },
 {
  "id": "V243",
  "text": "자는 동안 숨이 멎는다는 이야기를 들었다면"
 },
 {
  "id": "V244",
  "text": "진료를 받아 볼 필요도 있습니다."
 },
 {
  "id": "V245",
  "text": "이제 처음의 토요일로"
 },
 {
  "id": "V246",
  "text": "돌아가 보겠습니다."
 },
 {
  "id": "V247",
  "text": "눈을 떠 보니 낮 열두 시입니다."
 },
 {
  "id": "V248",
  "text": "우리는 주말을 또 날렸다고"
 },
 {
  "id": "V249",
  "text": "생각하기 쉽습니다."
 },
 {
  "id": "V250",
  "text": "하지만 늦게 일어난 자신을 탓하기 전에"
 },
 {
  "id": "V251",
  "text": "지난 닷새의 밤도"
 },
 {
  "id": "V252",
  "text": "함께 떠올려 보면 어떨까요?"
 },
 {
  "id": "V253",
  "text": "일어날 시간은 정해 둔 채"
 },
 {
  "id": "V254",
  "text": "잠들 시간만 계속 뒤로 미루고"
 },
 {
  "id": "V255",
  "text": "있지는 않았을까요?"
 },
 {
  "id": "V256",
  "text": "잠을 한 시간 줄이면"
 },
 {
  "id": "V257",
  "text": "오늘 밤 영상을 한 편 더 볼 수 있습니다."
 },
 {
  "id": "V258",
  "text": "그 시간은 분명하게 눈에 보입니다."
 },
 {
  "id": "V259",
  "text": "하지만 다음 날 어떤 상태로"
 },
 {
  "id": "V260",
  "text": "하루를 보내게 될지는"
 },
 {
  "id": "V261",
  "text": "그 순간에는 잘 보이지 않습니다."
 },
 {
  "id": "V262",
  "text": "얼마나 오래 깨어 있었는지와 함께"
 },
 {
  "id": "V263",
  "text": "어떤 상태로 하루를 보냈는지도"
 },
 {
  "id": "V264",
  "text": "돌아보면 좋겠습니다."
 },
 {
  "id": "V265",
  "text": "여섯 시간으로도 버틸 만하다는 이유만으로"
 },
 {
  "id": "V266",
  "text": "나에게 충분한 잠이라고"
 },
 {
  "id": "V267",
  "text": "너무 빨리 결론 내리지는"
 },
 {
  "id": "V268",
  "text": "않았으면 합니다."
 },
 {
  "id": "V269",
  "text": "오늘은 내일 몇 시에 일어날지 정하면서"
 },
 {
  "id": "V270",
  "text": "오늘 몇 시부터 하루를 마무리할지도"
 },
 {
  "id": "V271",
  "text": "함께 정해 보세요."
 },
 {
  "id": "V272",
  "text": "여러분은 평일과 주말에"
 },
 {
  "id": "V273",
  "text": "자는 시간이 얼마나 다른가요?"
 },
 {
  "id": "V274",
  "text": "잠자는 습관을 바꾸고"
 },
 {
  "id": "V275",
  "text": "달라진 경험이 있다면"
 },
 {
  "id": "V276",
  "text": "댓글로 공유해 주세요."
 }
]