 ],
 "subs": [
  {
   "line": "V001",
   "text": "당신은 오늘 소개팅 상대와"
  },
  {
   "line": "V002",
   "text": "카페에 마주 앉아 있습니다."
  },
  {
   "line": "V003",
   "text": "이야기를 나누던 상대가 묻습니다."
  },
  {
   "line": "V004",
   "text": "쉬는 날에는 보통 뭐 하세요?",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V005",
   "text": "잠깐 지난 주말을 떠올려 봅니다."
  },
  {
   "line": "V006",
   "text": "침대에 누워 유튜브를 보다가"
  },
  {
   "line": "V007",
   "text": "볼 만한 영상이 없으면"
  },
  {
   "line": "V008",
   "text": "OTT를 켜고 드라마를 봤습니다."
  },
  {
   "line": "V009",
   "text": "생각해 보니 그게 전부입니다."
  },
  {
   "line": "V010",
   "text": "그대로 말하자니 괜히 머쓱합니다."
  },
  {
   "line": "V011",
   "text": "다른 이야기를 꺼내 보려 해도"
  },
  {
   "line": "V012",
   "text": "딱히 떠오르는 게 없습니다."
  },
  {
   "line": "V013",
   "text": "잠깐 망설이다 이렇게 대답합니다."
  },
  {
   "line": "V014",
   "text": "저는 집에서 책도 좀 보고",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V015",
   "text": "쉬는 편이에요.",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V016",
   "text": "요즘 읽고 있는 책도 없는데"
  },
  {
   "line": "V017",
   "text": "그렇게 둘러댑니다."
  },
  {
   "line": "V018",
   "text": "대화는 다른 이야기로 넘어갔지만"
  },
  {
   "line": "V019",
   "text": "집에 오는 길에"
  },
  {
   "line": "V020",
   "text": "내가 했던 대답이 다시 떠오릅니다."
  },
  {
   "line": "V021",
   "text": "쉬는 날에 뭘 하느냐는"
  },
  {
   "line": "V022",
   "text": "가벼운 질문이었는데"
  },
  {
   "line": "V023",
   "text": "왜 이렇게 할 말이 없었을까요?"
  },
  {
   "line": "V024",
   "text": "나는 왜 확실하게",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V025",
   "text": "좋아하는 게 없을까요?",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V026",
   "text": "누가 시키지 않아도"
  },
  {
   "line": "V027",
   "text": "찾아서 하는 일 하나쯤은"
  },
  {
   "line": "V028",
   "text": "있어야 할 것 같습니다."
  },
  {
   "line": "V029",
   "text": "그렇다고 시도해 본 적이"
  },
  {
   "line": "V030",
   "text": "없는 것도 아닙니다."
  },
  {
   "line": "V031",
   "text": "그림도 배워 봤고"
  },
  {
   "line": "V032",
   "text": "운동도 등록해 봤습니다."
  },
  {
   "line": "V033",
   "text": "처음에는 괜찮다가"
  },
  {
   "line": "V034",
   "text": "조금 어려워지면"
  },
  {
   "line": "V035",
   "text": "손이 가지 않았죠."
  },
  {
   "line": "V036",
   "text": "그러고는 생각합니다."
  },
  {
   "line": "V037",
   "text": "역시 이것도",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V038",
   "text": "내 취미는 아니었나 봅니다.",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V039",
   "text": "하지만 좋아하는 게 분명한 사람들은",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V040",
   "text": "정말 처음부터",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V041",
   "text": "자기 취향을 알고 있었을까요?",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V042",
   "text": "심리학 연구들을 살펴보면"
  },
  {
   "line": "V043",
   "text": "좋아하는 마음을 어떻게 바라보고"
  },
  {
   "line": "V044",
   "text": "어떤 경험을 쌓느냐도"
  },
  {
   "line": "V045",
   "text": "중요하다는 것을 알 수 있습니다."
  },
  {
   "line": "V046",
   "text": "오늘은 관심이 생겨도"
  },
  {
   "line": "V047",
   "text": "금방 놓아 버리는 이유를 살펴보고"
  },
  {
   "line": "V048",
   "text": "작은 관심을 내 취미로 키워 볼"
  },
  {
   "line": "V049",
   "text": "방법 3가지를"
  },
  {
   "line": "V050",
   "text": "이야기해 보겠습니다."
  },
  {
   "line": "V051",
   "text": "주말 오후입니다."
  },
  {
   "line": "V052",
   "text": "당신은 취미를 하나"
  },
  {
   "line": "V053",
   "text": "만들어 보기로 합니다."
  },
  {
   "line": "V054",
   "text": "검색창에 직장인 취미 추천을 입력합니다."
  },
  {
   "line": "V055",
   "text": "그림과 뜨개질과 사진이"
  },
  {
   "line": "V056",
   "text": "차례로 나옵니다."
  },
  {
   "line": "V057",
   "text": "그림도 목도리 만들기도"
  },
  {
   "line": "V058",
   "text": "좋아 보입니다."
  },
  {
   "line": "V059",
   "text": "그런데 또 금방 질리면"
  },
  {
   "line": "V060",
   "text": "어떡할까요?"
  },
  {
   "line": "V061",
   "text": "이번에는 정말 오래 좋아할 수 있는 걸"
  },
  {
   "line": "V062",
   "text": "고르고 싶습니다."
  },
  {
   "line": "V063",
   "text": "아직 해 보지도 않았는데"
  },
  {
   "line": "V064",
   "text": "이것이 내 취미가 될지부터"
  },
  {
   "line": "V065",
   "text": "확실히 알고 싶어"
  },
  {
   "line": "V066",
   "text": "후기를 더 찾아봅니다."
  },
  {
   "line": "V067",
   "text": "그리고 마음에 드는 그림을 보고"
  },
  {
   "line": "V068",
   "text": "연필을 집어 듭니다."
  },
  {
   "line": "V069",
   "text": "그런데 영상에서는"
  },
  {
   "line": "V070",
   "text": "쉽게 그려지던 얼굴이"
  },
  {
   "line": "V071",
   "text": "내 종이 위에서는"
  },
  {
   "line": "V072",
   "text": "자꾸 이상해집니다."
  },
  {
   "line": "V073",
   "text": "재미있을 줄 알았는데"
  },
  {
   "line": "V074",
   "text": "생각보다 어렵습니다."
  },
  {
   "line": "V075",
   "text": "여기서"
  },
  {
   "line": "V076",
   "text": "아직 손에 익지 않았구나",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V077",
   "text": "라고 생각할 수도 있습니다."
  },
  {
   "line": "V078",
   "text": "하지만 우리는 종종",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V079",
   "text": "훨씬 큰 결론을 내립니다.",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V080",
   "text": "나는 그림을 좋아하는 사람이",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V081",
   "text": "아닌가 봐.",
   "pos": "center",
   "italic": true,
   "shadow": true
  },
  {
   "line": "V082",
   "text": "어려웠다는 한 번의 경험이",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V083",
   "text": "내가 어떤 사람인지를",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V084",
   "text": "판정하는 근거가 되는 것이죠.",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V085",
   "text": "그런데 이 해석 자체가",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V086",
   "text": "막 생긴 관심에",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V087",
   "text": "영향을 줄 수 있습니다.",
   "pos": "center",
   "shadow": true
  },
  {
   "line": "V088",
   "text": "여러분이 새로운 관심사에 관한"
  },
  {
   "line": "V089",
   "text": "실험에 참여했다고"
  },
  {
   "line": "V090",
   "text": "생각해 보겠습니다."
  },
  {
   "line": "V091",
   "text": "실험을 시작하며"
  },
  {
   "line": "V092",
   "text": "글 한 편을 읽습니다."
  },
  {
   "line": "V093",
   "text": "한 집단은 사람의 관심사가"
  },
  {
   "line": "V094",
   "text": "비교적 고정돼 있다는"
  },
  {
   "line": "V095",
   "text": "강연을 듣습니다."
  },
  {
   "line": "V096",
   "text": "다른 집단은 관심사를"
  },
  {
   "line": "V097",
   "text": "경험을 통해 발전시킬 수 있다는"
  },
  {
   "line": "V098",
   "text": "강연을 듣습니다."
  },
  {
   "line": "V099",
   "text": "이후에는 두 집단 모두"
  },
  {
   "line": "V100",
   "text": "블랙홀을 쉽게 설명해 주는"
  },
  {
   "line": "V101",
   "text": "짧은 영상을 봅니다."
  },
  {
