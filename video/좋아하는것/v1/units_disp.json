[
 {
  "id": "V001",
  "text": "당신은 오늘 소개팅 상대와"
 },
 {
  "id": "V002",
  "text": "카페에 마주 앉아 있습니다."
 },
 {
  "id": "V003",
  "text": "이야기를 나누던 상대가 묻습니다."
 },
 {
  "id": "V004",
  "text": "쉬는 날에는 보통 뭐 하세요?"
 },
 {
  "id": "V005",
  "text": "잠깐 지난 주말을 떠올려 봅니다."
 },
 {
  "id": "V006",
  "text": "침대에 누워 유튜브를 보다가"
 },
 {
  "id": "V007",
  "text": "볼 만한 영상이 없으면"
 },
 {
  "id": "V008",
  "text": "오티티를 켜고 드라마를 봤습니다."
 },
 {
  "id": "V009",
  "text": "생각해 보니 그게 전부입니다."
 },
 {
  "id": "V010",
  "text": "그대로 말하자니 괜히 머쓱합니다."
 },
 {
  "id": "V011",
  "text": "다른 이야기를 꺼내 보려 해도"
 },
 {
  "id": "V012",
  "text": "딱히 떠오르는 게 없습니다."
 },
 {
  "id": "V013",
  "text": "잠깐 망설이다 이렇게 대답합니다."
 },
 {
  "id": "V014",
  "text": "저는 집에서 책도 좀 보고"
 },
 {
  "id": "V015",
  "text": "쉬는 편이에요."
 },
 {
  "id": "V016",
  "text": "요즘 읽고 있는 책도 없는데"
 },
 {
  "id": "V017",
  "text": "그렇게 둘러댑니다."
 },
 {
  "id": "V018",
  "text": "대화는 다른 이야기로 넘어갔지만"
 },
 {
  "id": "V019",
  "text": "집에 오는 길에"
 },
 {
  "id": "V020",
  "text": "내가 했던 대답이 다시 떠오릅니다."
 },
 {
  "id": "V021",
  "text": "쉬는 날에 뭘 하느냐는"
 },
 {
  "id": "V022",
  "text": "가벼운 질문이었는데"
 },
 {
  "id": "V023",
  "text": "왜 이렇게 할 말이 없었을까요?"
 },
 {
  "id": "V024",
  "text": "나는 왜 확실하게"
 },
 {
  "id": "V025",
  "text": "좋아하는 게 없을까요?"
 },
 {
  "id": "V026",
  "text": "누가 시키지 않아도"
 },
 {
  "id": "V027",
  "text": "찾아서 하는 일 하나쯤은"
 },
 {
  "id": "V028",
  "text": "있어야 할 것 같습니다."
 },
 {
  "id": "V029",
  "text": "그렇다고 시도해 본 적이"
 },
 {
  "id": "V030",
  "text": "없는 것도 아닙니다."
 },
 {
  "id": "V031",
  "text": "그림도 배워 봤고"
 },
 {
  "id": "V032",
  "text": "운동도 등록해 봤습니다."
 },
 {
  "id": "V033",
  "text": "처음에는 괜찮다가"
 },
 {
  "id": "V034",
  "text": "조금 어려워지면"
 },
 {
  "id": "V035",
  "text": "손이 가지 않았죠."
 },
 {
  "id": "V036",
  "text": "그러고는 생각합니다."
 },
 {
  "id": "V037",
  "text": "역시 이것도"
 },
 {
  "id": "V038",
  "text": "내 취미는 아니었나 봅니다."
 },
 {
  "id": "V039",
  "text": "하지만 좋아하는 게 분명한 사람들은"
 },
 {
  "id": "V040",
  "text": "정말 처음부터"
 },
 {
  "id": "V041",
  "text": "자기 취향을 알고 있었을까요?"
 },
 {
  "id": "V042",
  "text": "심리학 연구들을 살펴보면"
 },
 {
  "id": "V043",
  "text": "좋아하는 마음을 어떻게 바라보고"
 },
 {
  "id": "V044",
  "text": "어떤 경험을 쌓느냐도"
 },
 {
  "id": "V045",
  "text": "중요하다는 것을 알 수 있습니다."
 },
 {
  "id": "V046",
  "text": "오늘은 관심이 생겨도"
 },
 {
  "id": "V047",
  "text": "금방 놓아 버리는 이유를 살펴보고"
 },
 {
  "id": "V048",
  "text": "작은 관심을 내 취미로 키워 볼"
 },
 {
  "id": "V049",
  "text": "방법 세 가지를"
 },
 {
  "id": "V050",
  "text": "이야기해 보겠습니다."
 },
 {
  "id": "V051",
  "text": "주말 오후입니다."
 },
 {
  "id": "V052",
  "text": "당신은 취미를 하나"
 },
 {
  "id": "V053",
  "text": "만들어 보기로 합니다."
 },
 {
  "id": "V054",
  "text": "검색창에 직장인 취미 추천을 입력합니다."
 },
 {
  "id": "V055",
  "text": "그림과 뜨개질과 사진이"
 },
 {
  "id": "V056",
  "text": "차례로 나옵니다."
 },
 {
  "id": "V057",
  "text": "그림도 목도리 만들기도"
 },
 {
  "id": "V058",
  "text": "좋아 보입니다."
 },
 {
  "id": "V059",
  "text": "그런데 또 금방 질리면"
 },
 {
  "id": "V060",
  "text": "어떡할까요?"
 },
 {
  "id": "V061",
  "text": "이번에는 정말 오래 좋아할 수 있는 걸"
 },
 {
  "id": "V062",
  "text": "고르고 싶습니다."
 },
 {
  "id": "V063",
  "text": "아직 해 보지도 않았는데"
 },
 {
  "id": "V064",
  "text": "이것이 내 취미가 될지부터"
 },
 {
  "id": "V065",
  "text": "확실히 알고 싶어"
 },
 {
  "id": "V066",
  "text": "후기를 더 찾아봅니다."
 },
 {
  "id": "V067",
  "text": "그리고 마음에 드는 그림을 보고"
 },
 {
  "id": "V068",
  "text": "연필을 집어 듭니다."
 },
 {
  "id": "V069",
  "text": "그런데 영상에서는"
 },
 {
  "id": "V070",
  "text": "쉽게 그려지던 얼굴이"
 },
 {
  "id": "V071",
  "text": "내 종이 위에서는"
 },
 {
  "id": "V072",
  "text": "자꾸 이상해집니다."
 },
 {
  "id": "V073",
  "text": "재밌을 줄 알았는데"
 },
 {
  "id": "V074",
  "text": "생각보다 어렵습니다."
 },
 {
  "id": "V075",
  "text": "여기서"
 },
 {
  "id": "V076",
  "text": "아직 손에 익지 않았구나"
 },
 {
  "id": "V077",
  "text": "라고 생각할 수도 있습니다."
 },
 {
  "id": "V078",
  "text": "하지만 우리는 종종"
 },
 {
  "id": "V079",
  "text": "훨씬 큰 결론을 내립니다."
 },
 {
  "id": "V080",
  "text": "나는 그림을 좋아하는 사람이"
 },
 {
  "id": "V081",
  "text": "아닌가 봐."
 },
 {
  "id": "V082",
  "text": "어려웠다는 한 번의 경험이"
 },
 {
  "id": "V083",
  "text": "내가 어떤 사람인지를"
 },
 {
  "id": "V084",
  "text": "판정하는 근거가 되는 것이죠."
 },
 {
  "id": "V085",
  "text": "그런데 이 해석 자체가"
 },
 {
  "id": "V086",
  "text": "막 생긴 관심에"
 },
 {
  "id": "V087",
  "text": "영향을 줄 수 있습니다."
 },
 {
  "id": "V088",
  "text": "여러분이 새로운 관심사에 관한"
 },
 {
  "id": "V089",
  "text": "실험에 참여했다고"
 },
 {
  "id": "V090",
  "text": "생각해 보겠습니다."
 },
 {
  "id": "V091",
  "text": "실험을 시작하며"
 },
 {
  "id": "V092",
  "text": "글 한 편을 읽습니다."
 },
 {
  "id": "V093",
  "text": "한 집단은 사람의 관심사가"
 },
 {
  "id": "V094",
  "text": "비교적 고정돼 있다는"
 },
 {
  "id": "V095",
  "text": "강연을 듣습니다."
 },
 {
  "id": "V096",
  "text": "다른 집단은 관심사를"
 },
 {
  "id": "V097",
  "text": "경험을 통해 발전시킬 수 있다는"
 },
 {
  "id": "V098",
  "text": "강연을 듣습니다."
 },
 {
  "id": "V099",
  "text": "이후에는 두 집단 모두"
 },
 {
  "id": "V100",
  "text": "블랙홀을 쉽게 설명해 주는"
 },
 {
  "id": "V101",
  "text": "짧은 영상을 봅니다."
 },
 {
  "id": "V102",
  "text": "그리고 이 영상에"
 },
 {
  "id": "V103",
  "text": "흥미를 느낀 학생들에게"
 },
 {
  "id": "V104",
  "text": "이번에는 같은 주제의"
 },
 {
  "id": "V105",
  "text": "전문적인 과학 논문 일부를"
 },
 {
  "id": "V106",
  "text": "읽게 합니다."
 },
 {
  "id": "V107",
  "text": "쉽게 풀어 준 영상을 볼 때와 달리"
 },
 {
  "id": "V108",
  "text": "내용을 따라가기가 어려워집니다."
 },
 {
  "id": "V109",
  "text": "두 그룹은 어떻게 반응했을까요?"
 },
 {
  "id": "V110",
  "text": "처음 영상을 봤을 때"
 },
 {
  "id": "V111",
  "text": "두 집단의 관심 수준은"
 },
 {
  "id": "V112",
  "text": "비슷했습니다."
 },
 {
  "id": "V113",
  "text": "어려운 글을 읽은 뒤에는"
 },
 {
  "id": "V114",
  "text": "두 집단 모두 흥미가 줄었지만"
 },
 {
  "id": "V115",
  "text": "사람의 관심사는 고정돼 있다는"
 },
 {
  "id": "V116",
  "text": "강연을 들은 집단에서"
 },
 {
  "id": "V117",
  "text": "더 크게 떨어졌습니다."
 },
 {
  "id": "V118",
  "text": "연구진은 본인의 관심사는"
 },
 {
  "id": "V119",
  "text": "이미 정해져 있다고 믿는 사람에게"
 },
 {
  "id": "V120",
  "text": "어려움이 생기면"
 },
 {
  "id": "V121",
  "text": "이것이 자신의 진짜 관심사가"
 },
 {
  "id": "V122",
  "text": "아니라는 신호처럼"
 },
 {
  "id": "V123",
  "text": "받아들여질 수 있다고 설명했습니다."
 },
 {
  "id": "V124",
  "text": "이 관점을 앞서"
 },
 {
  "id": "V125",
  "text": "그림을 그리던 장면에"
 },
 {
  "id": "V126",
  "text": "가져와 보겠습니다."
 },
 {
  "id": "V127",
  "text": "얼굴을 그리는데"
 },
 {
  "id": "V128",
  "text": "자꾸 비율이 어긋납니다."
 },
 {
  "id": "V129",
  "text": "정말 좋아하는 일이면"
 },
 {
  "id": "V130",
  "text": "계속 재밌어야 할 텐데"
 },
 {
  "id": "V131",
  "text": "이렇게 답답한 걸 보니"
 },
 {
  "id": "V132",
  "text": "내 취미는 아닌가 봐."
 },
 {
  "id": "V133",
  "text": "이렇게 생각하면"
 },
 {
  "id": "V134",
  "text": "아직 익숙하지 않아서 겪는 어려움을"
 },
 {
  "id": "V135",
  "text": "관심이 없다는 증거로"
 },
 {
  "id": "V136",
  "text": "받아들이게 될 수 있습니다."
 },
 {
  "id": "V137",
  "text": "하지만 같은 순간에"
 },
 {
  "id": "V138",
  "text": "이렇게 물어볼 수도 있습니다."
 },
 {
  "id": "V139",
  "text": "그림을 그리는 일이"
 },
 {
  "id": "V140",
  "text": "쉬워진 걸까요"
 },
 {
  "id": "V141",
  "text": "아니면 그리고 싶은데"
 },
 {
  "id": "V142",
  "text": "아직 원하는 대로 그리지 못해서"
 },
 {
  "id": "V143",
  "text": "답답한 걸까요?"
 },
 {
  "id": "V144",
  "text": "그림 자체에 마음이 가지 않는다면"
 },
 {
  "id": "V145",
  "text": "다른 활동을 골라도 됩니다."
 },
 {
  "id": "V146",
  "text": "그런데 그리고 싶은 마음은 남아 있다면"
 },
 {
  "id": "V147",
  "text": "지금 필요한 것은"
 },
 {
  "id": "V148",
  "text": "조금 더 쉬운 그림일 수도 있죠."
 },
 {
  "id": "V149",
  "text": "막 싹이 난 화분을 보고"
 },
 {
  "id": "V150",
  "text": "꽃이 없으니"
 },
 {
  "id": "V151",
  "text": "꽃이 피지 않는 식물이라고"
 },
 {
  "id": "V152",
  "text": "단정할 수는 없습니다."
 },
 {
  "id": "V153",
  "text": "작은 관심에도"
 },
 {
  "id": "V154",
  "text": "아직 경험해 보지 못한 재미가"
 },
 {
  "id": "V155",
  "text": "남아 있을 수 있습니다."
 },
 {
  "id": "V156",
  "text": "그렇다고 관심이 생긴 뒤에는"
 },
 {
  "id": "V157",
  "text": "연습만 계속하면 되는 걸까요?"
 },
 {
  "id": "V158",
  "text": "이제 다른 문제가 나타납니다."
 },
 {
  "id": "V159",
  "text": "좋아하는 일을 시작했는데"
 },
 {
  "id": "V160",
  "text": "어느새 잘해야 할 일이 되는 겁니다."
 },
 {
  "id": "V161",
  "text": "사진을 찍으러 나갔습니다."
 },
 {
  "id": "V162",
  "text": "처음에는 길가의 빛이 예뻐서 찍었습니다."
 },
 {
  "id": "V163",
  "text": "그런데 사진을 올리고"
 },
 {
  "id": "V164",
  "text": "반응을 확인하기 시작합니다."
 },
 {
  "id": "V165",
  "text": "어느 순간부터"
 },
 {
  "id": "V166",
  "text": "내가 좋아하는 장면보다"
 },
 {
  "id": "V167",
  "text": "다른 사람이 좋아할 사진을"
 },
 {
  "id": "V168",
  "text": "먼저 생각합니다."
 },
 {
  "id": "V169",
  "text": "처음에는 취미를 더 즐기려고"
 },
 {
  "id": "V170",
  "text": "시작한 일이었는데"
 },
 {
  "id": "V171",
  "text": "평가를 받을 준비가 안 된 날에는"
 },
 {
  "id": "V172",
  "text": "아예 하고 싶지 않아집니다."
 },
 {
  "id": "V173",
  "text": "이 변화를 생각해 볼 만한"
 },
 {
  "id": "V174",
  "text": "오래된 실험이 있습니다."
 },
 {
  "id": "V175",
  "text": "한 유치원에"
 },
 {
  "id": "V176",
  "text": "그림 그리기를 좋아하는"
 },
 {
  "id": "V177",
  "text": "아이들이 있습니다."
 },
 {
  "id": "V178",
  "text": "아이들을 세 그룹으로 나눕니다."
 },
 {
  "id": "V179",
  "text": "에이 그룹의 아이들에게는"
 },
 {
  "id": "V180",
  "text": "그림을 그리면"
 },
 {
  "id": "V181",
  "text": "상을 주기로 약속하고"
 },
 {
  "id": "V182",
  "text": "비 그룹의 아이들에게는"
 },
 {
  "id": "V183",
  "text": "상에 관한 말 없이"
 },
 {
  "id": "V184",
  "text": "그림을 그렸다가"
 },
 {
  "id": "V185",
  "text": "나중에 예상하지 못한 상을 줬습니다."
 }
]