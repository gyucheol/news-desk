[
 {
  "id": "V001",
  "text": "당신은 오늘 소개팅 상대와"
 },
 {
  "id": "V002",
  "text": "카페에 마주 앉아 있습니다."
 },
 {
  "id": "V003",
  "text": "이야기를 나누던 상대가 묻습니다."
 },
 {
  "id": "V004",
  "text": "쉬는 날에는 보통 뭐 하세요?"
 },
 {
  "id": "V005",
  "text": "잠깐 지난 주말을 떠올려 봅니다."
 },
 {
  "id": "V006",
  "text": "침대에 누워 유튜브를 보다가"
 },
 {
  "id": "V007",
  "text": "볼 만한 영상이 없으면"
 },
 {
  "id": "V008",
  "text": "오티티를 켜고 드라마를 봤습니다."
 },
 {
  "id": "V009",
  "text": "생각해 보니 그게 전부입니다."
 },
 {
  "id": "V010",
  "text": "그대로 말하자니 괜히 머쓱합니다."
 },
 {
  "id": "V011",
  "text": "다른 이야기를 꺼내 보려 해도"
 },
 {
  "id": "V012",
  "text": "딱히 떠오르는 게 없습니다."
 },
 {
  "id": "V013",
  "text": "잠깐 망설이다 이렇게 대답합니다."
 },
 {
  "id": "V014",
  "text": "저는 집에서 책도 좀 보고"
 },
 {
  "id": "V015",
  "text": "쉬는 편이에요."
 },
 {
  "id": "V016",
  "text": "요즘 읽고 있는 책도 없는데"
 },
 {
  "id": "V017",
  "text": "그렇게 둘러댑니다."
 },
 {
  "id": "V018",
  "text": "대화는 다른 이야기로 넘어갔지만"
 },
 {
  "id": "V019",
  "text": "집에 오는 길에"
 },
 {
  "id": "V020",
  "text": "내가 했던 대답이 다시 떠오릅니다."
 },
 {
  "id": "V021",
  "text": "쉬는 날에 뭘 하느냐는"
 },
 {
  "id": "V022",
  "text": "가벼운 질문이었는데"
 },
 {
  "id": "V023",
  "text": "왜 이렇게 할 말이 없었을까요?"
 },
 {
  "id": "V024",
  "text": "나는 왜 확실하게"
 },
 {
  "id": "V025",
  "text": "좋아하는 게 없을까요?"
 },
 {
  "id": "V026",
  "text": "누가 시키지 않아도"
 },
 {
  "id": "V027",
  "text": "찾아서 하는 일 하나쯤은"
 },
 {
  "id": "V028",
  "text": "있어야 할 것 같습니다."
 },
 {
  "id": "V029",
  "text": "그렇다고 시도해 본 적이"
 },
 {
  "id": "V030",
  "text": "없는 것도 아닙니다."
 },
 {
  "id": "V031",
  "text": "그림도 배워 봤고"
 },
 {
  "id": "V032",
  "text": "운동도 등록해 봤습니다."
 },
 {
  "id": "V033",
  "text": "처음에는 괜찮다가"
 },
 {
  "id": "V034",
  "text": "조금 어려워지면"
 },
 {
  "id": "V035",
  "text": "손이 가지 않았죠."
 },
 {
  "id": "V036",
  "text": "그러고는 생각합니다."
 },
 {
  "id": "V037",
  "text": "역시 이것도"
 },
 {
  "id": "V038",
  "text": "내 취미는 아니었나 봅니다."
 },
 {
  "id": "V039",
  "text": "하지만 좋아하는 게 분명한 사람들은"
 },
 {
  "id": "V040",
  "text": "정말 처음부터"
 },
 {
  "id": "V041",
  "text": "자기 취향을 알고 있었을까요?"
 },
 {
  "id": "V042",
  "text": "심리학 연구들을 살펴보면"
 },
 {
  "id": "V043",
  "text": "좋아하는 마음을 어떻게 바라보고"
 },
 {
  "id": "V044",
  "text": "어떤 경험을 쌓느냐도"
 },
 {
  "id": "V045",
  "text": "중요하다는 것을 알 수 있습니다."
 },
 {
  "id": "V046",
  "text": "오늘은 관심이 생겨도"
 },
 {
  "id": "V047",
  "text": "금방 놓아 버리는 이유를 살펴보고"
 },
 {
  "id": "V048",
  "text": "작은 관심을 내 취미로 키워 볼"
 },
 {
  "id": "V049",
  "text": "방법 세 가지를"
 },
 {
  "id": "V050",
  "text": "이야기해 보겠습니다."
 },
 {
  "id": "V051",
  "text": "주말 오후입니다."
 },
 {
  "id": "V052",
  "text": "당신은 취미를 하나"
 },
 {
  "id": "V053",
  "text": "만들어 보기로 합니다."
 },
 {
  "id": "V054",
  "text": "검색창에 직장인 취미 추천을 입력합니다."
 },
 {
  "id": "V055",
  "text": "그림과 뜨개질과 사진이"
 },
 {
  "id": "V056",
  "text": "차례로 나옵니다."
 },
 {
  "id": "V057",
  "text": "그림도 목도리 만들기도"
 },
 {
  "id": "V058",
  "text": "좋아 보입니다."
 },
 {
  "id": "V059",
  "text": "그런데 또 금방 질리면"
 },
 {
  "id": "V060",
  "text": "어떡할까요?"
 },
 {
  "id": "V061",
  "text": "이번에는 정말 오래 좋아할 수 있는 걸"
 },
 {
  "id": "V062",
  "text": "고르고 싶습니다."
 },
 {
  "id": "V063",
  "text": "아직 해 보지도 않았는데"
 },
 {
  "id": "V064",
  "text": "이것이 내 취미가 될지부터"
 },
 {
  "id": "V065",
  "text": "확실히 알고 싶어"
 },
 {
  "id": "V066",
  "text": "후기를 더 찾아봅니다."
 },
 {
  "id": "V067",
  "text": "그리고 마음에 드는 그림을 보고"
 },
 {
  "id": "V068",
  "text": "연필을 집어 듭니다."
 },
 {
  "id": "V069",
  "text": "그런데 영상에서는"
 },
 {
  "id": "V070",
  "text": "쉽게 그려지던 얼굴이"
 },
 {
  "id": "V071",
  "text": "내 종이 위에서는"
 },
 {
  "id": "V072",
  "text": "자꾸 이상해집니다."
 },
 {
  "id": "V073",
  "text": "재밌을 줄 알았는데"
 },
 {
  "id": "V074",
  "text": "생각보다 어렵습니다."
 },
 {
  "id": "V075",
  "text": "여기서"
 },
 {
  "id": "V076",
  "text": "아직 손에 익지 않았구나"
 },
 {
  "id": "V077",
  "text": "라고 생각할 수도 있습니다."
 },
 {
  "id": "V078",
  "text": "하지만 우리는 종종"
 },
 {
  "id": "V079",
  "text": "훨씬 큰 결론을 내립니다."
 },
 {
  "id": "V080",
  "text": "나는 그림을 좋아하는 사람이"
 },
 {
  "id": "V081",
  "text": "아닌가 봐."
 },
 {
  "id": "V082",
  "text": "어려웠다는 한 번의 경험이"
 },
 {
  "id": "V083",
  "text": "내가 어떤 사람인지를"
 },
 {
  "id": "V084",
  "text": "판정하는 근거가 되는 것이죠."
 },
 {
  "id": "V085",
  "text": "그런데 이 해석 자체가"
 },
 {
  "id": "V086",
  "text": "막 생긴 관심에"
 },
 {
  "id": "V087",
  "text": "영향을 줄 수 있습니다."
 },
 {
  "id": "V088",
  "text": "여러분이 새로운 관심사에 관한"
 },
 {
  "id": "V089",
  "text": "실험에 참여했다고"
 },
 {
  "id": "V090",
  "text": "생각해 보겠습니다."
 },
 {
  "id": "V091",
  "text": "실험을 시작하며"
 },
 {
  "id": "V092",
  "text": "글 한 편을 읽습니다."
 },
 {
  "id": "V093",
  "text": "한 집단은 사람의 관심사가"
 },
 {
  "id": "V094",
  "text": "비교적 고정돼 있다는"
 },
 {
  "id": "V095",
  "text": "강연을 듣습니다."
 },
 {
  "id": "V096",
  "text": "다른 집단은 관심사를"
 },
 {
  "id": "V097",
  "text": "경험을 통해 발전시킬 수 있다는"
 },
 {
  "id": "V098",
  "text": "강연을 듣습니다."
 },
 {
  "id": "V099",
  "text": "이후에는 두 집단 모두"
 },
 {
  "id": "V100",
  "text": "블랙홀을 쉽게 설명해 주는"
 },
 {
  "id": "V101",
  "text": "짧은 영상을 봅니다."
 },
 {
  "id": "V102",
  "text": "그리고 이 영상에"
 },
 {
  "id": "V103",
  "text": "흥미를 느낀 학생들에게"
 },
 {
  "id": "V104",
  "text": "이번에는 같은 주제의"
 },
 {
  "id": "V105",
  "text": "전문적인 과학 논문 일부를"
 },
 {
  "id": "V106",
  "text": "읽게 합니다."
 },
 {
  "id": "V107",
  "text": "쉽게 풀어 준 영상을 볼 때와 달리"
 },
 {
  "id": "V108",
  "text": "내용을 따라가기가 어려워집니다."
 },
 {
  "id": "V109",
  "text": "두 그룹은 어떻게 반응했을까요?"
 },
 {
  "id": "V110",
  "text": "처음 영상을 봤을 때"
 },
 {
  "id": "V111",
  "text": "두 집단의 관심 수준은"
 },
 {
  "id": "V112",
  "text": "비슷했습니다."
 },
 {
  "id": "V113",
  "text": "어려운 글을 읽은 뒤에는"
 },
 {
  "id": "V114",
  "text": "두 집단 모두 흥미가 줄었지만"
 },
 {
  "id": "V115",
  "text": "사람의 관심사는 고정돼 있다는"
 },
 {
  "id": "V116",
  "text": "강연을 들은 집단에서"
 },
 {
  "id": "V117",
  "text": "더 크게 떨어졌습니다."
 },
 {
  "id": "V118",
  "text": "연구진은 본인의 관심사는"
 },
 {
  "id": "V119",
  "text": "이미 정해져 있다고 믿는 사람에게"
 },
 {
  "id": "V120",
  "text": "어려움이 생기면"
 },
 {
  "id": "V121",
  "text": "이것이 자신의 진짜 관심사가"
 },
 {
  "id": "V122",
  "text": "아니라는 신호처럼"
 },
 {
  "id": "V123",
  "text": "받아들여질 수 있다고 설명했습니다."
 },
 {
  "id": "V124",
  "text": "이 관점을 앞서"
 },
 {
  "id": "V125",
  "text": "그림을 그리던 장면에"
 },
 {
  "id": "V126",
  "text": "가져와 보겠습니다."
 },
 {
  "id": "V127",
  "text": "얼굴을 그리는데"
 },
 {
  "id": "V128",
  "text": "자꾸 비율이 어긋납니다."
 },
 {
  "id": "V129",
  "text": "정말 좋아하는 일이면"
 },
 {
  "id": "V130",
  "text": "계속 재밌어야 할 텐데"
 },
 {
  "id": "V131",
  "text": "이렇게 답답한 걸 보니"
 },
 {
  "id": "V132",
  "text": "내 취미는 아닌가 봐."
 },
 {
  "id": "V133",
  "text": "이렇게 생각하면"
 },
 {
  "id": "V134",
  "text": "아직 익숙하지 않아서 겪는 어려움을"
 },
 {
  "id": "V135",
  "text": "관심이 없다는 증거로"
 },
 {
  "id": "V136",
  "text": "받아들이게 될 수 있습니다."
 },
 {
  "id": "V137",
  "text": "하지만 같은 순간에"
 },
 {
  "id": "V138",
  "text": "이렇게 물어볼 수도 있습니다."
 },
 {
  "id": "V139",
  "text": "그림을 그리는 일이"
 },
 {
  "id": "V140",
  "text": "쉬워진 걸까요"
 },
 {
  "id": "V141",
  "text": "아니면 그리고 싶은데"
 },
 {
  "id": "V142",
  "text": "아직 원하는 대로 그리지 못해서"
 },
 {
  "id": "V143",
  "text": "답답한 걸까요?"
 },
 {
  "id": "V144",
  "text": "그림 자체에 마음이 가지 않는다면"
 },
 {
  "id": "V145",
  "text": "다른 활동을 골라도 됩니다."
 },
 {
  "id": "V146",
  "text": "그런데 그리고 싶은 마음은 남아 있다면"
 },
 {
  "id": "V147",
  "text": "지금 필요한 것은"
 },
 {
  "id": "V148",
  "text": "조금 더 쉬운 그림일 수도 있죠."
 },
 {
  "id": "V149",
  "text": "막 싹이 난 화분을 보고"
 },
 {
  "id": "V150",
  "text": "꽃이 없으니"
 },
 {
  "id": "V151",
  "text": "꽃이 피지 않는 식물이라고"
 },
 {
  "id": "V152",
  "text": "단정할 수는 없습니다."
 },
 {
  "id": "V153",
  "text": "작은 관심에도"
 },
 {
  "id": "V154",
  "text": "아직 경험해 보지 못한 재미가"
 },
 {
  "id": "V155",
  "text": "남아 있을 수 있습니다."
 },
 {
  "id": "V156",
  "text": "그렇다고 관심이 생긴 뒤에는"
 },
 {
  "id": "V157",
  "text": "연습만 계속하면 되는 걸까요?"
 },
 {
  "id": "V158",
  "text": "이제 다른 문제가 나타납니다."
 },
 {
  "id": "V159",
  "text": "좋아하는 일을 시작했는데"
 },
 {
  "id": "V160",
  "text": "어느새 잘해야 할 일이 되는 겁니다."
 },
 {
  "id": "V161",
  "text": "사진을 찍으러 나갔습니다."
 },
 {
  "id": "V162",
  "text": "처음에는 길가의 빛이 예뻐서 찍었습니다."
 },
 {
  "id": "V163",
  "text": "그런데 사진을 올리고"
 },
 {
  "id": "V164",
  "text": "반응을 확인하기 시작합니다."
 },
 {
  "id": "V165",
  "text": "어느 순간부터"
 },
 {
  "id": "V166",
  "text": "내가 좋아하는 장면보다"
 },
 {
  "id": "V167",
  "text": "다른 사람이 좋아할 사진을"
 },
 {
  "id": "V168",
  "text": "먼저 생각합니다."
 },
 {
  "id": "V169",
  "text": "처음에는 취미를 더 즐기려고"
 },
 {
  "id": "V170",
  "text": "시작한 일이었는데"
 },
 {
  "id": "V171",
  "text": "평가를 받을 준비가 안 된 날에는"
 },
 {
  "id": "V172",
  "text": "아예 하고 싶지 않아집니다."
 },
 {
  "id": "V173",
  "text": "이 변화를 생각해 볼 만한"
 },
 {
  "id": "V174",
  "text": "오래된 실험이 있습니다."
 },
 {
  "id": "V175",
  "text": "한 유치원에"
 },
 {
  "id": "V176",
  "text": "그림 그리기를 좋아하는"
 },
 {
  "id": "V177",
  "text": "아이들이 있습니다."
 },
 {
  "id": "V178",
  "text": "아이들을 세 그룹으로 나눕니다."
 },
 {
  "id": "V179",
  "text": "에이 그룹의 아이들에게는"
 },
 {
  "id": "V180",
  "text": "그림을 그리면"
 },
 {
  "id": "V181",
  "text": "상을 주기로 약속하고"
 },
 {
  "id": "V182",
  "text": "비 그룹의 아이들에게는"
 },
 {
  "id": "V183",
  "text": "상에 관한 말 없이"
 },
 {
  "id": "V184",
  "text": "그림을 그렸다가"
 },
 {
  "id": "V185",
  "text": "나중에 예상하지 못한 상을 줬습니다."
 },
 {
  "id": "V186",
  "text": "C그룹의 아이들은"
 },
 {
  "id": "V187",
  "text": "상을 따로 주지 않았습니다."
 },
 {
  "id": "V188",
  "text": "이후 자유롭게 놀 수 있는 시간에"
 },
 {
  "id": "V189",
  "text": "아이들이 얼마나 그림을 그리는지"
 },
 {
  "id": "V190",
  "text": "관찰했습니다."
 },
 {
  "id": "V191",
  "text": "상을 받은 아이들이"
 },
 {
  "id": "V192",
  "text": "더 자주 그림을 그렸을까요?"
 },
 {
  "id": "V193",
  "text": "놀랍게도 미리 상을 받기로 했던"
 },
 {
  "id": "V194",
  "text": "에이 그룹 아이들은"
 },
 {
  "id": "V195",
  "text": "다른 두 집단보다"
 },
 {
  "id": "V196",
  "text": "그림 그리는 데 적은 시간을 썼습니다."
 },
 {
  "id": "V197",
  "text": "똑같이 상을 받았어도"
 },
 {
  "id": "V198",
  "text": "예상하지 못한 상을 받은"
 },
 {
  "id": "V199",
  "text": "비 그룹에서는"
 },
 {
  "id": "V200",
  "text": "그런 감소가 나타나지 않았습니다."
 },
 {
  "id": "V201",
  "text": "이 연구는 과잉정당화 효과를"
 },
 {
  "id": "V202",
  "text": "보여 주는 대표적인 사례입니다."
 },
 {
  "id": "V203",
  "text": "원래 좋아서 하던 활동에"
 },
 {
  "id": "V204",
  "text": "외적인 보상을 얻기 위한 이유가"
 },
 {
  "id": "V205",
  "text": "더해지면서"
 },
 {
  "id": "V206",
  "text": "스스로 그 활동을 선택하는 마음이"
 },
 {
  "id": "V207",
  "text": "약해질 수 있다는 것입니다."
 },
 {
  "id": "V208",
  "text": "이 장면을 보며 우리 취미에도"
 },
 {
  "id": "V209",
  "text": "질문 하나를 가져와 볼 수 있습니다."
 },
 {
  "id": "V210",
  "text": "나는 지금 이 활동의"
 },
 {
  "id": "V211",
  "text": "어떤 부분을 좋아하고 있을까요?"
 },
 {
  "id": "V212",
  "text": "하는 과정일까요"
 },
 {
  "id": "V213",
  "text": "아니면 끝낸 뒤에 받을 반응일까요?"
 },
 {
  "id": "V214",
  "text": "칭찬받으면 기분이 좋은 것은"
 },
 {
  "id": "V215",
  "text": "자연스럽습니다."
 },
 {
  "id": "V216",
  "text": "다만 그 이유만 남는다면"
 },
 {
  "id": "V217",
  "text": "아무도 봐 주지 않는 날에는"
 },
 {
  "id": "V218",
  "text": "다시 시작할 이유를"
 },
 {
  "id": "V219",
  "text": "찾기 어려울 수 있겠죠."
 },
 {
  "id": "V220",
  "text": "그런데 평가를 내려놓고"
 },
 {
  "id": "V221",
  "text": "자유시간까지 생겼는데도"
 },
 {
  "id": "V222",
  "text": "무엇을 해야 즐거울지"
 },
 {
  "id": "V223",
  "text": "모르겠다면 어떨까요?"
 },
 {
  "id": "V224",
  "text": "시간이 많아지면 저절로"
 },
 {
  "id": "V225",
  "text": "좋아하는 일에 빠져들게 되는 걸까요?"
 },
 {
  "id": "V226",
  "text": "지금 여러분이 작은 호출기를 가지고"
 },
 {
  "id": "V227",
  "text": "하루를 보낸다고 생각해 보겠습니다."
 },
 {
  "id": "V228",
  "text": "일을 하다가도 집에서 쉬다가도"
 },
 {
  "id": "V229",
  "text": "불규칙하게 신호가 울립니다."
 },
 {
  "id": "V230",
  "text": "그때마다 잠시 멈춰"
 },
 {
  "id": "V231",
  "text": "지금 무엇을 하고 있는지와"
 },
 {
  "id": "V232",
  "text": "기분이 어떤지를 적습니다."
 },
 {
  "id": "V233",
  "text": "지금 하는 일이 얼마나 도전적인지와"
 },
 {
  "id": "V234",
  "text": "그 일을 해낼 능력이"
 },
 {
  "id": "V235",
  "text": "어느 정도인지도 함께 평가합니다."
 },
 {
  "id": "V236",
  "text": "연구진은 직장인 일흔여덟 명에게"
 },
 {
  "id": "V237",
  "text": "일주일 동안 이런 기록을 남기게 했습니다."
 },
 {
  "id": "V238",
  "text": "지금 하는 일이 얼마나 도전적인지와"
 },
 {
  "id": "V239",
  "text": "그 일을 해낼 능력이"
 },
 {
  "id": "V240",
  "text": "어느 정도인지도 함께 평가합니다."
 },
 {
  "id": "V241",
  "text": "결과는 조금 의외였습니다."
 },
 {
  "id": "V242",
  "text": "몰입으로 분류된 순간은"
 },
 {
  "id": "V243",
  "text": "여가를 보낼 때보다"
 },
 {
  "id": "V244",
  "text": "일할 때 더 많이 나타났습니다."
 },
 {
  "id": "V245",
  "text": "그런데 정작 사람들은"
 },
 {
  "id": "V246",
  "text": "일하는 동안 다른 것을 하고 싶어 하는"
 },
 {
  "id": "V247",
  "text": "경우가 더 많았습니다."
 },
 {
  "id": "V248",
  "text": "일에서 벗어나 자유롭게"
 },
 {
  "id": "V249",
  "text": "시간을 보내고 싶은 마음과"
 },
 {
  "id": "V250",
  "text": "실제로 몰입하는 경험이"
 },
 {
  "id": "V251",
  "text": "꼭 일치하지는 않았던 겁니다."
 },
 {
  "id": "V252",
  "text": "취미를 찾을 때도 여기서"
 },
 {
  "id": "V253",
  "text": "한 가지 질문을 가져와 볼 수 있습니다."
 },
 {
  "id": "V254",
  "text": "나는 무엇을 하고 싶다고"
 },
 {
  "id": "V255",
  "text": "생각하는지뿐 아니라"
 },
 {
  "id": "V256",
  "text": "실제로 무엇을 할 때"
 },
 {
  "id": "V257",
  "text": "빠져드는지도 알고 있을까요?"
 },
 {
  "id": "V258",
  "text": "우리는 시간이 생기면"
 },
 {
  "id": "V259",
  "text": "좋아하는 일에 푹 빠져 지낼 수 있을 거라고"
 },
 {
  "id": "V260",
  "text": "기대합니다."
 },
 {
  "id": "V261",
  "text": "하지만 막상 시간이 나도"
 },
 {
  "id": "V262",
  "text": "무엇을 해야 할지 몰라"
 },
 {
  "id": "V263",
  "text": "망설일 때가 있죠."
 },
 {
  "id": "V264",
  "text": "그럴 때는 머릿속으로"
 },
 {
  "id": "V265",
  "text": "잘 맞을 취미를 고르는 것만으로는"
 },
 {
  "id": "V266",
  "text": "답을 찾기 어려울 수 있습니다."
 },
 {
  "id": "V267",
  "text": "어떤 재미가 있는지는"
 },
 {
  "id": "V268",
  "text": "직접 해 봐야 알게 되는 경우도"
 },
 {
  "id": "V269",
  "text": "있으니까요."
 },
 {
  "id": "V270",
  "text": "예를 들어 멋진 그림을 보고"
 },
 {
  "id": "V271",
  "text": "나도 한번 그려 보고 싶어졌다고"
 },
 {
  "id": "V272",
  "text": "해 보겠습니다."
 },
 {
  "id": "V273",
  "text": "막상 그려 보니"
 },
 {
  "id": "V274",
  "text": "원하는 모양을 잡는 건"
 },
 {
  "id": "V275",
  "text": "생각보다 어렵습니다."
 },
 {
  "id": "V276",
  "text": "그런데 색을 섞는 과정은"
 },
 {
  "id": "V277",
  "text": "꽤 재미있습니다."
 },
 {
  "id": "V278",
  "text": "파란색에 흰색을 조금 더 넣어 보고"
 },
 {
  "id": "V279",
  "text": "다른 색도 옆에 칠해 봅니다."
 },
 {
  "id": "V280",
  "text": "어떤 색이 나올지 궁금해서"
 },
 {
  "id": "V281",
  "text": "몇 번 더 붓을 움직이게 되죠."
 },
 {
  "id": "V282",
  "text": "시작하기 전에는"
 },
 {
  "id": "V283",
  "text": "그저 그림을 그려 보고 싶었습니다."
 },
 {
  "id": "V284",
  "text": "해 보고 나니 그 안에서도"
 },
 {
  "id": "V285",
  "text": "내가 재미를 느끼는 부분을"
 },
 {
  "id": "V286",
  "text": "조금은 알게 된 겁니다."
 },
 {
  "id": "V287",
  "text": "그러면 다음에는"
 },
 {
  "id": "V288",
  "text": "좋아하는 색으로"
 },
 {
  "id": "V289",
  "text": "무언가를 그려 보고 싶어질 수도 있습니다."
 },
 {
  "id": "V290",
  "text": "이런 경험이 쌓이면서"
 },
 {
  "id": "V291",
  "text": "막연했던 관심은"
 },
 {
  "id": "V292",
  "text": "조금씩 구체적인 취향이 되어 갈 수 있습니다."
 },
 {
  "id": "V293",
  "text": "좋아하는 게 분명한 사람도"
 },
 {
  "id": "V294",
  "text": "처음부터 자신에게 맞는 취미를"
 },
 {
  "id": "V295",
  "text": "정확히 알았던 건 아닐 수 있다는 거죠."
 },
 {
  "id": "V296",
  "text": "해 보면서 재미있는 부분을 발견하고"
 },
 {
  "id": "V297",
  "text": "다시 해 보면서"
 },
 {
  "id": "V298",
  "text": "좋아하는 마음을 키워 왔을 수 있습니다."
 },
 {
  "id": "V299",
  "text": "그렇다면 아직 뚜렷한 취미가 없는 우리는"
 },
 {
  "id": "V300",
  "text": "어디서부터 시작하면 좋을까요?"
 },
 {
  "id": "V301",
  "text": "첫째."
 },
 {
  "id": "V302",
  "text": "평생 좋아할 취미를 고르기 전에"
 },
 {
  "id": "V303",
  "text": "조금 궁금한 활동을 한 번 해 보세요."
 },
 {
  "id": "V304",
  "text": "처음이 매끄럽지 않았다는 사실만으로"
 },
 {
  "id": "V305",
  "text": "나와 맞지 않는다고"
 },
 {
  "id": "V306",
  "text": "결론 내릴 필요는 없습니다."
 },
 {
  "id": "V307",
  "text": "이번 주에 해 볼 활동을 하나 고르되"
 },
 {
  "id": "V308",
  "text": "처음부터 내 취미라는 이름까지"
 },
 {
  "id": "V309",
  "text": "붙이지는 마세요."
 },
 {
  "id": "V310",
  "text": "사진이 궁금하다면"
 },
 {
  "id": "V311",
  "text": "지금 쓰는 휴대폰으로"
 },
 {
  "id": "V312",
  "text": "마음에 드는 빛을 찍어 볼 수 있습니다."
 },
 {
  "id": "V313",
  "text": "끝나면 재능이 있는지부터"
 },
 {
  "id": "V314",
  "text": "평가하기보다"
 },
 {
  "id": "V315",
  "text": "두 가지를 살펴보세요."
 },
 {
  "id": "V316",
  "text": "어느 순간이 괜찮았는지"
 },
 {
  "id": "V317",
  "text": "그리고 무엇 때문에"
 },
 {
  "id": "V318",
  "text": "하기 싫어졌는지를요."
 },
 {
  "id": "V319",
  "text": "색을 고를 때는 좋았는데"
 },
 {
  "id": "V320",
  "text": "얼굴을 똑같이 그리는 게 답답했다면"
 },
 {
  "id": "V321",
  "text": "다음에는 색을 쓰는"
 },
 {
  "id": "V322",
  "text": "다른 그림을 시도해 볼 수 있습니다."
 },
 {
  "id": "V323",
  "text": "좋았던 순간을 알아내면"
 },
 {
  "id": "V324",
  "text": "다음 시도에 남길 것이 생깁니다."
 },
 {
  "id": "V325",
  "text": "불편했던 부분을 알아내면"
 },
 {
  "id": "V326",
  "text": "바꿔 볼 것이 생기고요."
 },
 {
  "id": "V327",
  "text": "여러 번 해 봐도"
 },
 {
  "id": "V328",
  "text": "마음이 가지 않는다면"
 },
 {
  "id": "V329",
  "text": "다른 활동으로 옮겨 가도 됩니다."
 },
 {
  "id": "V330",
  "text": "어떤 방식이 나와 맞지 않는지"
 },
 {
  "id": "V331",
  "text": "알아낸 것도"
 },
 {
  "id": "V332",
  "text": "다음 선택에 쓸 수 있는 경험입니다."
 },
 {
  "id": "V333",
  "text": "하지만 다시 해 볼 마음이 생겨도"
 },
 {
  "id": "V334",
  "text": "매번 너무 어렵다면"
 },
 {
  "id": "V335",
  "text": "금세 지치기 마련입니다."
 },
 {
  "id": "V336",
  "text": "그래서 두 번째 방법이 필요합니다."
 },
 {
  "id": "V337",
  "text": "둘째."
 },
 {
  "id": "V338",
  "text": "지금 할 수 있는 것보다"
 },
 {
  "id": "V339",
  "text": "조금만 어려운 목표를 만들어 보세요."
 },
 {
  "id": "V340",
  "text": "앞서 몰입 연구에서 살핀 것은"
 },
 {
  "id": "V341",
  "text": "지금 어떤 활동을 하고 있는지뿐 아니라"
 },
 {
  "id": "V342",
  "text": "그 안에서 느끼는 도전과 능력이었습니다."
 },
 {
  "id": "V343",
  "text": "이 관점을 취미에 적용한다면"
 },
 {
  "id": "V344",
  "text": "활동의 이름보다"
 },
 {
  "id": "V345",
  "text": "내가 지금 무엇에 도전하고 있는지"
 },
 {
  "id": "V346",
  "text": "살펴볼 수 있습니다."
 },
 {
  "id": "V347",
  "text": "기타를 처음 잡았는데"
 },
 {
  "id": "V348",
  "text": "좋아하는 노래 한 곡을"
 },
 {
  "id": "V349",
  "text": "완벽하게 치려고 하면 막막합니다."
 },
 {
  "id": "V350",
  "text": "오늘은 두 코드를 바꿀 때"
 },
 {
  "id": "V351",
  "text": "소리가 끊기지 않게 해 보는 겁니다."
 },
 {
  "id": "V352",
  "text": "성공했는지 스스로 확인할 수 있을 만큼"
 },
 {
  "id": "V353",
  "text": "목표를 구체적으로 만드는 것이죠."
 },
 {
  "id": "V354",
  "text": "해 보니 여전히 어렵다면"
 },
 {
  "id": "V355",
  "text": "더 쉬운 부분으로 바꿔 보세요."
 },
 {
  "id": "V356",
  "text": "이미 너무 익숙하다면"
 },
 {
  "id": "V357",
  "text": "작은 변화를 하나 더해 보고요."
 },
 {
  "id": "V358",
  "text": "취미의 난이도를"
 },
 {
  "id": "V359",
  "text": "처음 선택한 그대로"
 },
 {
  "id": "V360",
  "text": "견뎌야 하는 것은 아닙니다."
 },
 {
  "id": "V361",
  "text": "어제는 구분하지 못했던 소리가 들리거나"
 },
 {
  "id": "V362",
  "text": "전에는 놓쳤던 모양이"
 },
 {
  "id": "V363",
  "text": "보일 수도 있습니다."
 },
 {
  "id": "V364",
  "text": "처음부터 큰 열정이 없어도"
 },
 {
  "id": "V365",
  "text": "이런 작은 궁금증을"
 },
 {
  "id": "V366",
  "text": "따라가 볼 수 있습니다."
 },
 {
  "id": "V367",
  "text": "이번에는 왜 잘됐는지"
 },
 {
  "id": "V368",
  "text": "다음에는 조금 더 자연스럽게"
 },
 {
  "id": "V369",
  "text": "할 수 있을지 말입니다."
 },
 {
  "id": "V370",
  "text": "그런데 작은 진전이 생기면"
 },
 {
  "id": "V371",
  "text": "또다시 남에게 보여 줄 결과에만"
 },
 {
  "id": "V372",
  "text": "마음이 쏠릴 수 있습니다."
 },
 {
  "id": "V373",
  "text": "마지막 방법은"
 },
 {
  "id": "V374",
  "text": "그렇게 자라기 시작한 관심을"
 },
 {
  "id": "V375",
  "text": "지키는 데 관한 것입니다."
 },
 {
  "id": "V376",
  "text": "셋째."
 },
 {
  "id": "V377",
  "text": "남에게 보여 주지 않아도 괜찮은"
 },
 {
  "id": "V378",
  "text": "취미 시간을 남겨 두세요."
 },
 {
  "id": "V379",
  "text": "그림을 그린 아이들의 실험에서는"
 },
 {
  "id": "V380",
  "text": "같은 상이라도"
 },
 {
  "id": "V381",
  "text": "미리 약속했는지에 따라"
 },
 {
  "id": "V382",
  "text": "이후 행동이 달랐습니다."
 },
 {
  "id": "V383",
  "text": "취미에서도 내가 무엇을 기대하며"
 },
 {
  "id": "V384",
  "text": "시작하는지 살펴볼 수 있겠습니다."
 },
 {
  "id": "V385",
  "text": "오늘 찍는 사진 중에는"
 },
 {
  "id": "V386",
  "text": "올리지 않을 사진이 있어도 됩니다."
 },
 {
  "id": "V387",
  "text": "악기를 연주한 시간도"
 },
 {
  "id": "V388",
  "text": "녹음해서 누군가에게"
 },
 {
  "id": "V389",
  "text": "들려줄 필요는 없죠."
 },
 {
  "id": "V390",
  "text": "예를 들어 오늘은 십 분 동안"
 },
 {
  "id": "V391",
  "text": "마음에 드는 색을 써 보고"
 },
 {
  "id": "V392",
  "text": "그 종이는 그대로 덮어 두는 겁니다."
 },
 {
  "id": "V393",
  "text": "끝난 뒤 잘했는지보다"
 },
 {
  "id": "V394",
  "text": "어떤 색을 고를 때 좋았는지"
 },
 {
  "id": "V395",
  "text": "떠올려 보세요."
 },
 {
  "id": "V396",
  "text": "십 분은 정답이 아니라"
 },
 {
  "id": "V397",
  "text": "남의 반응 없이 해 볼 시간을"
 },
 {
  "id": "V398",
  "text": "정하기 위한 예시입니다."
 },
 {
  "id": "V399",
  "text": "혼자만 즐기라는 뜻은 아닙니다."
 },
 {
  "id": "V400",
  "text": "친구와 함께하는 시간이 좋다면"
 },
 {
  "id": "V401",
  "text": "그것도 내 취미의"
 },
 {
  "id": "V402",
  "text": "중요한 즐거움입니다."
 },
 {
  "id": "V403",
  "text": "다만 다른 사람이 반응하지 않는 날에도"
 },
 {
  "id": "V404",
  "text": "내가 좋아했던 부분을"
 },
 {
  "id": "V405",
  "text": "알아볼 수 있었으면 합니다."
 },
 {
  "id": "V406",
  "text": "취미가 있다는 것은"
 },
 {
  "id": "V407",
  "text": "내가 어떤 시간을 좋아하는지"
 },
 {
  "id": "V408",
  "text": "조금 더 알고 있다는 말일 수도 있겠습니다."
 },
 {
  "id": "V409",
  "text": "생각해 보면 우리가 부러워했던 사람은"
 },
 {
  "id": "V410",
  "text": "꼭 취미 실력이 뛰어난 사람만은"
 },
 {
  "id": "V411",
  "text": "아니었습니다."
 },
 {
  "id": "V412",
  "text": "다음 주말에 무엇을 할지 이야기할 때"
 },
 {
  "id": "V413",
  "text": "표정이 밝아지는 사람"
 },
 {
  "id": "V414",
  "text": "별것 아닌 경험도 자기에게는"
 },
 {
  "id": "V415",
  "text": "재미있었다고 말할 수 있는"
 },
 {
  "id": "V416",
  "text": "사람이었겠죠."
 },
 {
  "id": "V417",
  "text": "그런 마음이 언제부터 생겼는지는"
 },
 {
  "id": "V418",
  "text": "겉으로 잘 보이지 않습니다."
 },
 {
  "id": "V419",
  "text": "지금은 취향이 분명한 사람에게도"
 },
 {
  "id": "V420",
  "text": "처음 골라 보던 날과"
 },
 {
  "id": "V421",
  "text": "생각보다 재미없었던 날과"
 },
 {
  "id": "V422",
  "text": "조금 익숙해져"
 },
 {
  "id": "V423",
  "text": "다시 해 보고 싶었던 날이"
 },
 {
  "id": "V424",
  "text": "있었을 수 있습니다."
 },
 {
  "id": "V425",
  "text": "그리고 음악을 듣거나"
 },
 {
  "id": "V426",
  "text": "좋아하는 이야기를 즐기는 것도"
 },
 {
  "id": "V427",
  "text": "취미가 될 수 있습니다."
 },
 {
  "id": "V428",
  "text": "남에게 보여 줄 결과물이 있어야만"
 },
 {
  "id": "V429",
  "text": "취미인 것은 아닙니다."
 },
 {
  "id": "V430",
  "text": "물론 모든 활동을 오래 붙잡는다고"
 },
 {
  "id": "V431",
  "text": "좋아하게 되는 것은 아닙니다."
 },
 {
  "id": "V432",
  "text": "그만두는 선택도 할 수 있고"
 },
 {
  "id": "V433",
  "text": "오래 좋아하던 것을"
 },
 {
  "id": "V434",
  "text": "잠시 쉬어 갈 수도 있습니다."
 },
 {
  "id": "V435",
  "text": "관심을 키운다는 것은"
 },
 {
  "id": "V436",
  "text": "내 마음을 무시한 채"
 },
 {
  "id": "V437",
  "text": "버틴다는 뜻이 아니니까요."
 },
 {
  "id": "V438",
  "text": "다만 작은 관심이 생겼을 때"
 },
 {
  "id": "V439",
  "text": "아직 잘하지 못한다는 이유로"
 },
 {
  "id": "V440",
  "text": "너무 빨리 치워 버리지는"
 },
 {
  "id": "V441",
  "text": "않았으면 합니다."
 },
 {
  "id": "V442",
  "text": "무엇이 좋았는지 살펴보고"
 },
 {
  "id": "V443",
  "text": "나에게 맞는 방식을 바꿔 가며"
 },
 {
  "id": "V444",
  "text": "조금 더 알아갈 기회를 주는 겁니다."
 },
 {
  "id": "V445",
  "text": "취미를 묻는 말에"
 },
 {
  "id": "V446",
  "text": "꼭 완성된 대답을 준비할 필요도"
 },
 {
  "id": "V447",
  "text": "없겠습니다."
 },
 {
  "id": "V448",
  "text": "요즘은 이것을 조금씩 해 보고 있어요."
 },
 {
  "id": "V449",
  "text": "그 정도의 대답으로도"
 },
 {
  "id": "V450",
  "text": "지금의 나를 충분히"
 },
 {
  "id": "V451",
  "text": "이야기할 수 있습니다."
 },
 {
  "id": "V452",
  "text": "좋아하는 마음이 분명해진 뒤에만"
 },
 {
  "id": "V453",
  "text": "시작할 수 있는 것은 아닙니다."
 },
 {
  "id": "V454",
  "text": "조금 해 보고 조금 알아가면서"
 },
 {
  "id": "V455",
  "text": "그 마음이 더 분명해질 수도 있습니다."
 },
 {
  "id": "V456",
  "text": "여러분에게도 처음에는"
 },
 {
  "id": "V457",
  "text": "별생각 없이 시작했다가"
 },
 {
  "id": "V458",
  "text": "점점 좋아진 활동이 있나요?"
 },
 {
  "id": "V459",
  "text": "여러분들만의 경험이 있다면"
 },
 {
  "id": "V460",
  "text": "댓글로 공유해 주세요."
 }
]