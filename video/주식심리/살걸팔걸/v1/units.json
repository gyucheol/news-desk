[
 {
  "id": "V001",
  "text": "당신은 오늘 점심을 먹다가"
 },
 {
  "id": "V002",
  "text": "주식 앱을 엽니다."
 },
 {
  "id": "V003",
  "text": "한 달 전부터 지켜보던 종목이"
 },
 {
  "id": "V004",
  "text": "오늘도 올랐습니다."
 },
 {
  "id": "V005",
  "text": "처음 눈여겨봤을 때 샀다면"
 },
 {
  "id": "V006",
  "text": "벌써 삼십 퍼센트 넘게 벌었을 겁니다."
 },
 {
  "id": "V007",
  "text": "아 그때 살걸."
 },
 {
  "id": "V008",
  "text": "친구 단톡방에는 그 종목으로"
 },
 {
  "id": "V009",
  "text": "수익을 냈다고 자랑하는 인증이"
 },
 {
  "id": "V010",
  "text": "연달아 올라옵니다."
 },
 {
  "id": "V011",
  "text": "뉴스에도 그 회사가 대형 호재로"
 },
 {
  "id": "V012",
  "text": "주가가 폭등했다고 나옵니다."
 },
 {
  "id": "V013",
  "text": "이대로 지나치면"
 },
 {
  "id": "V014",
  "text": "또 후회할 것만 같습니다."
 },
 {
  "id": "V015",
  "text": "그래서 퇴근길 지하철에서"
 },
 {
  "id": "V016",
  "text": "매수 버튼을 누릅니다."
 },
 {
  "id": "V017",
  "text": "그런데 다음 날 아침"
 },
 {
  "id": "V018",
  "text": "주가는 산 가격보다 오 퍼센트 떨어져 있습니다."
 },
 {
  "id": "V019",
  "text": "조금만 기다리면 오를 거라고 믿었지만"
 },
 {
  "id": "V020",
  "text": "주가는 일주일 내내 내려갑니다."
 },
 {
  "id": "V021",
  "text": "결국 더 잃기 전에 팔기로 합니다."
 },
 {
  "id": "V022",
  "text": "그리고 판 바로 다음 날"
 },
 {
  "id": "V023",
  "text": "그 종목은 다시 오르기 시작합니다."
 },
 {
  "id": "V024",
  "text": "팔지 말걸."
 },
 {
  "id": "V025",
  "text": "아니 처음부터 사지 말걸."
 },
 {
  "id": "V026",
  "text": "나만 사면 떨어지고"
 },
 {
  "id": "V027",
  "text": "나만 팔면 오르는 것 같습니다."
 },
 {
  "id": "V028",
  "text": "누군가 내 계좌만"
 },
 {
  "id": "V029",
  "text": "지켜보고 있는 걸까요?"
 },
 {
  "id": "V030",
  "text": "아니면 나는 원래"
 },
 {
  "id": "V031",
  "text": "주식에 맞지 않는 사람일까요?"
 },
 {
  "id": "V032",
  "text": "오늘은 내가 사면 떨어지고"
 },
 {
  "id": "V033",
  "text": "팔면 오르는 것처럼 느껴지는"
 },
 {
  "id": "V034",
  "text": "이유를 살펴보고"
 },
 {
  "id": "V035",
  "text": "살걸 팔걸 하는 후회에"
 },
 {
  "id": "V036",
  "text": "덜 흔들리는 방법 세 가지를"
 },
 {
  "id": "V037",
  "text": "이야기해 보겠습니다."
 },
 {
  "id": "V038",
  "text": "어떤 종목을 사라거나"
 },
 {
  "id": "V039",
  "text": "팔라는 이야기는 아닙니다."
 },
 {
  "id": "V040",
  "text": "사고파는 순간에 벌어지는"
 },
 {
  "id": "V041",
  "text": "심리에 대한 이야기입니다."
 },
 {
  "id": "V042",
  "text": "먼저 조금 뜻밖의 이야기부터"
 },
 {
  "id": "V043",
  "text": "해 보겠습니다."
 },
 {
  "id": "V044",
  "text": "내가 사면 떨어진다는 말이"
 },
 {
  "id": "V045",
  "text": "꼭 기분 탓만은 아닐 수 있습니다."
 },
 {
  "id": "V046",
  "text": "미국의 재무학자 오딘은"
 },
 {
  "id": "V047",
  "text": "한 대형 증권사 고객 만 명이"
 },
 {
  "id": "V048",
  "text": "칠 년 동안 거래한 기록을 살펴봤습니다."
 },
 {
  "id": "V049",
  "text": "그랬더니 사람들이 산 종목은"
 },
 {
  "id": "V050",
  "text": "판 종목보다 그다음 일 년 동안"
 },
 {
  "id": "V051",
  "text": "평균 삼 퍼센트 정도 낮은 수익을 냈습니다."
 },
 {
  "id": "V052",
  "text": "산 것은 덜 오르고"
 },
 {
  "id": "V053",
  "text": "판 것은 더 오른 셈이죠."
 },
 {
  "id": "V054",
  "text": "그렇다면 우리는 언제"
 },
 {
  "id": "V055",
  "text": "어떤 종목을 사게 될까요?"
 },
 {
  "id": "V056",
  "text": "그날 매수 버튼을 누른 순간을"
 },
 {
  "id": "V057",
  "text": "다시 떠올려 보겠습니다."
 },
 {
  "id": "V058",
  "text": "한 달 동안 지켜보기만 하던 종목을"
 },
 {
  "id": "V059",
  "text": "하필 그날 샀습니다."
 },
 {
  "id": "V060",
  "text": "단톡방에 수익 인증이 올라오고"
 },
 {
  "id": "V061",
  "text": "뉴스에 회사 이름이 나온 날이었죠."
 },
 {
  "id": "V062",
  "text": "주식 시장에는"
 },
 {
  "id": "V063",
  "text": "수천 개의 종목이 있습니다."
 },
 {
  "id": "V064",
  "text": "그 많은 종목을 하나하나 비교해 보고"
 },
 {
  "id": "V065",
  "text": "고르기는 어렵죠."
 },
 {
  "id": "V066",
  "text": "오딘은 이 문제도 살펴봤습니다."
 },
 {
  "id": "V067",
  "text": "이번에는 종목이"
 },
 {
  "id": "V068",
  "text": "사람들의 눈길을 끄는 날에 발생한"
 },
 {
  "id": "V069",
  "text": "증권사 고객 칠만 팔천 가구의"
 },
 {
  "id": "V070",
  "text": "거래 기록을 분석했습니다."
 },
 {
  "id": "V071",
  "text": "뉴스에 나온 날"
 },
 {
  "id": "V072",
  "text": "거래량이 갑자기 몰린 날"
 },
 {
  "id": "V073",
  "text": "전날 주가가 크게 움직인 날이었죠."
 },
 {
  "id": "V074",
  "text": "그리고 이런 날"
 },
 {
  "id": "V075",
  "text": "누가 사고 누가 파는지 살펴봤습니다."
 },
 {
  "id": "V076",
  "text": "개인 투자자들은"
 },
 {
  "id": "V077",
  "text": "어떻게 움직였을까요?"
 },
 {
  "id": "V078",
  "text": "거래량이 갑자기 몰린 종목을"
 },
 {
  "id": "V079",
  "text": "개인 투자자들은 판 횟수보다"
 },
 {
  "id": "V080",
  "text": "두 배 가까이 많이 샀습니다."
 },
 {
  "id": "V081",
  "text": "전날 주가가 크게 떨어진 종목도"
 },
 {
  "id": "V082",
  "text": "마찬가지였습니다."
 },
 {
  "id": "V083",
  "text": "오른 종목만 산 게 아니었던 거죠."
 },
 {
  "id": "V084",
  "text": "오르든 떨어지든"
 },
 {
  "id": "V085",
  "text": "눈에 띄면 사는 쪽이 많았습니다."
 },
 {
  "id": "V086",
  "text": "문제는 내 눈길을 끈 소식이라면"
 },
 {
  "id": "V087",
  "text": "다른 사람들도 이미 봤을"
 },
 {
  "id": "V088",
  "text": "가능성이 크다는 점입니다."
 },
 {
  "id": "V089",
  "text": "연구진은 그런 소식이"
 },
 {
  "id": "V090",
  "text": "주가에 먼저 반영돼 있을 수 있다고"
 },
 {
  "id": "V091",
  "text": "짚었습니다."
 },
 {
  "id": "V092",
  "text": "한마디로 내가 사고 싶어지는 순간은"
 },
 {
  "id": "V093",
  "text": "그 종목이 가장 눈에 띄는 순간과"
 },
 {
  "id": "V094",
  "text": "겹치기 쉽다는 것입니다."
 },
 {
  "id": "V095",
  "text": "그렇다면 내가 팔면"
 },
 {
  "id": "V096",
  "text": "오르는 것처럼 느껴지는 건 왜일까요?"
 },
 {
  "id": "V097",
  "text": "판 지 사흘째 되는 밤 열한 시입니다."
 },
 {
  "id": "V098",
  "text": "잠들기 전 습관처럼 주식 앱을 엽니다."
 },
 {
  "id": "V099",
  "text": "그 종목은 아직"
 },
 {
  "id": "V100",
  "text": "관심 목록에 그대로 있습니다."
 },
 {
  "id": "V101",
  "text": "팔고 나서도 출근길이며 점심시간이며"
 },
 {
  "id": "V102",
  "text": "틈틈이 들여다본 종목입니다."
 },
 {
  "id": "V103",
  "text": "내가 판 가격보다 훌쩍 오른 주가를"
 },
 {
  "id": "V104",
  "text": "보는 순간 속이 쓰립니다."
 },
 {
  "id": "V105",
  "text": "이천십육 년 프리드먼과 캐머러는"
 },
 {
  "id": "V106",
  "text": "뇌를 촬영하는 장치를 쓴 스물여덟 명에게"
 },
 {
  "id": "V107",
  "text": "모의 주식 거래를 하게 했습니다."
 },
 {
  "id": "V108",
  "text": "참가자들은 세 종목을"
 },
 {
  "id": "V109",
  "text": "사고팔 수 있었습니다."
 },
 {
  "id": "V110",
  "text": "그리고 한 번 오른 종목은"
 },
 {
  "id": "V111",
  "text": "다음에도 오를 가능성이 조금 더 크다는"
 },
 {
  "id": "V112",
  "text": "규칙을 미리 들었습니다."
 },
 {
  "id": "V113",
  "text": "즉 본인이 판 종목이 올랐다면"
 },
 {
  "id": "V114",
  "text": "다시 사는 편이 유리했습니다."
 },
 {
  "id": "V115",
  "text": "참가자들은 어떻게 했을까요?"
 },
 {
  "id": "V116",
  "text": "스물여덟 명 가운데 스물여섯 명이"
 },
 {
  "id": "V117",
  "text": "판 뒤에 오른 종목을"
 },
 {
  "id": "V118",
  "text": "다시 사는 데 머뭇거렸습니다."
 },
 {
  "id": "V119",
  "text": "한 번 오른 종목은 다음에도"
 },
 {
  "id": "V120",
  "text": "오를 가능성이 조금 더 크다는"
 },
 {
  "id": "V121",
  "text": "규칙을 알고 있었는데도요."
 },
 {
  "id": "V122",
  "text": "그리고 본인이 판 종목이"
 },
 {
  "id": "V123",
  "text": "오르는 화면을 보는 순간"
 },
 {
  "id": "V124",
  "text": "뇌에서는 후회로 볼 수 있는"
 },
 {
  "id": "V125",
  "text": "신호가 나타났습니다."
 },
 {
  "id": "V126",
  "text": "평소 보상을 처리할 때"
 },
 {
  "id": "V127",
  "text": "활발해지는 부위였습니다."
 },
 {
  "id": "V128",
  "text": "이 신호가 강하게 나타난 사람일수록"
 },
 {
  "id": "V129",
  "text": "다시 사기를 더 꺼렸습니다."
 },
 {
  "id": "V130",
  "text": "판 뒤에 오른 날이"
 },
 {
  "id": "V131",
  "text": "유독 오래 기억에 남는 것도"
 },
 {
  "id": "V132",
  "text": "이런 후회 때문일 수 있습니다."
 },
 {
  "id": "V133",
  "text": "그런데 같은 후회라도"
 },
 {
  "id": "V134",
  "text": "더 아픈 쪽이 있습니다."
 },
 {
  "id": "V135",
  "text": "두 사람이 있습니다."
 },
 {
  "id": "V136",
  "text": "당신은 에이 회사 주식을 갖고 있습니다."
 },
 {
  "id": "V137",
  "text": "지난 일 년 동안"
 },
 {
  "id": "V138",
  "text": "비 회사 주식으로 바꿀까 고민했지만"
 },
 {
  "id": "V139",
  "text": "그대로 뒀습니다."
 },
 {
  "id": "V140",
  "text": "나중에 보니 바꿨다면"
 },
 {
  "id": "V141",
  "text": "천이백 달러를 더 벌었을 겁니다."
 },
 {
  "id": "V142",
  "text": "상철은 비 회사 주식을 갖고 있다가"
 },
 {
  "id": "V143",
  "text": "에이 회사 주식으로 바꿨습니다."
 },
 {
  "id": "V144",
  "text": "알고 보니 그대로 뒀다면"
 },
 {
  "id": "V145",
  "text": "천이백 달러를 더 벌었을 겁니다."
 },
 {
  "id": "V146",
  "text": "당신과 상철이 놓친 돈은 같습니다."
 },
 {
  "id": "V147",
  "text": "누가 더 후회할까요?"
 },
 {
  "id": "V148",
  "text": "이 질문에 응답자의 구십이 퍼센트가"
 },
 {
  "id": "V149",
  "text": "상철이라고 답했습니다."
 },
 {
  "id": "V150",
  "text": "사람들은 가만히 있다가 놓친 것보다"
 },
 {
  "id": "V151",
  "text": "직접 움직였다가 놓친 것을"
 },
 {
  "id": "V152",
  "text": "더 후회할 일로 보는 거죠."
 },
 {
  "id": "V153",
  "text": "또 다른 실험 하나를 보겠습니다."
 },
 {
  "id": "V154",
  "text": "천구백구십사 년 길로비치와 메드벡은"
 },
 {
  "id": "V155",
  "text": "대학생 여든 명에게"
 },
 {
  "id": "V156",
  "text": "두 학생의 이야기를 들려줬습니다."
 },
 {
  "id": "V157",
  "text": "만약 다른 대학으로"
 },
 {
  "id": "V158",
  "text": "편입할지 고민하다가 그대로 남은 데이브와"
 },
 {
  "id": "V159",
  "text": "편입을 선택한 케빈이 있습니다."
 },
 {
  "id": "V160",
  "text": "이후에 두 사람 모두"
 },
 {
  "id": "V161",
  "text": "자신의 선택이 잘못됐다는 걸 알게 됩니다."
 },
 {
  "id": "V162",
  "text": "본인의 선택이 잘못되었다는"
 },
 {
  "id": "V163",
  "text": "사실을 안 직후에는"
 },
 {
  "id": "V164",
  "text": "편입을 선택한 케빈이"
 },
 {
  "id": "V165",
  "text": "더 후회할 거라고"
 },
 {
  "id": "V166",
  "text": "답한 람이 칠십육 퍼센트였습니다."
 },
 {
  "id": "V167",
  "text": "하지만 길게 보면"
 },
 {
  "id": "V168",
  "text": "그대로 남기로 선택한 데이브가"
 },
 {
  "id": "V169",
  "text": "더 후회할 거라고"
 },
 {
  "id": "V170",
  "text": "답한 사람이 육십사 퍼센트였습니다."
 },
 {
  "id": "V171",
  "text": "무언가를 해서 생긴 후회는"
 },
 {
  "id": "V172",
  "text": "당장 아프고"
 },
 {
  "id": "V173",
  "text": "하지 않아서 생긴 후회는"
 },
 {
  "id": "V174",
  "text": "오래 남는 경향이 있다는 거죠."
 },
 {
  "id": "V175",
  "text": "주식으로 치면"
 },
 {
  "id": "V176",
  "text": "팔고 나서 오른 건 당장 쓰리고"
 },
 {
  "id": "V177",
  "text": "사지 않고 지나친 건"
 },
 {
  "id": "V178",
  "text": "오래 마음에 남는 셈입니다."
 },
 {
  "id": "V179",
  "text": "그렇다면 살걸 팔걸 하는 후회에"
 },
 {
  "id": "V180",
  "text": "덜 흔들리려면"
 },
 {
  "id": "V181",
  "text": "무엇부터 해 보면 좋을까요?"
 },
 {
  "id": "V182",
  "text": "첫째."
 },
 {
  "id": "V183",
  "text": "사기 전에 왜 사는지를"
 },
 {
  "id": "V184",
  "text": "한 줄로 적어 두세요."
 },
 {
  "id": "V185",
  "text": "주가가 오르고 내린 걸 보고 나면"
 },
 {
  "id": "V186",
  "text": "우리는 그 결정을"
 },
 {
  "id": "V187",
  "text": "결과만으로 채점하기 쉽습니다."
 },
 {
  "id": "V188",
  "text": "오르면 잘한 결정 같고"
 },
 {
  "id": "V189",
  "text": "떨어지면 어리석은 결정 같습니다."
 },
 {
  "id": "V190",
  "text": "게다가 결과를 알고 나면"
 },
 {
  "id": "V191",
  "text": "처음부터 알 수 있었던 일처럼"
 },
 {
  "id": "V192",
  "text": "느껴지기 쉽습니다."
 },
 {
  "id": "V193",
  "text": "이것을 사후 확신 편향이라고 부릅니다."
 },
 {
  "id": "V194",
  "text": "그래서 결과를 알기 전에"
 },
 {
  "id": "V195",
  "text": "사는 이유를 미리 남겨 두는 겁니다."
 },
 {
  "id": "V196",
  "text": "이 회사의 이런 점을 보고 산다."
 },
 {
  "id": "V197",
  "text": "이런 일이 생기면"
 },
 {
  "id": "V198",
  "text": "내 판단이 틀렸다고 본다."
 },
 {
  "id": "V199",
  "text": "이유를 적다 보면"
 },
 {
  "id": "V200",
  "text": "단톡방에서 다들 산다는 것 말고는"
 },
 {
  "id": "V201",
  "text": "이유가 없다는 걸 알게 될 때도 있습니다."
 },
 {
  "id": "V202",
  "text": "그걸 알아차리는 것만으로도"
 },
 {
  "id": "V203",
  "text": "한 번 더 생각해 볼 틈이 생깁니다."
 },
 {
  "id": "V204",
  "text": "나중에 주가가 떨어지면"
 },
 {
  "id": "V205",
  "text": "이 메모를 다시 꺼내 보세요."
 },
 {
  "id": "V206",
  "text": "샀던 이유가 그대로인데 떨어졌다면"
 },
 {
  "id": "V207",
  "text": "내가 어쩔 수 없는"
 },
 {
  "id": "V208",
  "text": "운의 몫일 수 있습니다."
 },
 {
  "id": "V209",
  "text": "이유부터 흐릿했다면"
 },
 {
  "id": "V210",
  "text": "다음에 고칠 점이 생긴 거고요."
 },
 {
  "id": "V211",
  "text": "그런데 이유를 적어 두어도"
 },
 {
  "id": "V212",
  "text": "판 종목이 오르는 걸 보면"
 },
 {
  "id": "V213",
  "text": "마음은 또 흔들립니다."
 },
 {
  "id": "V214",
  "text": "둘째."
 },
 {
  "id": "V215",
  "text": "판 종목은 한동안"
 },
 {
  "id": "V216",
  "text": "자주 들여다보지 마세요."
 },
 {
  "id": "V217",
  "text": "앞의 실험에서 후회 신호가 나타난 건"
 },
 {
  "id": "V218",
  "text": "판 종목이 오른 걸 보는 순간이었습니다."
 },
 {
  "id": "V219",
  "text": "판 뒤에도 하루에 몇 번씩"
 },
 {
  "id": "V220",
  "text": "그 종목을 확인한다면"
 },
 {
  "id": "V221",
  "text": "그때마다 팔지 말걸 하고"
 },
 {
  "id": "V222",
  "text": "후회할 수도 있습니다."
 },
 {
  "id": "V223",
  "text": "그래서 판 종목은"
 },
 {
  "id": "V224",
  "text": "관심 목록에서 잠시 내려 두거나"
 },
 {
  "id": "V225",
  "text": "확인하는 때를 정해 두는 겁니다."
 },
 {
  "id": "V226",
  "text": "예를 들어 일주일에 한 번"
 },
 {
  "id": "V227",
  "text": "주말 아침에만 확인하는 식입니다."
 },
 {
  "id": "V228",
  "text": "일주일이 정답은 아닙니다."
 },
 {
  "id": "V229",
  "text": "후회를 곱씹는 횟수를 줄이기 위한"
 },
 {
  "id": "V230",
  "text": "예시입니다."
 },
 {
  "id": "V231",
  "text": "그리고 다시 볼 때는"
 },
 {
  "id": "V232",
  "text": "이렇게 물어보세요."
 },
 {
  "id": "V233",
  "text": "팔지 말걸 대신"
 },
 {
  "id": "V234",
  "text": "이 종목을 오늘 처음 봤다면"
 },
 {
  "id": "V235",
  "text": "나는 어떻게 판단할까?라고요."
 },
 {
  "id": "V236",
  "text": "실제로 후회 신호가 강했던 사람일수록"
 },
 {
  "id": "V237",
  "text": "더 나은 선택을 놓쳤죠."
 },
 {
  "id": "V238",
  "text": "후회와 지금의 판단을"
 },
 {
  "id": "V239",
  "text": "나눠 보는 것만으로도"
 },
 {
  "id": "V240",
  "text": "결정이 조금 덜 흔들릴 수 있습니다."
 },
 {
  "id": "V241",
  "text": "하지만 이미 지나간"
 },
 {
  "id": "V242",
  "text": "살걸 후회와 팔걸 후회는"
 },
 {
  "id": "V243",
  "text": "어떻게 하면 좋을까요?"
 },
 {
  "id": "V244",
  "text": "셋째."
 },
 {
  "id": "V245",
  "text": "오답노트를 작성하세요."
 },
 {
  "id": "V246",
  "text": "그때 알던 정보로는"
 },
 {
  "id": "V247",
  "text": "그렇게 판단할 수 있었어."
 },
 {
  "id": "V248",
  "text": "그때 내가 너무 좋은 쪽으로만"
 },
 {
  "id": "V249",
  "text": "생각했었던 것 같아."
 },
 {
  "id": "V250",
  "text": "다음에는 사기 전에"
 },
 {
  "id": "V251",
  "text": "이유부터 적어 보자."
 },
 {
  "id": "V252",
  "text": "이렇게 후회를"
 },
 {
  "id": "V253",
  "text": "다음에 쓸 기준 하나로 바꾸는 겁니다."
 },
 {
  "id": "V254",
  "text": "여러분에게도 가장 아쉬웠던"
 },
 {
  "id": "V255",
  "text": "살걸 후회한 순간이나"
 },
 {
  "id": "V256",
  "text": "팔걸 후회한 순간이 있나요?"
 },
 {
  "id": "V257",
  "text": "댓글로 공유해 주세요."
 }
]